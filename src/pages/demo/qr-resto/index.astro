  sidebarButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = (btn as HTMLElement).dataset.tab;
      if (!tab) return;

      if (tab === 'public-qr') {
        window.open(`/layanan/qr-resto/${currentSlug}`, '_blank');
        return;
      }

      sidebarButtons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      activeTab = tab;
      document.getElementById('tabContentKds')?.classList.toggle('is-hidden', tab !== 'kds');
      document.getElementById('tabContentTables')?.classList.toggle('is-hidden', tab !== 'tables');
      document.getElementById('tabContentWaiter')?.classList.toggle('is-hidden', tab !== 'waiter');
      document.getElementById('tabContentMenu')?.classList.toggle('is-hidden', tab !== 'menu');
      document.getElementById('tabContentAnalytics')?.classList.toggle('is-hidden', tab !== 'analytics');
    });
  });

  // KDS Station Filter
  const stationButtons = document.querySelectorAll('.kds-station-btn');
  stationButtons.forEach((sBtn) => {
    sBtn.addEventListener('click', () => {
      stationButtons.forEach((b) => b.classList.remove('is-active'));
      sBtn.classList.add('is-active');
      currentStationFilter = (sBtn as HTMLElement).dataset.station || 'all';
      renderKdsTickets();
    });
  });

  // RENDER: KDS TICKETS
  function renderKdsTickets() {
    const grid = document.getElementById('kdsTicketsGrid');
    if (!grid) return;

    let filtered = kdsOrders;
    if (currentStationFilter !== 'all') {
      filtered = kdsOrders.filter((o) => o.station === currentStationFilter);
    }

    // update count badges
    const cAll = document.getElementById('kdsCountAll');
    if (cAll) cAll.textContent = `${kdsOrders.length} Tiket`;

    if (filtered.length === 0) {
      grid.innerHTML = `
        <div style="grid-column: 1 / -1; padding: 60px 20px; text-align: center; background: #ffffff; border: 1px dashed #cbd5e1; border-radius: 14px;">
          <div style="font-size: 36px; margin-bottom: 8px;">👨‍🍳</div>
          <h3 style="font-size: 16px; font-weight: 800; color: #0f172a; margin: 0 0 4px;">Tidak Ada Pesanan di Stasiun Ini</h3>
          <p style="font-size: 13px; color: #64748b; margin: 0;">Semua pesanan stasiun ini telah selesai disajikan ke meja tamu.</p>
        </div>
      `;
      return;
    }

    grid.innerHTML = filtered.map((t) => {
      const isPriority = t.status === 'cooking' && t.timerSec > 300;
      const isReady = t.status === 'ready';

      let timerClass = 'badge-green';
      if (t.timerSec > 300 && t.timerSec <= 600) timerClass = 'badge-orange';
      if (t.timerSec > 600) timerClass = 'badge-red';

      let headerClass = '';
      if (isPriority) headerClass = 'header-orange';
      if (isReady) headerClass = 'header-green';

      let footerBtn = '';
      if (t.status === 'pending') {
        footerBtn = `<button type="button" class="btn-kds-action btn-start" data-action="start" data-id="${t.id}">🔥 Mulai Masak</button>`;
      } else if (t.status === 'cooking') {
        footerBtn = `<button type="button" class="btn-kds-action btn-ready" data-action="ready" data-id="${t.id}">✓ Siap Saji (Ready)</button>`;
      } else {
        footerBtn = `<button type="button" class="btn-kds-action btn-served" data-action="served" data-id="${t.id}">🛎️ Selesai Diantar ke Meja</button>`;
      }

      return `
        <div class="kds-ticket-card ${isPriority ? 'is-priority' : ''} ${isReady ? 'is-ready' : ''}" data-id="${t.id}">
          <div class="kds-ticket-header ${headerClass}">
            <div class="kds-ticket-table">
              <span>MEJA ${t.table}</span>
              <span style="font-size: 11px; font-weight: 600; color: #64748b;">(${t.area})</span>
            </div>
            <div class="kds-timer-badge ${timerClass}">
              ⏱️ ${t.timeElapsed}
            </div>
          </div>
          <div style="padding: 6px 16px; background: #f1f5f9; font-size: 11px; font-weight: 700; color: #475569; display: flex; justify-content: space-between;">
            <span>#${t.code}</span>
            <span style="text-transform: uppercase;">STASIUN: ${t.station.toUpperCase()}</span>
          </div>
          <div class="kds-ticket-items">
            ${t.items.map((it) => `
              <div class="kds-item-row">
                <div class="kds-item-main">
                  <span>${it.name}</span>
                </div>
                ${it.mod ? `<div class="kds-item-mod">↳ ${it.mod}</div>` : ''}
              </div>
            `).join('')}
          </div>
          <div class="kds-ticket-footer">
            ${footerBtn}
          </div>
        </div>
      `;
    }).join('');

    // Attach Action Handlers
    grid.querySelectorAll('.btn-kds-action').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        const act = (btn as HTMLElement).dataset.action;
        const order = kdsOrders.find((o) => o.id === id);
        if (!order) return;

        if (act === 'start') {
          order.status = 'cooking';
          showToast('info', `🔥 Pesanan #${order.code} Meja ${order.table} mulai dimasak chef!`);
        } else if (act === 'ready') {
          order.status = 'ready';
          showToast('success', `✓ Pesanan #${order.code} Meja ${order.table} SIAP SAJI! Waiter dipanggil.`);
        } else if (act === 'served') {
          const idx = kdsOrders.findIndex((o) => o.id === id);
          if (idx !== -1) {
            kdsOrders.splice(idx, 1);
            showToast('success', `Pesanan #${order.code} telah selesai dihidangkan ke Meja ${order.table}.`);
          }
        }
        renderKdsTickets();
      });
    });
  }

  // RENDER: TABLES FLOORPLAN
  function renderTablesFloor() {
    const grid = document.getElementById('tablesFloorGrid');
    if (!grid) return;

    grid.innerHTML = tablesList.map((t) => {
      let cardClass = 'is-empty';
      let pillClass = 'pill-green';
      let statusText = 'Meja Kosong';

      if (t.status === 'occupied') {
        cardClass = 'is-occupied';
        pillClass = 'pill-blue';
        statusText = 'Sedang Makan';
      } else if (t.status === 'calling_waiter') {
        cardClass = 'is-call';
        pillClass = 'pill-red';
        statusText = '🛎️ Panggil Waiter';
      } else if (t.status === 'bill_requested') {
        cardClass = 'is-bill';
        pillClass = 'pill-yellow';
        statusText = '💳 Minta Tagihan';
      }

      return `
        <div class="table-card ${cardClass}" data-id="${t.id}" data-num="${t.number}">
          <div class="table-card-top">
            <span class="table-card-num">Meja ${t.number}</span>
            <span class="table-status-pill ${pillClass}">${statusText}</span>
          </div>
          <div class="table-card-body">
            <div style="display: flex; justify-content: space-between;">
              <span>Area:</span>
              <strong style="text-transform: capitalize; font-size: 12px;">${t.area}</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span>Kapasitas:</span>
              <span>${t.cap} Pax</span>
            </div>
            ${t.status !== 'empty' ? `
              <div style="display: flex; justify-content: space-between; margin-top: 4px; padding-top: 4px; border-top: 1px dashed #e2e8f0;">
                <span>Total Bill:</span>
                <strong style="color: #2563eb;">Rp ${t.bill.toLocaleString('id-ID')}</strong>
              </div>
            ` : ''}
          </div>
          <div class="table-card-actions">
            <button type="button" class="btn-table-mini btn-open-qr" data-num="${t.number}" data-area="${t.area}">
              🖨️ Stand QR
            </button>
            <a href="/layanan/qr-resto/${currentSlug}?table=${t.number}" target="_blank" rel="noopener" class="btn-table-mini">
              📱 Buka Tamu
            </a>
          </div>
        </div>
      `;
    }).join('');

    // Attach Open QR Modal
    grid.querySelectorAll('.btn-open-qr').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const num = (btn as HTMLElement).dataset.num;
        const area = (btn as HTMLElement).dataset.area;
        openQrModal(num || '01', area || 'Indoor');
      });
    });
  }

  // QR Modal Functions
  const modalQrStand = document.getElementById('modalQrStand');
  const btnCloseQrModal = document.getElementById('btnCloseQrModal');
  const modalQrTableNum = document.getElementById('modalQrTableNum');
  const modalQrRestoName = document.getElementById('modalQrRestoName');
  const modalQrSlugUrl = document.getElementById('modalQrSlugUrl');
  const btnTestQrGuest = document.getElementById('btnTestQrGuest') as HTMLAnchorElement;
  const btnPrintQrSingle = document.getElementById('btnPrintQrSingle');

  function openQrModal(tableNum: string, area: string) {
    if (modalQrTableNum) modalQrTableNum.textContent = `MEJA ${tableNum} (${area.toUpperCase()})`;
    if (modalQrRestoName && headerBizName) modalQrRestoName.textContent = headerBizName.textContent;
    const url = `/layanan/qr-resto/${currentSlug}?table=${tableNum}`;
    if (modalQrSlugUrl) modalQrSlugUrl.textContent = url;
    if (btnTestQrGuest) btnTestQrGuest.href = url;
    modalQrStand?.classList.remove('is-hidden');
  }

  btnCloseQrModal?.addEventListener('click', () => {
    modalQrStand?.classList.add('is-hidden');
  });

  btnPrintQrSingle?.addEventListener('click', () => {
    showToast('success', 'Perintah cetak stiker stand QR meja dikirim ke printer!');
  });

  // Modal: Tambah Meja
  const modalNewTable = document.getElementById('modalNewTable');
  const btnCloseNewTableModal = document.getElementById('btnCloseNewTableModal');
  const btnCancelNewTable = document.getElementById('btnCancelNewTable');
  const btnHeaderNewTable = document.getElementById('btnHeaderNewTable');
  const btnQuickAddTable = document.getElementById('btnQuickAddTable');
  const formNewTable = document.getElementById('formNewTable') as HTMLFormElement;

  const openNewTableModal = () => modalNewTable?.classList.remove('is-hidden');
  const closeNewTableModal = () => modalNewTable?.classList.add('is-hidden');

  btnHeaderNewTable?.addEventListener('click', openNewTableModal);
  btnQuickAddTable?.addEventListener('click', openNewTableModal);
  btnCloseNewTableModal?.addEventListener('click', closeNewTableModal);
  btnCancelNewTable?.addEventListener('click', closeNewTableModal);

  formNewTable?.addEventListener('submit', (e) => {
    e.preventDefault();
    const num = (document.getElementById('newTableNum') as HTMLInputElement).value;
    const area = (document.getElementById('newTableArea') as HTMLSelectElement).value;
    const cap = parseInt((document.getElementById('newTableCap') as HTMLInputElement).value, 10);

    tablesList.push({
      id: `t-${Date.now()}`,
      number: num,
      area,
      cap,
      status: 'empty',
      bill: 0,
      duration: '-'
    });

    closeNewTableModal();
    renderTablesFloor();
    showToast('success', `Meja ${num} (${area}) berhasil ditambahkan dan QR code diterbitkan!`);
  });

  // RENDER: WAITER CALLS TABLE
  function renderWaiterCalls() {
    const tbody = document.getElementById('waiterCallsTableBody');
    if (!tbody) return;

    tbody.innerHTML = waiterCalls.map((c) => {
      const isPending = c.status === 'pending';
      return `
        <tr>
          <td><span style="font-family: ui-monospace, monospace; font-size: 12px; font-weight: 700; color: #64748b;">${c.time}</span></td>
          <td><strong style="color: #0f172a; font-size: 14px;">Meja ${c.table}</strong></td>
          <td><span style="font-size: 12.5px; color: #475569;">${c.area}</span></td>
          <td>
            <span style="display: inline-block; padding: 3px 8px; border-radius: 6px; font-size: 11.5px; font-weight: 800; background: ${c.type.includes('Tagihan') ? '#fef3c7' : '#fee2e2'}; color: ${c.type.includes('Tagihan') ? '#b45309' : '#b91c1c'};">
              ${c.type}
            </span>
          </td>
          <td><span style="font-size: 12.5px; color: #334155;">${c.note}</span></td>
          <td>
            <span style="display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 700; color: ${isPending ? '#dc2626' : '#15803d'};">
              <span>●</span> ${isPending ? 'Menunggu Pelayan' : 'Telah Terlayani'}
            </span>
          </td>
          <td>
            ${isPending ? `
              <button type="button" class="btn-table-mini btn-resolve-call" data-id="${c.id}" style="background: #10b981; color: #ffffff; border: none;">
                ✓ Tandai Terlayani
              </button>
            ` : `
              <span style="font-size: 12px; color: #94a3b8;">Selesai</span>
            `}
          </td>
        </tr>
      `;
    }).join('');

    tbody.querySelectorAll('.btn-resolve-call').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        const call = waiterCalls.find((w) => w.id === id);
        if (call) {
          call.status = 'resolved';
          // also update table card status if calling
          const t = tablesList.find((tab) => tab.number === call.table);
          if (t && t.status === 'calling_waiter') t.status = 'occupied';
          renderWaiterCalls();
          renderTablesFloor();
          showToast('success', `Panggilan Meja ${call.table} telah selesai direspon!`);
        }
      });
    });
  }

  // Simulate Guest Call
  document.getElementById('btnSimulateGuestCall')?.addEventListener('click', () => {
    const newCall = {
      id: `wc-${Date.now()}`,
      time: new Date().toLocaleTimeString('id-ID'),
      table: '08',
      area: 'VIP Room',
      type: 'Panggil Pelayan',
      note: 'Minta tambahan saus blackpepper & sendok garpu',
      status: 'pending'
    };
    waiterCalls.unshift(newCall);

    const t = tablesList.find((tab) => tab.number === '08');
    if (t) t.status = 'calling_waiter';

    renderWaiterCalls();
    renderTablesFloor();
    showToast('info', '🛎️ Panggilan baru dari Meja 08 (VIP)!');
  });

  // RENDER: MENU CATALOG
  function renderMenuCatalog() {
    const tbody = document.getElementById('menuCatalogTableBody');
    if (!tbody) return;

    tbody.innerHTML = menuCatalog.map((m) => `
      <tr>
        <td>
          <div style="font-weight: 800; color: #0f172a; font-size: 13.5px;">${m.name}</div>
        </td>
        <td><span style="text-transform: capitalize; font-size: 12.5px; color: #475569;">${m.category}</span></td>
        <td><span style="font-size: 12px; font-weight: 700; color: #ea580c; background: #fff7ed; padding: 2px 8px; border-radius: 6px;">${m.station}</span></td>
        <td><strong style="color: #2563eb; font-size: 13.5px;">Rp ${m.price.toLocaleString('id-ID')}</strong></td>
        <td><span style="font-size: 12px; color: #64748b;">${m.mods}</span></td>
        <td>
          <button type="button" class="btn-toggle-stock" data-id="${m.id}" style="padding: 4px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 700; cursor: pointer; border: none; background: ${m.available ? '#ecfdf5' : '#fee2e2'}; color: ${m.available ? '#059669' : '#dc2626'};">
            ${m.available ? '● Tersedia (In Stock)' : '✕ Habis (Sold Out)'}
          </button>
        </td>
        <td>
          <button type="button" class="btn-table-mini" onclick="alert('Fitur edit menu tersinkron dengan database!')">Edit</button>
        </td>
      </tr>
    `).join('');

    tbody.querySelectorAll('.btn-toggle-stock').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id;
        const item = menuCatalog.find((it) => it.id === id);
        if (item) {
          item.available = !item.available;
          renderMenuCatalog();
          showToast(item.available ? 'success' : 'error', `Status "${item.name}" diubah menjadi: ${item.available ? 'Tersedia' : 'Habis (Sold Out)'}`);
        }
      });
    });
  }

  // RENDER: TOP SELLING
  function renderTopSelling() {
    const tbody = document.getElementById('topSellingDishesBody');
    if (!tbody) return;

    tbody.innerHTML = topSelling.map((d) => `
      <tr>
        <td><strong style="color: #ea580c; font-size: 14px;">#${d.rank}</strong></td>
        <td><strong style="color: #0f172a; font-size: 13.5px;">${d.name}</strong></td>
        <td><span style="font-size: 12.5px; color: #475569;">${d.cat}</span></td>
        <td><strong style="font-size: 13px; color: #0f172a;">${d.sold} Porsi</strong></td>
        <td><strong style="color: #2563eb; font-size: 13.5px;">Rp ${d.rev.toLocaleString('id-ID')}</strong></td>
        <td><span style="font-size: 12px; color: #10b981; font-weight: 700;">⏱️ ${d.avgCook}</span></td>
      </tr>
    `).join('');
  }

  // Share link
  btnHeaderShareLink?.addEventListener('click', () => {
    const link = `${window.location.origin}/layanan/qr-resto/${currentSlug}`;
    navigator.clipboard.writeText(link).then(() => {
      showToast('success', `Tautan self-order (${link}) berhasil disalin ke clipboard!`);
    });
  });

  // Download CSV
  document.getElementById('btnExportRestoCsv')?.addEventListener('click', () => {
    let csv = 'Nomor Meja,Area,Kapasitas,Status,Total Bill\n';
    tablesList.forEach((t) => {
      csv += `"${t.number}","${t.area}","${t.cap}","${t.status}","${t.bill}"\n`;
    });
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Laporan_Turnover_Meja_${currentSlug}_${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
    showToast('success', 'File CSV turn-over meja berhasil diunduh.');
  });

  document.getElementById('btnDownloadAllQr')?.addEventListener('click', () => {
    showToast('success', 'File PDF stiker cetak QR Stand 20 Meja Resto berhasil di-generate!');
  });
</script>
