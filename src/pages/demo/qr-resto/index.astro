---
import '../../../styles/global.css';
import '../../../styles/animations.css';
import '../../../styles/app-software.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Supernova QR Resto & Kitchen Display System (KDS) — Zero-Wait Dine-In Ordering & Kitchen Ticket Automation" />
    <meta name="theme-color" content="#0f172a" />
    <title>Supernova QR Resto &amp; Kitchen KDS OS — Smart Table Ordering &amp; Kitchen Terminal</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23ea580c'/%3E%3Cpath d='M16 20h32v6H16zm0 10h20v6H16zm0 10h28v6H16z' fill='white'/%3E%3C/svg%3E" />
  </head>
  <body class="app-mode">
    <div id="toastContainer" class="toast-container"></div>

    <!-- ====================================================================== -->
    <!-- 1. SPLIT-SCREEN AUTHENTICATION (LOGIN & REGISTRATION)                  -->
    <!-- ====================================================================== -->
    <div id="authScreen" class="auth-split-screen">
      <!-- Left Panel: SVG Tech Character & Kitchen KDS Architecture Visual -->
      <div class="auth-panel-visual">
        <div class="auth-visual-top">
          <a href="/" class="app-brand-logo">
            <div class="app-brand-icon" style="background: linear-gradient(135deg, #ea580c, #f97316);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.3">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </div>
            <div class="app-brand-text">
              <span class="brand-name">Supernova QR Resto &amp; KDS</span>
              <span class="brand-tag">KITCHEN DISPLAY CORE v3.0</span>
            </div>
          </a>
        </div>

        <div class="auth-visual-center">
          <div class="auth-hero-svg-wrap">
            <img
              src="/illustrations/qr-resto-tech-character.svg"
              alt="Supernova QR Resto & Kitchen KDS Technology Illustration"
              width="600"
              height="500"
              loading="eager"
            />
          </div>
          <h2 class="auth-visual-title">Automasi Meja Tamu &amp; Layar Dapur Terpadu</h2>
          <p class="auth-visual-subtitle">
            Tamu memesan langsung dari meja via QR Code interaktif tanpa perlu download aplikasi. Pesanan sinkron seketika ke monitor KDS chef di dapur.
          </p>
        </div>

        <div class="auth-visual-footer">
          <span>© 2026 Supernova Labs Studio · Dedicated Cloud SaaS</span>
          <div class="tech-badges-row">
            <span class="tech-badge-pill">● Rust Axum 0.8 Realtime WebSocket</span>
            <span class="tech-badge-pill">● Neon Cloud PostgreSQL</span>
          </div>
        </div>
      </div>

      <!-- Right Panel: Professional Login & Registration Form -->
      <div class="auth-panel-form">
        <div class="auth-form-top-nav">
          <a href="/" class="back-website-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            <span>Kembali ke Website Utama</span>
          </a>
        </div>

        <div id="authAlertBox" class="auth-alert is-hidden" style="margin: 0 0 16px;"></div>

        <!-- LOGIN FORM CONTAINER -->
        <div id="loginBox">
          <div class="auth-form-header">
            <h1 class="auth-form-title">Masuk ke Manajemen Resto &amp; KDS</h1>
            <p class="auth-form-desc">Masukkan email atau akun pengelola restoran Anda untuk membuka monitor dapur dan denah meja.</p>
          </div>

          <form id="formLogin" class="saas-form">
            <div class="saas-form-group">
              <label for="loginEmail">Email / Username Resto: <span class="req">*</span></label>
              <div class="saas-input-wrap">
                <input type="text" id="loginEmail" class="saas-input" required placeholder="manager@nusantarabistro.id atau username..." autocomplete="username" />
              </div>
            </div>

            <div class="saas-form-group">
              <label for="loginPassword">Password: <span class="req">*</span></label>
              <div class="saas-input-wrap">
                <input type="password" id="loginPassword" class="saas-input" required placeholder="••••••••••••" autocomplete="current-password" />
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: #475569;">
              <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                <input type="checkbox" id="rememberMe" checked />
                <span>Ingat sesi akun resto</span>
              </label>
              <a href="#" id="btnForgotPwd" style="color: #ea580c; text-decoration: none; font-weight: 600;">Lupa Password?</a>
            </div>

            <button type="submit" class="btn-app-primary" id="btnSubmitLogin" style="background: linear-gradient(135deg, #ea580c, #f97316);">
              <span>Masuk ke Layar KDS &amp; Meja</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>

            <button type="button" class="btn-instant-pill" id="btnQuickDemo">
              ⚡ Masuk Instan (Demo Nusantara Grill &amp; Bistro)
            </button>
          </form>

          <div class="auth-bottom-switch">
            Belum punya akun? <a href="#" id="linkToRegister" class="text-blue font-bold">Daftar Disini</a>
          </div>
        </div>

        <!-- REGISTER FORM CONTAINER (TOGGLEABLE) -->
        <div id="registerBox" class="is-hidden">
          <div class="auth-form-header">
            <h1 class="auth-form-title">Daftar Akun Resto &amp; KDS Baru</h1>
            <p class="auth-form-desc">Inisialisasi sistem pemesanan QR meja, monitor dapur KDS, dan tombol panggil pelayan untuk resto Anda.</p>
          </div>

          <form id="formRegister" class="saas-form">
            <div class="form-row-2col">
              <div class="saas-form-group">
                <label for="regFullName">Nama Pemilik / GM: <span class="req">*</span></label>
                <input type="text" id="regFullName" class="saas-input" required placeholder="cth: Chef Aris Kurniawan" />
              </div>
              <div class="saas-form-group">
                <label for="regBizName">Nama Restoran / Kafe: <span class="req">*</span></label>
                <input type="text" id="regBizName" class="saas-input" required placeholder="cth: Nusantara Grill &amp; Bistro" />
              </div>
            </div>

            <div class="form-row-2col">
              <div class="saas-form-group">
                <label for="regCategory">Konsep Resto: <span class="req">*</span></label>
                <select id="regCategory" class="saas-select">
                  <option value="bistro" selected>Casual Dining &amp; Family Bistro</option>
                  <option value="cafe">Coffee Roastery &amp; Pastry Bar</option>
                  <option value="grill">Steakhouse &amp; Korean BBQ Grill</option>
                  <option value="fastcasual">Fast Casual &amp; Noodle Station</option>
                  <option value="vip">Bar, Lounge &amp; VIP Club</option>
                  <option value="foodcourt">Food Court &amp; Multi-Tenant</option>
                </select>
              </div>
              <div class="saas-form-group">
                <label for="regCity">Kota / Lokasi: <span class="req">*</span></label>
                <input type="text" id="regCity" class="saas-input" required placeholder="cth: Senopati, Jakarta Selatan" />
              </div>
            </div>

            <div class="saas-form-group">
              <label for="regWhatsApp">Nomor WhatsApp Operasional: <span class="req">*</span></label>
              <input type="tel" id="regWhatsApp" class="saas-input" required placeholder="cth: 081234567890" />
            </div>

            <div class="form-row-2col">
              <div class="saas-form-group">
                <label for="regEmail">Email Resmi Restoran: <span class="req">*</span></label>
                <input type="email" id="regEmail" class="saas-input" required placeholder="manager@nusantaragrill.com" autocomplete="email" />
              </div>
              <div class="saas-form-group">
                <label for="regPassword">Password: <span class="req">*</span></label>
                <input type="password" id="regPassword" class="saas-input" required minlength="6" placeholder="Minimal 6 karakter" autocomplete="new-password" />
              </div>
            </div>

            <button type="submit" class="btn-app-primary" id="btnSubmitRegister" style="background: linear-gradient(135deg, #ea580c, #f97316);">
              <span>Daftarkan Resto &amp; Buka Monitor KDS</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
          </form>

          <div class="auth-bottom-switch">
            Sudah punya akun? <a href="#" id="linkToLogin" class="text-blue font-bold">Masuk Disini</a>
          </div>
        </div>
      </div>
    </div>

    <!-- ====================================================================== -->
    <!-- 2. FULL SAAS APPLICATION WORKSPACE (SIDEBAR & ANTI-MAINSTREAM CARDS)  -->
    <!-- ====================================================================== -->
    <div id="appDashboard" class="app-workspace is-hidden">
      <!-- 1. LEFT VERTICAL SIDEBAR DOCK (MATCHING IMAGE 2) -->
      <aside class="app-sidebar">
        <div class="sidebar-top">
          <div class="sidebar-brand-mark" title="Supernova QR Resto & KDS Core OS" style="background: linear-gradient(135deg, #ea580c, #f97316);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.3">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
        </div>

        <!-- Vertical Icon Nav with Floating Tooltips -->
        <nav class="sidebar-nav">
          <button type="button" class="sidebar-nav-item is-active" data-tab="kds" title="Layar Monitor Dapur KDS">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
            <span class="nav-tooltip">Layar KDS</span>
          </button>

          <button type="button" class="sidebar-nav-item" data-tab="tables" title="Denah Meja & Stiker QR">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span class="nav-tooltip">Denah Meja</span>
          </button>

          <button type="button" class="sidebar-nav-item" data-tab="waiter" title="Panggilan Pelayan & Minta Bill">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <span class="nav-tooltip">Panggilan Waiter</span>
          </button>

          <button type="button" class="sidebar-nav-item" data-tab="menu" title="Katalog Menu & Modifiers">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
            <span class="nav-tooltip">Menu &amp; Modifiers</span>
          </button>

          <button type="button" class="sidebar-nav-item" data-tab="analytics" title="Turn-over Meja & Laporan KDS">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
            <span class="nav-tooltip">Analitik &amp; PnL</span>
          </button>

          <button type="button" class="sidebar-nav-item" data-tab="public-qr" title="Portal Pemesanan Tamu (Bebas Login)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span class="nav-tooltip">Portal Tamu QR</span>
          </button>
        </nav>

        <!-- Sidebar Bottom: Avatar / Quick Logout -->
        <div class="sidebar-bottom">
          <button type="button" class="sidebar-avatar-btn" id="btnSidebarAvatar" title="Profil Resto & Keluar">
            <span class="avatar-circle" style="background: #ea580c;">NB</span>
          </button>
        </div>
      </aside>

      <!-- 2. MAIN BODY AREA (LIGHT & PROFESSIONAL) -->
      <div class="app-main-body">
        <!-- Integrated Light Top Shelf Header (Matching Image 2) -->
        <header class="app-top-shelf">
          <div class="shelf-left">
            <div class="shelf-welcome">
              <h1 class="welcome-title">
                <span>Selamat Datang, </span><span id="headerBizName">Nusantara Grill &amp; Bistro</span>
              </h1>
              <div class="welcome-meta">
                <span id="currentDateLabel">Rabu, 21 Oktober 2026</span>
                <span class="meta-dot">·</span>
                <span class="meta-code-pill" title="Kode Identitas Lisensi Restoran">RESTO: <strong id="headerTenantCode">#SNV-9241-KDS</strong></span>
                <span class="meta-dot">·</span>
                <span class="meta-city" id="headerBizCity">Senopati, Jakarta Selatan</span>
              </div>
            </div>
          </div>

          <div class="shelf-right">
            <!-- Direct Customer QR Ordering Pill -->
            <a href="/layanan/qr-resto/nusantara-bistro" target="_blank" rel="noopener" class="top-slug-link" id="headerPublicLinkPill" title="Buka Halaman Self-Order Tamu (Bebas Login)">
              <span>🌐 /layanan/qr-resto/</span><strong id="headerSlugText">nusantara-bistro</strong>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>

            <button type="button" class="btn-shelf-action" id="btnHeaderShareLink" title="Salin tautan self-order QR untuk stiker meja atau medsos">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Salin Link</span>
            </button>

            <button type="button" class="btn-shelf-primary" id="btnHeaderNewTable" style="background: #ea580c;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              <span>+ Meja Baru</span>
            </button>

            <button type="button" class="btn-shelf-ghost" id="btnHeaderLogout" title="Keluar dari akun bisnis">
              Keluar
            </button>

            <a href="/" class="btn-shelf-ghost" style="text-decoration: none;" title="Kembali ke landing page">
              ← Web Utama
            </a>
          </div>
        </header>

        <!-- Main Content Canvas -->
        <main class="app-canvas-container">
          <!-- Category Filter Pills (Like Image 2) -->
          <div class="shelf-category-pills">
            <button type="button" class="cat-pill is-active" data-cat="all">Semua Menu &amp; Stasiun</button>
            <button type="button" class="cat-pill" data-cat="main">🥩 Main Course &amp; Grill</button>
            <button type="button" class="cat-pill" data-cat="snack">🍟 Appetizer &amp; Snacks</button>
            <button type="button" class="cat-pill" data-cat="beverage">🍹 Beverage &amp; Mocktail</button>
            <button type="button" class="cat-pill" data-cat="dessert">🍰 Desserts &amp; Pastry</button>
          </div>

          <!-- 4 ANTI-MAINSTREAM STAT CARDS (EXACT COMPOSITION AS IMAGE 2) -->
          <section class="anti-cards-grid">
            <!-- CARD 1: HERO VIBRANT BLUE/ORANGE CARD (Sales Today Style) -->
            <div class="anti-card anti-card--hero" style="background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%);">
              <div class="anti-card-top">
                <span class="anti-card-title">Total Billing Meja Hari Ini</span>
                <div class="anti-hero-badge">
                  <span>↑ +18.4%</span>
                </div>
              </div>
              <div class="anti-card-value" id="mTotalRevenue">Rp 4.280.000</div>
              <div class="anti-card-sub">Omset 34 sesi santap dine-in terkonfirmasi</div>
              <div class="anti-card-watermark">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                  <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
              </div>
            </div>

            <!-- CARD 2: WHITE MINIMALIST OCCUPANCY CARD -->
            <div class="anti-card">
              <div class="anti-card-top">
                <span class="anti-card-title">Meja Aktif (Occupancy)</span>
                <span class="anti-status-pill anti-status-pill--mint" id="mOccupancyRate">70% Terisi</span>
              </div>
              <div class="anti-card-value" id="mActiveTables">14 Meja Aktif</div>
              <div class="anti-card-sub">Dari total 20 kapasitas meja makan resto</div>
            </div>

            <!-- CARD 3: WHITE MINIMALIST KDS SPEED CARD -->
            <div class="anti-card">
              <div class="anti-card-top">
                <span class="anti-card-title">Rata-Rata Waktu Masak KDS</span>
                <span class="anti-status-pill anti-status-pill--blue">Target &lt; 15m</span>
              </div>
              <div class="anti-card-value" id="mAvgCookTime">11.2 Menit</div>
              <div class="anti-card-sub">Waktu order dikirim sampai siap saji chef</div>
            </div>

            <!-- CARD 4: WHITE MINIMALIST WAITER BELL ALERT -->
            <div class="anti-card">
              <div class="anti-card-top">
                <span class="anti-card-title">Panggilan Waiter Belum Selesai</span>
                <span class="anti-status-pill anti-status-pill--rose" id="mCallsCount">1 Meja Respon</span>
              </div>
              <div class="anti-card-value" id="mPendingCalls">Meja 04</div>
              <div class="anti-card-sub">Tamu menekan tombol panggil pelayan</div>
            </div>
          </section>

          <!-- TAB CONTENT PANELS -->

          <!-- ================================================================ -->
          <!-- TAB 1: KITCHEN DISPLAY SYSTEM (KDS LIVE MONITOR)                 -->
          <!-- ================================================================ -->
          <div id="tabContentKds" class="tab-pane-view">
            <div class="kds-station-tabs">
              <button type="button" class="kds-station-btn is-active" data-station="all">
                <span>🔥 Semua Stasiun Dapur</span>
                <span class="station-count" id="kdsCountAll">4 Tiket</span>
              </button>
              <button type="button" class="kds-station-btn" data-station="hot">
                <span>🥩 Dapur Panas &amp; Grill</span>
                <span class="station-count" id="kdsCountHot">2</span>
              </button>
              <button type="button" class="kds-station-btn" data-station="bar">
                <span>🍹 Bar Minuman</span>
                <span class="station-count" id="kdsCountBar">1</span>
              </button>
              <button type="button" class="kds-station-btn" data-station="dessert">
                <span>🍰 Pastry &amp; Dessert</span>
                <span class="station-count" id="kdsCountDessert">1</span>
              </button>
            </div>

            <!-- KDS Ticket Grid -->
            <div class="kds-tickets-grid" id="kdsTicketsGrid">
              <!-- Dynamically rendered -->
            </div>
          </div>

          <!-- ================================================================ -->
          <!-- TAB 2: DENAH MEJA RESTO & CETAK QR CODE                          -->
          <!-- ================================================================ -->
          <div id="tabContentTables" class="tab-pane-view is-hidden">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
              <div>
                <h2 style="font-size: 17px; font-weight: 800; color: #0f172a; margin: 0 0 4px;">Denah Meja Restoran &amp; QR Stand Realtime</h2>
                <p style="font-size: 13px; color: #64748b; margin: 0;">Kelola kapasitas meja, pantau status billing tamu, dan cetak stiker QR code per meja.</p>
              </div>
              <div style="display: flex; gap: 8px;">
                <button type="button" class="btn-app-secondary" id="btnDownloadAllQr" style="padding: 8px 14px; font-size: 13px;">
                  🖨️ Unduh Stiker QR Semua Meja (PDF)
                </button>
                <button type="button" class="btn-app-primary" id="btnQuickAddTable" style="padding: 8px 14px; font-size: 13px; background: #ea580c;">
                  + Tambah Meja
                </button>
              </div>
            </div>

            <!-- Floor Filter (Area) -->
            <div style="display: flex; gap: 8px; margin-bottom: 16px;">
              <button type="button" class="cat-pill is-active" data-area="all">Semua Area (20)</button>
              <button type="button" class="cat-pill" data-area="indoor">Indoor AC Utama (10)</button>
              <button type="button" class="cat-pill" data-area="outdoor">Outdoor Terrace (6)</button>
              <button type="button" class="cat-pill" data-area="vip">Private VIP Rooms (4)</button>
            </div>

            <div class="floor-tables-grid" id="tablesFloorGrid">
              <!-- Injected by JS -->
            </div>
          </div>

          <!-- ================================================================ -->
          <!-- TAB 3: PANGGILAN WAITER & MINTA BILL MONITOR                     -->
          <!-- ================================================================ -->
          <div id="tabContentWaiter" class="tab-pane-view is-hidden">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
              <div>
                <h2 style="font-size: 17px; font-weight: 800; color: #0f172a; margin: 0 0 4px;">Monitor Panggilan Waiter &amp; Permintaan Tagihan</h2>
                <p style="font-size: 13px; color: #64748b; margin: 0;">Respon kilat permintaan tamu meja makan untuk menjaga turn-over dan kepuasan pelanggan.</p>
              </div>
