---
import '../../styles/global.css';
import '../../styles/animations.css';
import '../../styles/app-software.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Supernova Booking OS — Unified Enterprise Reservation & Slot Engine" />
    <meta name="theme-color" content="#0b0f19" />
    <title>Supernova Booking OS — Unified Enterprise Reservation Engine</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%232563eb'/%3E%3Cpath d='M16 16h32v8H24v8h24v16H16z' fill='white'/%3E%3C/svg%3E" />
  </head>
  <body class="app-mode">
    <div id="toastContainer" class="toast-container"></div>

    <!-- ====================================================================== -->
    <!-- 1. SPLIT-SCREEN AUTHENTICATION (LOGIN & REGISTRATION)                  -->
    <!-- ====================================================================== -->
    <div id="authScreen" class="auth-split-screen">
      <!-- Left Panel: SVG Tech Character & Cyber Architecture Visual -->
      <div class="auth-panel-visual">
        <div class="auth-visual-top">
          <a href="/" class="app-brand-logo">
            <div class="app-brand-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </div>
            <div class="app-brand-text">
              <span class="brand-name">Supernova Booking OS</span>
              <span class="brand-tag">ENTERPRISE PLATFORM v2.4</span>
            </div>
          </a>
        </div>

        <div class="auth-visual-center">
          <div class="auth-hero-svg-wrap">
            <img
              src="/illustrations/booking-tech-character.svg"
              alt="Supernova Booking Engine Character Technology"
              width="600"
              height="500"
              loading="eager"
            />
          </div>
          <h2 class="auth-visual-title">Infrastruktur Penjadwalan Skala Bisnis</h2>
          <p class="auth-visual-subtitle">
            Zero collision detection, multi-tenant PostgreSQL cloud sync, pencegahan bentrok slot otomatis, dan tiket WhatsApp instan.
          </p>
        </div>

        <div class="auth-visual-footer">
          <span>© 2026 Supernova Labs Studio · Dedicated Cloud SaaS</span>
          <div class="tech-badges-row">
            <span class="tech-badge-pill">● Rust Axum 0.8</span>
            <span class="tech-badge-pill">● Neon PostgreSQL</span>
          </div>
        </div>
      </div>

      <!-- Right Panel: Professional Login & Registration Form -->
      <div class="auth-panel-form">
        <div class="auth-form-top-nav">
          <a href="/" class="back-website-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            <span>Kembali ke Website Utama</span>
          </a>
        </div>

        <div id="authAlertBox" class="auth-alert is-hidden" style="margin: 0 0 16px;"></div>

        <!-- LOGIN FORM CONTAINER -->
        <div id="loginBox">
          <div class="auth-form-header">
            <h1 class="auth-form-title">Masuk ke Sistem Bisnis</h1>
            <p class="auth-form-desc">Silakan masukkan email atau username bisnis Anda untuk mengakses ruang kerja operasional.</p>
          </div>

          <form id="formLogin" class="saas-form">
            <div class="saas-form-group">
              <label for="loginEmail">Email / Username Bisnis: <span class="req">*</span></label>
              <div class="saas-input-wrap">
                <input type="text" id="loginEmail" class="saas-input" required placeholder="username atau email bisnis..." autocomplete="username" />
              </div>
            </div>

            <div class="saas-form-group">
              <label for="loginPassword">Password: <span class="req">*</span></label>
              <div class="saas-input-wrap">
                <input type="password" id="loginPassword" class="saas-input" required placeholder="••••••••••••" autocomplete="current-password" />
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: #475569;">
              <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                <input type="checkbox" id="rememberMe" checked />
                <span>Ingat sesi akun ini</span>
              </label>
              <a href="#" id="btnForgotPwd" style="color: #2563eb; text-decoration: none; font-weight: 600;">Lupa Password?</a>
            </div>

            <button type="submit" class="btn-app-primary" id="btnSubmitLogin">
              <span>Masuk ke Dashboard Operasional</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>

            <button type="button" class="btn-instant-pill" id="btnQuickDemo">
              ⚡ Masuk Instan (Demo Supernova Arena)
            </button>
          </form>

          <div class="auth-bottom-switch">
            Belum punya akun? <a href="#" id="linkToRegister" class="text-blue font-bold">Daftar Disini</a>
          </div>
        </div>

        <!-- REGISTER FORM CONTAINER (TOGGLEABLE) -->
        <div id="registerBox" class="is-hidden">
          <div class="auth-form-header">
            <h1 class="auth-form-title">Daftar Akun Bisnis Baru</h1>
            <p class="auth-form-desc">Inisialisasi sistem reservasi &amp; slot operasional dedicated untuk brand bisnis Anda.</p>
          </div>

          <form id="formRegister" class="saas-form">
            <div class="form-row-2col">
              <div class="saas-form-group">
                <label for="regFullName">Nama Lengkap Pengelola: <span class="req">*</span></label>
                <input type="text" id="regFullName" class="saas-input" required placeholder="cth: Rian Pratama" />
              </div>
              <div class="saas-form-group">
                <label for="regBizName">Nama Brand / Usaha: <span class="req">*</span></label>
                <input type="text" id="regBizName" class="saas-input" required placeholder="cth: Garuda Sports & Studio" />
              </div>
            </div>

            <div class="form-row-2col">
              <div class="saas-form-group">
                <label for="regCategory">Tipe / Kategori Bisnis: <span class="req">*</span></label>
                <select id="regCategory" class="saas-select">
                  <option value="sports" selected>Sarana Olahraga (Futsal, Badminton, Tennis)</option>
                  <option value="studio">Studio Photo & Production House</option>
                  <option value="barber">Barbershop & Salon Grooming</option>
                  <option value="rental_ps">Rental PlayStation (PS5/PS4 Lounge)</option>
                  <option value="warnet">Warnet PC Gaming & Esports Center</option>
                  <option value="custom">Jasa / Layanan Booking Lainnya</option>
                </select>
              </div>
              <div class="saas-form-group">
                <label for="regCity">Kota / Wilayah: <span class="req">*</span></label>
                <input type="text" id="regCity" class="saas-input" required placeholder="cth: Jakarta Selatan / Surabaya" />
              </div>
            </div>

            <div class="saas-form-group">
              <label for="regWhatsApp">Nomor WhatsApp Operasional: <span class="req">*</span></label>
              <input type="tel" id="regWhatsApp" class="saas-input" required placeholder="cth: 081234567890" />
            </div>

            <div class="form-row-2col">
              <div class="saas-form-group">
                <label for="regEmail">Email Resmi Bisnis: <span class="req">*</span></label>
                <input type="email" id="regEmail" class="saas-input" required placeholder="owner@bisnis.id" autocomplete="email" />
              </div>
              <div class="saas-form-group">
                <label for="regPassword">Password Akun: <span class="req">*</span></label>
                <input type="password" id="regPassword" class="saas-input" required minlength="6" placeholder="Minimal 6 karakter" autocomplete="new-password" />
              </div>
            </div>

            <button type="submit" class="btn-app-primary" id="btnSubmitRegister">
              <span>Daftarkan Bisnis &amp; Mulai Operasional</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
          </form>

          <div class="auth-bottom-switch">
            Sudah punya akun? <a href="#" id="linkToLogin" class="text-blue font-bold">Masuk Disini</a>
          </div>
        </div>
      </div>
    </div>

    <!-- ====================================================================== -->
    <!-- 2. FULL SAAS APPLICATION DASHBOARD (UNLOCKED AFTER AUTHENTICATION)      -->
    <!-- ====================================================================== -->
    <div id="appDashboard" class="app-dashboard-wrapper is-hidden">
      <!-- Dedicated SaaS App Top Header -->
      <header class="app-header">
        <div class="app-header-left">
          <div class="app-header-brand">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>Supernova Booking OS</span>
          </div>

          <div class="header-divider-v"></div>

          <!-- DYNAMIC UNIQUE TENANT CODE (KODE UNIK AKUN) -->
          <div class="tenant-unique-badge" title="Kode Unik Identitas Akun Bisnis Anda">
            <span class="badge-dot"></span>
            <span class="tenant-label">KODE BISNIS:</span>
            <strong class="tenant-code-val" id="headerTenantCode">#SNV-8942-BKG</strong>
          </div>

          <div class="header-biz-info">
            <span id="headerBizName">Garuda Sport Arena</span>
            <span class="biz-city" id="headerBizCity">(Jakarta Selatan)</span>
          </div>
        </div>

        <div class="app-header-right">
          <span class="db-live-tag">
            <span class="badge-dot"></span>
            <span>Neon Cloud DB Live</span>
          </span>

          <button type="button" class="btn-header-cta" id="btnHeaderAddBooking">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>+ Reservasi Cepat</span>
          </button>

          <button type="button" class="btn-header-logout" id="btnHeaderShareLink">
            <span>🔗 Link Pelanggan</span>
          </button>

          <button type="button" class="btn-header-logout" id="btnHeaderLogout">
            <span>Keluar</span>
          </button>

          <a href="/" class="btn-header-logout" style="text-decoration: none;" title="Kembali ke portal landing page">
            <span>← Web Utama</span>
          </a>
        </div>
      </header>

      <!-- App Sub-Navigation Tabs Bar -->
      <nav class="app-subnav-bar">
        <div class="app-nav-tabs">
          <button type="button" class="app-tab-btn is-active" data-tab="schedule">
            <span>📅 Jadwal &amp; Kalender Slot</span>
          </button>
          <button type="button" class="app-tab-btn" data-tab="reservations">
            <span>📋 Database Reservasi</span>
          </button>
          <button type="button" class="app-tab-btn" data-tab="new-booking">
            <span>➕ Form Walk-In Booking</span>
          </button>
          <button type="button" class="app-tab-btn" data-tab="facilities">
            <span>🏟️ Sarana &amp; Fasilitas</span>
          </button>
          <button type="button" class="app-tab-btn" data-tab="public-portal">
            <span>🌐 Portal Booking Publik</span>
          </button>
          <button type="button" class="app-tab-btn" data-tab="reports">
            <span>📊 Laporan &amp; Buku Kas</span>
          </button>
        </div>

        <div class="app-subnav-actions">
          <button type="button" class="btn-app-primary" style="padding: 6px 12px; font-size: 12.5px;" id="btnSyncDb">
            <span>🔄 Sinkron Database</span>
          </button>
          <button type="button" class="btn-instant-pill" style="padding: 6px 12px; font-size: 12.5px;" id="btnExportCsvTop">
            <span>⬇ Unduh CSV</span>
          </button>
        </div>
      </nav>

      <!-- Main Operational Canvas -->
      <main class="app-main-canvas">
        <!-- Live Metric Cards Grid -->
        <div class="app-metrics-grid">
          <div class="app-metric-card">
            <div class="metric-card-top">
              <span class="m-label">TOTAL RESERVASI</span>
              <span class="m-badge m-badge--blue">Realtime</span>
            </div>
            <span class="m-value" id="mTotalCount">3</span>
            <span class="m-sub">Sesi tercatat di database</span>
          </div>

          <div class="app-metric-card">
            <div class="metric-card-top">
              <span class="m-label">ESTIMASI OMSET</span>
              <span class="m-badge m-badge--green">Terkonfirmasi</span>
            </div>
            <span class="m-value m-value--blue" id="mTotalRevenue">Rp 790.000</span>
            <span class="m-sub">Nilai transaksi jadwal aktif</span>
          </div>

          <div class="app-metric-card">
            <div class="metric-card-top">
              <span class="m-label">DOWN PAYMENT (DP)</span>
              <span class="m-badge m-badge--green">Terverifikasi</span>
            </div>
            <span class="m-value m-value--green" id="mTotalDp">Rp 385.000</span>
            <span class="m-sub">Uang muka dana masuk</span>
          </div>

          <div class="app-metric-card">
            <div class="metric-card-top">
              <span class="m-label">UTILISASI SARANA</span>
              <span class="m-badge m-badge--blue">Okupansi</span>
            </div>
            <span class="m-value" id="mOccupancy">65%</span>
            <span class="m-sub">Rasio slot waktu terisi</span>
          </div>
        </div>

        <!-- ================================================================ -->
        <!-- TAB 1: KALENDER & SLOT WAKTU                                     -->
        <!-- ================================================================ -->
        <div id="tabContentSchedule" class="tab-pane-content is-active">
          <div class="app-panel-card">
            <div class="panel-card-header">
              <div class="panel-card-title">
                <h3>Matrix Slot Jam Operasional</h3>
                <p>Pantau keterisian sarana secara visual dari pagi hingga malam hari.</p>
              </div>
              <div class="toolbar-right">
                <input type="date" class="saas-input" style="padding: 6px 12px; font-size: 13px;" id="matrixDateFilter" />
                <select class="saas-select" style="padding: 6px 12px; font-size: 13px;" id="matrixFacilitySelect">
                  <!-- Populated dynamically -->
                </select>
              </div>
            </div>

            <!-- Slot Time Grid -->
            <div class="slot-matrix-grid" id="slotMatrixGrid">
              <!-- Rendered dynamically -->
            </div>
          </div>
        </div>

        <!-- ================================================================ -->
        <!-- TAB 2: DATABASE DAFTAR RESERVASI REALTIME                         -->
        <!-- ================================================================ -->
        <div id="tabContentReservations" class="tab-pane-content is-hidden">
          <div class="app-panel-card">
            <div class="panel-card-header">
              <div class="panel-card-title">
                <h3>Buku Jadwal &amp; Data Reservasi Realtime</h3>
                <p>Data tersinkronisasi langsung dengan tabel Neon PostgreSQL serverless.</p>
              </div>
            </div>

            <div class="app-table-toolbar">
              <div class="toolbar-left">
                <input type="text" class="saas-input" style="width: 280px; padding: 7px 12px;" id="searchReservations" placeholder="🔍 Cari nama pemesan atau kode..." />
                <select class="saas-select" style="width: 200px; padding: 7px 12px;" id="filterFacilityTable">
                  <option value="all">Semua Sarana</option>
                </select>
              </div>
              <div class="toolbar-right">
                <button type="button" class="btn-app-primary" style="padding: 7px 14px; font-size: 13px;" id="btnOpenAddBookingTab">
                  <span>+ Tambah Booking Baru</span>
                </button>
              </div>
            </div>

            <div class="app-table-container">
              <table class="app-data-table">
                <thead>
                  <tr>
                    <th>KODE TIKET</th>
                    <th>PEMESAN &amp; KONTAK</th>
                    <th>SARANA / FASILITAS</th>
                    <th>JADWAL &amp; WAKTU</th>
                    <th>TOTAL &amp; DP</th>
                    <th>STATUS PEMBAYARAN</th>
                    <th>STATUS JADWAL</th>
                    <th>AKSI OPERASIONAL</th>
                  </tr>
                </thead>
                <tbody id="reservationsTableBody">
                  <!-- Populated by client script -->
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ================================================================ -->
        <!-- TAB 3: FORMULIR WALK-IN BOOKING                                   -->
        <!-- ================================================================ -->
        <div id="tabContentNewBooking" class="tab-pane-content is-hidden">
          <div class="app-panel-card" style="max-width: 860px; margin: 0 auto;">
            <div class="panel-card-header">
              <div class="panel-card-title">
                <h3>Reservasi Langsung (Walk-In / Pemesanan Manual)</h3>
                <p>Sistem mengecek tabrakan jadwal (collision detection) secara instan sebelum tiket disimpan.</p>
              </div>
            </div>

            <form id="formManualBooking" class="saas-form">
              <div class="form-row-2col">
                <div class="saas-form-group">
                  <label for="manFacility">Pilih Sarana / Lapangan: <span class="req">*</span></label>
                  <select id="manFacility" class="saas-select" required>
                    <!-- Populated dynamically -->
                  </select>
                </div>
                <div class="saas-form-group">
                  <label for="manCustomerName">Nama Pemesan / Tim: <span class="req">*</span></label>
                  <input type="text" id="manCustomerName" class="saas-input" required placeholder="cth: Dimas Aditya (FC Garuda)" />
                </div>
              </div>

              <div class="form-row-2col">
                <div class="saas-form-group">
                  <label for="manCustomerPhone">Nomor WhatsApp Pelanggan: <span class="req">*</span></label>
                  <input type="tel" id="manCustomerPhone" class="saas-input" required placeholder="cth: 081298765432" />
                </div>
                <div class="saas-form-group">
                  <label for="manCustomerEmail">Email Pelanggan (Opsional):</label>
                  <input type="email" id="manCustomerEmail" class="saas-input" placeholder="pelanggan@domain.com" />
                </div>
              </div>

              <div class="form-row-2col">
                <div class="saas-form-group">
                  <label for="manStartTime">Waktu Mulai: <span class="req">*</span></label>
                  <input type="datetime-local" id="manStartTime" class="saas-input" required />
                </div>
                <div class="saas-form-group">
                  <label for="manEndTime">Waktu Selesai: <span class="req">*</span></label>
                  <input type="datetime-local" id="manEndTime" class="saas-input" required />
                </div>
              </div>

              <div class="form-row-2col">
                <div class="saas-form-group">
                  <label for="manDownPayment">Uang Muka / DP Dibayar (Rp):</label>
                  <input type="number" id="manDownPayment" class="saas-input" placeholder="cth: 100000" />
                </div>
                <div class="saas-form-group">
                  <label for="manPaymentMethod">Metode Pembayaran DP:</label>
                  <select id="manPaymentMethod" class="saas-select">
                    <option value="qris" selected>QRIS Dinamis</option>
                    <option value="cash">Tunai di Resepsionis</option>
                    <option value="transfer">Transfer Bank</option>
                  </select>
                </div>
              </div>

              <div class="saas-form-group">
                <label for="manNotes">Catatan Khusus Sesi:</label>
                <input type="text" id="manNotes" class="saas-input" placeholder="Misal: Sewa rompi 1 tim, pinjam bola latihan, butuh sound system" />
              </div>

              <button type="submit" class="btn-app-primary" id="btnSubmitManualBooking">
                <span>Simpan Reservasi ke Database</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </button>
            </form>
          </div>
        </div>

        <!-- ================================================================ -->
        <!-- TAB 4: KELOLA SARANA & FASILITAS                                  -->
        <!-- ================================================================ -->
        <div id="tabContentFacilities" class="tab-pane-content is-hidden">
          <div class="app-panel-card">
            <div class="panel-card-header">
              <div class="panel-card-title">
                <h3>Kelola Sarana, Unit &amp; Tarif Sewa</h3>
                <p>Atur nama lapangan, kursi, studio, atau station serta tarif per jam untuk bisnis Anda.</p>
              </div>
              <button type="button" class="btn-app-primary" style="padding: 7px 14px; font-size: 13px;" id="btnToggleAddFacForm">
                <span>+ Tambah Fasilitas Baru</span>
              </button>
            </div>

            <!-- Add Facility Drawer Form -->
            <div id="addFacilityDrawer" class="is-hidden" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 10px; padding: 20px; margin-bottom: 20px;">
              <h4 style="margin: 0 0 14px; font-size: 15px;">Tambah Fasilitas Baru</h4>
              <form id="formAddFacility" class="saas-form">
                <div class="form-row-2col">
                  <div class="saas-form-group">
                    <label for="facName">Nama Sarana / Fasilitas: <span class="req">*</span></label>
                    <input type="text" id="facName" class="saas-input" required placeholder="cth: Lapangan Futsal Vinyl B" />
                  </div>
                  <div class="saas-form-group">
                    <label for="facCategory">Kategori / Spesifikasi: <span class="req">*</span></label>
                    <input type="text" id="facCategory" class="saas-input" required placeholder="cth: Vinyl FIFA Interlock" />
                  </div>
                </div>
                <div class="form-row-2col">
                  <div class="saas-form-group">
                    <label for="facRate">Tarif Sewa Per Jam (Rp): <span class="req">*</span></label>
                    <input type="number" id="facRate" class="saas-input" required placeholder="150000" />
                  </div>
                  <div class="saas-form-group">
                    <label for="facCapacity">Kapasitas Orang: <span class="req">*</span></label>
                    <input type="number" id="facCapacity" class="saas-input" required value="10" />
                  </div>
                </div>
                <div class="saas-form-group">
                  <label for="facDesc">Deskripsi Tambahan:</label>
                  <input type="text" id="facDesc" class="saas-input" placeholder="Lengkap dengan LED 800W dan papan skor digital" />
                </div>
                <div style="display: flex; gap: 10px;">
                  <button type="submit" class="btn-app-primary" style="padding: 8px 16px; font-size: 13px;">Simpan Fasilitas</button>
                  <button type="button" class="btn-instant-pill" id="btnCancelAddFac" style="padding: 8px 16px; font-size: 13px;">Batal</button>
                </div>
              </form>
            </div>

            <div class="fac-cards-layout" id="facilitiesGrid">
              <!-- Rendered dynamically -->
            </div>
          </div>
        </div>

        <!-- ================================================================ -->
        <!-- TAB 5: PORTAL BOOKING PUBLIK PELANGGAN                            -->
        <!-- ================================================================ -->
