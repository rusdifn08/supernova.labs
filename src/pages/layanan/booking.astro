  // 6. Login Success Handler
  const loginSuccess = async (profile: BusinessProfile, save = true) => {
    currentProfile = profile;
    if (save) {
      localStorage.setItem('supernova_live_service_session', JSON.stringify(profile));
    }

    // Populate Header UI
    if (wsBizName) wsBizName.textContent = profile.name;
    if (wsOwnerName) wsOwnerName.textContent = profile.owner;
    if (wsCity) wsCity.textContent = profile.city;
    if (wsEmail) wsEmail.textContent = profile.email;
    if (wsCategory) wsCategory.textContent = profile.category.toUpperCase();

    // Populate Ribbon Trial Timer
    if (ribbonDaysLeft) ribbonDaysLeft.textContent = `${profile.daysRemaining} Hari Tersisa`;
    if (ribbonExpiryMeta) {
      const expDate = new Date(profile.expiresAt);
      const formatted = expDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
      ribbonExpiryMeta.textContent = `Masa berlaku lisensi uji coba aktif s/d ${formatted} · Akses langsung tanpa batasan.`;
    }

    // Mockup URL
    const slug = profile.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    const mockupText = document.getElementById('mockupUrlText');
    const mockupTitle = document.getElementById('mockupBizName');
    if (mockupText) mockupText.textContent = `https://supernovasports.id/booking/${slug}`;
    if (mockupTitle) mockupTitle.textContent = profile.name;

    // Show workspace
    authGate?.classList.add('is-hidden');
    realWs?.classList.remove('is-hidden');

    // Fetch live backend data
    await loadResources();
    await loadBookings();
  };

