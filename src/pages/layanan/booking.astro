    const now = new Date();
    now.setHours(now.getHours() + 1, 0, 0, 0);
    startPicker.value = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    const later = new Date(now.getTime() + 2 * 3600000);
    endPicker.value = new Date(later.getTime() - later.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
  }

  // Refresh bookings button
  document.getElementById('btnRefreshBookings')?.addEventListener('click', async () => {
    await loadBookings();
    alert('✓ Sinkronisasi database Neon PostgreSQL berhasil!');
  });

  // Initialize
  checkStoredAuth();
</script>
