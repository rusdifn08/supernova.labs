        <!-- ================================================================ -->
        <!-- TAB 6: LAPORAN & BUKU KAS                                         -->
        <!-- ================================================================ -->
        <div id="tabContentReports" class="tab-pane-content is-hidden">
          <div class="app-panel-card">
            <div class="panel-card-header">
              <div class="panel-card-title">
                <h3>Rekapitulasi Pembukuan &amp; Kas Masuk</h3>
                <p>Unduh laporan lengkap jadwal dan uang muka pelanggan untuk buku kas akuntansi.</p>
