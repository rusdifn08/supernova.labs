---
import BaseLayout from '../../components/templates/BaseLayout.astro';
import Icon from '../../components/atoms/Icon.astro';
import Button from '../../components/atoms/Button.astro';
---

<BaseLayout title="Layanan Sistem Reservasi & Booking Terpadu | Supernova Labs">
  <div class="real-portal-page" data-portal-root="booking-service">
    <!-- Breadcrumb & Top Bar -->
    <div class="portal-topbar">
      <div class="container portal-topbar__inner">
        <div class="portal-breadcrumb">
          <a href="/">Beranda</a>
          <span class="sep">/</span>
          <a href="/#layanan">Layanan Sistem</a>
          <span class="sep">/</span>
          <strong>Online Booking System (Masa Aktif 1 Bulan Penuh)</strong>
        </div>
        <div class="portal-env-badges">
          <span class="badge badge--green" id="dbStatusBadge">● NEON POSTGRESQL TERHUBUNG</span>
          <span class="badge badge--dark">AXUM 0.8 RUST ENGINE</span>
          <span class="badge badge--trial">🟢 TRIAL 30 HARI BEBAS BIAYA</span>
        </div>
      </div>
    </div>

    <div class="container portal-main-container">
      <!-- Service Header Banner -->
      <div class="portal-intro">
        <span class="portal-eyebrow">ENTERPRISE CLOUD SERVICE · PRODUCTION READY</span>
        <h1>Layanan Sistem Reservasi &amp; Booking Terpadu</h1>
        <p class="portal-desc">
          Sistem operasional penuh untuk bisnis Sarana Olahraga, Studio Foto, Barbershop, Rental PS, Warnet, dan Layanan Jasa. Tanpa perlu konsultasi berulang, akun Anda <strong>langsung aktif selama 30 hari penuh</strong> untuk mengelola jadwal, mencegah bentrok (collision detection), mencatat down-payment, dan menerbitkan e-ticket WhatsApp.
        </p>
      </div>

      <!-- ============================================================ -->
      <!-- 1. AUTHENTICATION & BUSINESS ONBOARDING GATE                 -->
      <!-- ============================================================ -->
      <div class="auth-gate-card" id="authGateCard">
        <div class="auth-gate-header">
          <div class="auth-toggle-tabs">
            <button type="button" class="auth-tab is-active" id="tabRegister">
              <span>1. Daftar Akun Bisnis (Langsung Aktif 1 Bulan)</span>
            </button>
            <button type="button" class="auth-tab" id="tabLogin">
              <span>2. Masuk Akun Bisnis Terdaftar</span>
            </button>
          </div>
          <button type="button" class="btn btn--instant-demo" id="btnInstantDemo">
            <span>⚡ Masuk Instan (Akun Sampel Supernova Arena)</span>
          </button>
        </div>

        <div id="authAlertBox" class="auth-alert is-hidden"></div>

        <!-- FORM REGISTRASI AKUN BISNIS (AKTIF 30 HARI) -->
        <form class="auth-form" id="registerForm">
          <div class="form-grid-2col">
            <div class="form-group">
              <label for="regFullName">Nama Lengkap Pemilik / Pengelola: <span class="req">*</span></label>
              <input type="text" id="regFullName" class="sim-input" required placeholder="Contoh: Rian Gunawan" value="Rian Gunawan" />
            </div>

            <div class="form-group">
              <label for="regBizName">Nama Brand / Usaha Anda: <span class="req">*</span></label>
              <input type="text" id="regBizName" class="sim-input" required placeholder="Contoh: Garuda Sport Arena & Studio" value="Garuda Sport Arena & Studio" />
            </div>

            <div class="form-group">
              <label for="regEmail">Email Bisnis Resmi: <span class="req">*</span></label>
              <input type="email" id="regEmail" class="sim-input" required placeholder="owner@garudasports.id" value="owner@garudasports.id" />
            </div>

            <div class="form-group">
              <label for="regPassword">Password Akun Bisnis: <span class="req">*</span></label>
              <input type="password" id="regPassword" class="sim-input" required minlength="6" placeholder="Minimal 6 karakter" value="Supernova123!" />
            </div>

            <div class="form-group">
              <label for="regWhatsApp">Nomor WhatsApp Operasional: <span class="req">*</span></label>
              <input type="tel" id="regWhatsApp" class="sim-input" required placeholder="0812-xxxx-xxxx" value="081283626217" />
            </div>

            <div class="form-group">
              <label for="regCategory">Tipe / Kategori Bisnis: <span class="req">*</span></label>
              <select id="regCategory" class="sim-select">
                <option value="sports" selected>Sarana Olahraga (Futsal, Badminton, Mini Soccer, Basket)</option>
                <option value="studio">Studio Photo, Self-Photo &amp; Production House</option>
                <option value="barber">Barbershop, Salon &amp; Gentlemen Grooming</option>
                <option value="rental_ps">Rental PlayStation (PS5/PS4 Lounge)</option>
                <option value="warnet">Warnet PC Gaming &amp; Esports Center</option>
                <option value="general_services">Layanan / Jasa Profesional Lainnya</option>
              </select>
            </div>

            <div class="form-group">
              <label for="regCity">Kota / Lokasi Operasional: <span class="req">*</span></label>
              <input type="text" id="regCity" class="sim-input" required placeholder="Contoh: Jakarta Selatan, Bandung, Surabaya" value="Jakarta Selatan" />
            </div>

            <div class="form-group">
              <label>Paket Layanan yang Diaktifkan:</label>
              <div class="plan-preview-box">
                <strong>🟢 Paket Trial 1 Bulan (Bebas Biaya Penuh)</strong>
                <span>Akses penuh dashboard, database cloud PostgreSQL, dan API engine selama 30 hari kalender.</span>
              </div>
            </div>
          </div>

          <div class="form-footer-action">
            <button type="submit" class="btn btn--primary btn--md" id="btnSubmitRegister">
              <span>🚀 Aktifkan Layanan &amp; Masuk ke Dashboard Operasional</span>
              <Icon name="arrow" size={16} />
            </button>
            <span class="auth-privacy-note">🔒 Layanan berjalan langsung di infrastruktur Neon PostgreSQL &amp; Axum Rust. Tanpa kartu kredit.</span>
          </div>
        </form>

        <!-- FORM LOGIN AKUN TERDAFTAR -->
        <form class="auth-form is-hidden" id="loginForm">
          <div class="form-grid-2col">
            <div class="form-group">
              <label for="loginEmail">Email Bisnis Terdaftar: <span class="req">*</span></label>
              <input type="email" id="loginEmail" class="sim-input" required placeholder="owner@supernovasports.id" value="owner@supernovasports.id" />
            </div>
            <div class="form-group">
              <label for="loginPassword">Password: <span class="req">*</span></label>
              <input type="password" id="loginPassword" class="sim-input" required placeholder="Password Anda..." value="Supernova123!" />
            </div>
          </div>
          <div class="form-footer-action">
            <button type="submit" class="btn btn--primary btn--md" id="btnSubmitLogin">
              <span>Masuk ke Dashboard Operasional</span>
              <Icon name="arrow" size={16} />
            </button>
          </div>
        </form>
      </div>

      <!-- ============================================================ -->
      <!-- 2. REAL OPERATIONAL WORKSPACE (ACTIVE AFTER LOGIN)            -->
      <!-- ============================================================ -->
      <div class="real-workspace-panel is-hidden" id="realWorkspace">
        <!-- 30-DAY ACTIVE TRIAL BANNER -->
        <div class="trial-active-ribbon" id="trialActiveRibbon">
          <div class="ribbon-icon">🟢</div>
          <div class="ribbon-copy">
            <div class="ribbon-title">
              <strong id="ribbonStatusText">Status Layanan: AKTIF (30 Hari Bebas Biaya Penuh)</strong>
              <span class="ribbon-tag" id="ribbonDaysLeft">29 Hari Tersisa</span>
            </div>
            <div class="ribbon-meta" id="ribbonExpiryMeta">
              Masa berlaku s/d 20 November 2026 · Terhubung langsung ke Backend Engine Axum &amp; Cloud Neon PostgreSQL.
            </div>
          </div>
          <div class="ribbon-action">
            <button type="button" class="btn btn--outline btn--xs" id="btnExportCsv">⬇ Unduh Laporan CSV</button>
          </div>
        </div>

        <!-- Business Identity Header -->
        <div class="workspace-header-bar">
          <div class="biz-identity">
            <div class="biz-avatar" id="bizAvatarIcon">🏢</div>
            <div>
              <div class="biz-title-wrap">
                <h3 id="wsBizName">Supernova Arena Sports &amp; Studio</h3>
                <span class="badge badge--green" id="wsPlanBadge">30-DAY ACTIVE LICENSE</span>
              </div>
              <p class="biz-subtitle">
                Pengelola: <strong id="wsOwnerName">Rahmat Hidayat</strong> · Wilayah: <span id="wsCity">Jakarta Selatan</span> · Kategori: <span id="wsCategory">Sarana Olahraga</span> · Email: <span id="wsEmail">owner@supernovasports.id</span>
              </p>
            </div>
          </div>

          <div class="ws-header-actions">
            <button type="button" class="btn btn--secondary btn--sm" id="btnOpenPublicLinkModal">
              <span>🔗 Link Booking Pelanggan</span>
            </button>
            <button type="button" class="btn btn--outline btn--sm" id="btnSwitchAccount">
              <span>🚪 Ganti Akun / Logout</span>
            </button>
          </div>
        </div>

        <!-- Live Metrics Cards -->
        <div class="ws-metric-strip">
          <div class="metric-card">
            <span class="metric-label">TOTAL RESERVASI</span>
            <strong class="metric-value" id="metricTotalBookings">3</strong>
            <span class="metric-note">Jadwal tercatat di database</span>
          </div>
          <div class="metric-card">
            <span class="metric-label">TOTAL OMSET TERJADWAL</span>
            <strong class="metric-value text-blue" id="metricTotalRevenue">Rp 810.000</strong>
            <span class="metric-note">Nilai transaksi seluruh sesi</span>
          </div>
          <div class="metric-card">
            <span class="metric-label">UANG MUKA (DP) DITERIMA</span>
            <strong class="metric-value text-green" id="metricTotalDp">Rp 385.000</strong>
            <span class="metric-note">Dana terverifikasi masuk</span>
          </div>
          <div class="metric-card">
            <span class="metric-label">OKUPANSI SLOT OPERASIONAL</span>
            <strong class="metric-value" id="metricOccupancy">68%</strong>
            <span class="metric-note">Tingkat utilisasi sarana</span>
          </div>
        </div>

        <!-- Workspace Navigation Tabs -->
        <div class="workspace-nav-tabs">
          <button type="button" class="ws-tab is-active" data-wstab="schedule">📅 Jadwal Reservasi Aktif</button>
          <button type="button" class="ws-tab" data-wstab="new-booking">➕ Tambah Reservasi Baru</button>
          <button type="button" class="ws-tab" data-wstab="facilities">⚙️ Kelola Fasilitas &amp; Tarif</button>
          <button type="button" class="ws-tab" data-wstab="public-view">🌐 Preview Portal Pelanggan</button>
        </div>

        <!-- WORKSPACE TAB 1: KALENDER & RESERVASI REALTIME -->
        <div class="ws-tab-content is-active" id="wsContentSchedule">
          <div class="ws-toolbar">
            <div class="ws-filter-group">
              <label>Filter Fasilitas:</label>
              <select class="sim-select sim-select--sm" id="wsFilterFacility">
                <option value="all">Semua Fasilitas</option>
              </select>
            </div>
            <div class="ws-filter-group">
              <label>Tanggal Operasional:</label>
              <input type="date" class="sim-input sim-input--sm" id="wsScheduleDate" />
            </div>
            <button type="button" class="btn btn--secondary btn--sm" id="btnRefreshBookings">🔄 Sinkron Database</button>
            <button type="button" class="btn btn--primary btn--sm" id="btnQuickAddBooking">➕ Reservasi Cepat</button>
          </div>

          <!-- Active Bookings Table -->
          <div class="real-table-wrapper">
            <table class="real-data-table">
              <thead>
                <tr>
                  <th>KODE BOOKING</th>
                  <th>PEMESAN &amp; KONTAK</th>
                  <th>FASILITAS / SARANA</th>
                  <th>WAKTU &amp; DURASI</th>
                  <th>TOTAL &amp; DP</th>
                  <th>STATUS BAYAR</th>
                  <th>STATUS JADWAL</th>
                  <th>AKSI OPERASIONAL</th>
                </tr>
              </thead>
              <tbody id="wsBookingsTableBody">
                <!-- Injected via client script -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- WORKSPACE TAB 2: TAMBAH RESERVASI BARU -->
        <div class="ws-tab-content is-hidden" id="wsContentNewBooking">
          <div class="manual-booking-box">
            <h4>Formulir Reservasi Operasional (Walk-In / Pemesanan Langsung)</h4>
            <p class="section-desc">
              Data disimpan langsung ke database cloud PostgreSQL. Sistem akan secara otomatis menjalankan <strong>Collision Detection</strong> untuk mencegah double-booking pada jam dan fasilitas yang sama.
            </p>

            <form id="wsManualBookingForm" class="form-grid-2col">
              <div class="form-group">
                <label for="manFacility">Pilih Fasilitas / Unit: <span class="req">*</span></label>
                <select class="sim-select" id="manFacility" required>
                  <!-- Populated dynamically from backend -->
                </select>
              </div>

              <div class="form-group">
                <label for="manCustomerName">Nama Pemesan / Komunitas: <span class="req">*</span></label>
                <input type="text" class="sim-input" id="manCustomerName" required placeholder="Contoh: Budi Santoso (FC Batavia)" value="Dimas Aditya" />
              </div>

              <div class="form-group">
                <label for="manCustomerPhone">Nomor WhatsApp Pelanggan: <span class="req">*</span></label>
                <input type="tel" class="sim-input" id="manCustomerPhone" required placeholder="0812-xxxx-xxxx" value="081298761234" />
              </div>

              <div class="form-group">
                <label for="manCustomerEmail">Email Pelanggan (Opsional):</label>
                <input type="email" class="sim-input" id="manCustomerEmail" placeholder="pelanggan@example.com" />
              </div>

              <div class="form-group">
                <label for="manStartTime">Waktu Mulai: <span class="req">*</span></label>
                <input type="datetime-local" class="sim-input" id="manStartTime" required />
              </div>

              <div class="form-group">
                <label for="manEndTime">Waktu Selesai: <span class="req">*</span></label>
                <input type="datetime-local" class="sim-input" id="manEndTime" required />
              </div>

              <div class="form-group">
                <label for="manDownPayment">Uang Muka (DP) yang Dibayar (Rp):</label>
                <input type="number" class="sim-input" id="manDownPayment" placeholder="Contoh: 100000" />
              </div>

              <div class="form-group">
                <label for="manPaymentMethod">Metode Pembayaran DP:</label>
                <select class="sim-select" id="manPaymentMethod">
                  <option value="qris" selected>QRIS Dinamis / Statis</option>
                  <option value="cash">Tunai di Meja Resepsionis</option>
                  <option value="transfer">Transfer Bank (BCA / Mandiri / BRI)</option>
                </select>
              </div>

              <div class="form-group" style="grid-column: 1 / -1;">
                <label for="manNotes">Catatan Tambahan Reservasi:</label>
                <input type="text" class="sim-input" id="manNotes" placeholder="Misal: Sewa rompi 1 tim, pinjam bola latihan, butuh sound system" value="Sewa rompi 1 tim" />
              </div>

              <div class="form-footer-action" style="grid-column: 1 / -1;">
                <button type="submit" class="btn btn--primary btn--md" id="btnSubmitManualBooking">
                  <span>💾 Simpan Reservasi ke Database</span>
                  <Icon name="arrow" size={16} />
                </button>
                <span class="auth-privacy-note">Sistem langsung memeriksa slot jadwal agar tidak terjadi tabrakan waktu.</span>
              </div>
            </form>
          </div>
        </div>

        <!-- WORKSPACE TAB 3: KELOLA FASILITAS & TARIF -->
        <div class="ws-tab-content is-hidden" id="wsContentFacilities">
          <div class="facilities-control-wrap">
            <div class="facilities-header-bar">
              <div>
                <h4>Daftar Sarana, Lapangan &amp; Unit Operasional</h4>
                <p class="section-desc">Atur nama unit, kapasitas pemain/orang, dan tarif sewa per jam untuk bisnis Anda.</p>
              </div>
              <button type="button" class="btn btn--primary btn--sm" id="btnToggleAddFacilityModal">
                <span>➕ Tambah Fasilitas / Unit Baru</span>
              </button>
            </div>

            <!-- Facilities Cards Grid -->
            <div class="facilities-grid" id="wsFacilitiesGrid">
              <!-- Dynamically populated -->
            </div>

            <!-- Form Tambah Fasilitas Baru -->
            <div class="add-facility-card is-hidden" id="addFacilityCard">
              <h5>Tambah Unit / Fasilitas Baru ke Sistem</h5>
              <form id="addFacilityForm" class="form-grid-2col">
                <div class="form-group">
                  <label for="newFacName">Nama Fasilitas / Lapangan: <span class="req">*</span></label>
                  <input type="text" id="newFacName" class="sim-input" required placeholder="Contoh: Lapangan Futsal 2 (Vinyl Pro)" />
                </div>
                <div class="form-group">
                  <label for="newFacCategory">Kategori / Spesifikasi: <span class="req">*</span></label>
                  <input type="text" id="newFacCategory" class="sim-input" required placeholder="Contoh: Lantai Interlock FIFA" />
                </div>
                <div class="form-group">
                  <label for="newFacRate">Tarif Sewa Per Jam (Rp): <span class="req">*</span></label>
                  <input type="number" id="newFacRate" class="sim-input" required placeholder="150000" />
                </div>
                <div class="form-group">
                  <label for="newFacCapacity">Kapasitas Orang: <span class="req">*</span></label>
                  <input type="number" id="newFacCapacity" class="sim-input" required value="10" />
                </div>
                <div class="form-group" style="grid-column: 1 / -1;">
                  <label for="newFacDesc">Deskripsi Fasilitas:</label>
                  <input type="text" id="newFacDesc" class="sim-input" placeholder="Penerangan LED 800W, jaring pengaman, papan skor" />
                </div>
                <div class="form-footer-action" style="grid-column: 1 / -1;">
                  <button type="submit" class="btn btn--primary btn--sm">Simpan Fasilitas Baru</button>
                  <button type="button" class="btn btn--outline btn--sm" id="btnCancelAddFacility">Batal</button>
                </div>
              </form>
            </div>
          </div>
        </div>

        <!-- WORKSPACE TAB 4: PREVIEW PORTAL PELANGGAN -->
        <div class="ws-tab-content is-hidden" id="wsContentPublicView">
          <div class="public-preview-box">
            <div class="public-preview-header">
              <div>
                <h4>Halaman Pemesanan Online Pelanggan Anda</h4>
                <p class="section-desc">Bagikan link ini kepada pelanggan lewat bio Instagram, TikTok, atau WhatsApp agar mereka bisa reservasi mandiri 24/7 tanpa perlu admin manual.</p>
              </div>
              <button type="button" class="btn btn--secondary btn--sm" id="btnCopyPublicUrl">
                <span>📋 Salin Link Pemesanan</span>
              </button>
            </div>

            <div class="public-booking-mockup">
              <div class="mockup-header">
                <span class="mockup-url" id="mockupUrlText">https://supernovalabs.studio/book/garuda-sports</span>
                <span class="badge badge--green">ONLINE &amp; SIAP DIPESAN</span>
              </div>
              <div class="mockup-content">
                <div class="mockup-biz-badge">
                  <h3 id="mockupBizName">Supernova Arena Sports &amp; Studio</h3>
                  <p id="mockupBizMeta">Buka Setiap Hari: 07.00 - 24.00 WIB · Wilayah: Jakarta Selatan</p>
                </div>
                <div class="mockup-slot-picker">
                  <div class="mockup-slot is-selected">
                    <strong>19:00 - 21:00</strong>
                    <span>Tersedia</span>
                  </div>
                  <div class="mockup-slot is-booked">
                    <strong>17:00 - 19:00</strong>
                    <span>Terisi</span>
                  </div>
                  <div class="mockup-slot">
                    <strong>21:00 - 23:00</strong>
                    <span>Tersedia</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const API_BASE = 'http://127.0.0.1:8088/api/v1';

  // Elements
  const authGate = document.getElementById('authGateCard');
  const realWs = document.getElementById('realWorkspace');
  const tabReg = document.getElementById('tabRegister');
  const tabLog = document.getElementById('tabLogin');
  const regForm = document.getElementById('registerForm') as HTMLFormElement | null;
  const logForm = document.getElementById('loginForm') as HTMLFormElement | null;
  const btnInstant = document.getElementById('btnInstantDemo');
  const btnSwitch = document.getElementById('btnSwitchAccount');
  const authAlert = document.getElementById('authAlertBox');

  const wsBizName = document.getElementById('wsBizName');
  const wsOwnerName = document.getElementById('wsOwnerName');
  const wsCity = document.getElementById('wsCity');
  const wsCategory = document.getElementById('wsCategory');
  const wsEmail = document.getElementById('wsEmail');
  const ribbonDaysLeft = document.getElementById('ribbonDaysLeft');
  const ribbonExpiryMeta = document.getElementById('ribbonExpiryMeta');

  const metricBookings = document.getElementById('metricTotalBookings');
  const metricRevenue = document.getElementById('metricTotalRevenue');
  const metricDp = document.getElementById('metricTotalDp');
  const metricOccupancy = document.getElementById('metricOccupancy');

  const tbody = document.getElementById('wsBookingsTableBody');
  const manFacilitySelect = document.getElementById('manFacility') as HTMLSelectElement | null;
  const wsFilterFacility = document.getElementById('wsFilterFacility') as HTMLSelectElement | null;
  const wsFacilitiesGrid = document.getElementById('wsFacilitiesGrid');

  // State
  interface BusinessProfile {
    id?: string;
    name: string;
    owner: string;
    email: string;
    city: string;
    category: string;
    daysRemaining: number;
    expiresAt: string;
    token?: string;
  }

  let currentProfile: BusinessProfile | null = null;
  let resourcesList: any[] = [];
  let bookingsList: any[] = [];

  const showAlert = (msg: string, isError = false) => {
    if (!authAlert) return;
    authAlert.textContent = msg;
    authAlert.className = `auth-alert ${isError ? 'auth-alert--error' : 'auth-alert--success'}`;
    authAlert.classList.remove('is-hidden');
  };

  // 1. Initial Auth Check from Local Storage or Backend
  const checkStoredAuth = async () => {
    const raw = localStorage.getItem('supernova_live_service_session');
    if (raw) {
      try {
        const parsed = JSON.parse(raw);
        await loginSuccess(parsed, false);
        return;
      } catch (e) {
        // Fallback
      }
    }
  };

  // 2. Tab switching in Auth
  tabReg?.addEventListener('click', () => {
    tabReg.classList.add('is-active');
    tabLog?.classList.remove('is-active');
    regForm?.classList.remove('is-hidden');
    logForm?.classList.add('is-hidden');
    authAlert?.classList.add('is-hidden');
  });

  tabLog?.addEventListener('click', () => {
    tabLog.classList.add('is-active');
    tabReg?.classList.remove('is-active');
    logForm?.classList.remove('is-hidden');
    regForm?.classList.add('is-hidden');
    authAlert?.classList.add('is-hidden');
  });

  // 3. Register Form Submit -> Calls Backend API
  regForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    showAlert('Menghubungkan ke backend Axum & mendaftarkan akun...', false);

    const fullName = (document.getElementById('regFullName') as HTMLInputElement).value;
    const bizName = (document.getElementById('regBizName') as HTMLInputElement).value;
    const email = (document.getElementById('regEmail') as HTMLInputElement).value;
    const password = (document.getElementById('regPassword') as HTMLInputElement).value;
    const phone = (document.getElementById('regWhatsApp') as HTMLInputElement).value;
    const cat = (document.getElementById('regCategory') as HTMLSelectElement).value;
    const city = (document.getElementById('regCity') as HTMLInputElement).value;

    try {
      const res = await fetch(`${API_BASE}/auth/register`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          password,
          full_name: fullName,
          business_name: bizName,
          business_type: cat,
          phone_number: phone,
          city
        })
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.message || data.error || 'Pendaftaran gagal');
      }

      const profile: BusinessProfile = {
        id: data.user.id,
        name: data.user.business_name,
        owner: data.user.full_name,
