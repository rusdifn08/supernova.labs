  // 10. Render Table
  const renderBookingsTable = () => {
    if (!tbody) return;

    if (bookingsList.length === 0) {
      tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; padding: 32px; color: var(--muted);">Belum ada jadwal booking tersimpan. Klik "Tambah Reservasi Baru" di atas.</td></tr>`;
      return;
    }

    tbody.innerHTML = bookingsList.map((b, idx) => {
      const facName = b.facility_name || (resourcesList.find((r) => r.id === b.resource_id)?.name) || 'Fasilitas Terpilih';
      const startDate = new Date(b.start_time);
      const endDate = new Date(b.end_time);
      const timeStr = `${startDate.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })} - ${endDate.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })}`;
      const dateStr = startDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });

      const payPill = b.payment_status === 'paid_full' 
        ? '<span class="status-pill status-pill--paid">Lunas 100%</span>' 
        : b.payment_status === 'down_payment_paid' 
        ? '<span class="status-pill status-pill--dp">DP Diterima</span>' 
        : '<span class="status-pill status-pill--unpaid">Belum Bayar</span>';

      const statusBadge = b.booking_status === 'completed'
        ? '<span class="badge badge--green">Selesai</span>'
