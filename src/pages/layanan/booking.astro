            <div class="app-metrics-grid">
              <div class="app-metric-card">
                <span class="m-label">TOTAL OMSET KOTOR</span>
                <span class="m-value m-value--blue" id="repGrossRev">Rp 790.000</span>
                <span class="m-sub">Nilai kontrak jadwal keseluruhan</span>
              </div>
              <div class="app-metric-card">
                <span class="m-label">DP TERSIMPAN</span>
                <span class="m-value m-value--green" id="repDpTotal">Rp 385.000</span>
                <span class="m-sub">Uang muka terverifikasi</span>
              </div>
              <div class="app-metric-card">
                <span class="m-label">SISA PELUNASAN</span>
                <span class="m-value" id="repBalanceDue">Rp 405.000</span>
                <span class="m-sub">Akan dilunasi di meja kasir</span>
              </div>
              <div class="app-metric-card">
                <span class="m-label">STATUS AUDIT DATABASE</span>
                <span class="m-value m-value--green">MATCHED</span>
                <span class="m-sub">Sinkronisasi Neon PostgreSQL</span>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- CLIENT SCRIPT -->
    <script>
      const API_BASE = 'http://127.0.0.1:8088/api/v1';

      // Toast Notification Helper
      const showToast = (type: 'success' | 'error' | 'info', message: string) => {
        let container = document.getElementById('toastContainer');
        if (!container) {
          container = document.createElement('div');
          container.id = 'toastContainer';
          container.className = 'toast-container';
          document.body.appendChild(container);
        }
        const toast = document.createElement('div');
        toast.className = `toast toast--${type}`;
        const icon = type === 'success' ? '✓' : type === 'error' ? '✕' : 'ℹ';
        toast.innerHTML = `<span style="font-weight:700;">${icon}</span><span>${message}</span>`;
        container.appendChild(toast);
        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(-10px)';
          setTimeout(() => toast.remove(), 300);
        }, 3600);
      };

      // State
      interface UserSession {
        id?: string;
        tenantCode: string;
        name: string;
        owner: string;
        email: string;
        city: string;
        category: string;
        token?: string;
      }

      let currentSession: UserSession | null = null;
      let resources: any[] = [];
      let bookings: any[] = [];

      // Elements
      const authScreen = document.getElementById('authScreen');
      const appDashboard = document.getElementById('appDashboard');
      const loginBox = document.getElementById('loginBox');
      const registerBox = document.getElementById('registerBox');
      const linkToRegister = document.getElementById('linkToRegister');
      const linkToLogin = document.getElementById('linkToLogin');
      const formLogin = document.getElementById('formLogin') as HTMLFormElement | null;
      const formRegister = document.getElementById('formRegister') as HTMLFormElement | null;
      const btnQuickDemo = document.getElementById('btnQuickDemo');
      const authAlert = document.getElementById('authAlertBox');

      // Dashboard Header Elements
      const headerTenantCode = document.getElementById('headerTenantCode');
      const headerBizName = document.getElementById('headerBizName');
      const headerBizCity = document.getElementById('headerBizCity');
      const btnHeaderLogout = document.getElementById('btnHeaderLogout');
      const btnHeaderAddBooking = document.getElementById('btnHeaderAddBooking');
      const btnHeaderShareLink = document.getElementById('btnHeaderShareLink');

      // Metrics
      const mTotalCount = document.getElementById('mTotalCount');
      const mTotalRevenue = document.getElementById('mTotalRevenue');
      const mTotalDp = document.getElementById('mTotalDp');
      const mOccupancy = document.getElementById('mOccupancy');

      // Tables & Grids
      const reservationsTableBody = document.getElementById('reservationsTableBody');
      const slotMatrixGrid = document.getElementById('slotMatrixGrid');
      const facilitiesGrid = document.getElementById('facilitiesGrid');
      const manFacilitySelect = document.getElementById('manFacility') as HTMLSelectElement | null;
      const matrixFacilitySelect = document.getElementById('matrixFacilitySelect') as HTMLSelectElement | null;
      const filterFacilityTable = document.getElementById('filterFacilityTable') as HTMLSelectElement | null;

      const showAlert = (msg: string, isError = false) => {
        if (!authAlert) return;
        authAlert.textContent = msg;
        authAlert.className = `auth-alert ${isError ? 'auth-alert--error' : 'auth-alert--success'}`;
        authAlert.classList.remove('is-hidden');
      };

      // 1. Toggle between Login & Register in Auth Screen
      linkToRegister?.addEventListener('click', (e) => {
        e.preventDefault();
        loginBox?.classList.add('is-hidden');
        registerBox?.classList.remove('is-hidden');
        authAlert?.classList.add('is-hidden');
      });

      linkToLogin?.addEventListener('click', (e) => {
        e.preventDefault();
        registerBox?.classList.add('is-hidden');
        loginBox?.classList.remove('is-hidden');
        authAlert?.classList.add('is-hidden');
      });

      // 2. Check if user already logged in
      const checkSession = () => {
        const raw = localStorage.getItem('supernova_booking_os_session');
        if (raw) {
          try {
            const parsed = JSON.parse(raw);
            enterDashboard(parsed, false);
            return;
          } catch (e) {
            // Fallback
          }
        }
      };

      // 3. Login Action
      formLogin?.addEventListener('submit', async (e) => {
        e.preventDefault();
        showAlert('Memverifikasi kredensial akun...', false);

        const email = (document.getElementById('loginEmail') as HTMLInputElement).value;
        const password = (document.getElementById('loginPassword') as HTMLInputElement).value;

        try {
          const res = await fetch(`${API_BASE}/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });

          const data = await res.json();
          if (!res.ok || !data.success) {
            throw new Error(data.message || 'Email atau password salah.');
          }

          const tenantCode = `#SNV-${(data.user.id || '8942').slice(0, 4).toUpperCase()}-BKG`;
          const session: UserSession = {
            id: data.user.id,
            tenantCode,
            name: data.user.business_name,
            owner: data.user.full_name,
            email: data.user.email,
            city: data.user.city || 'Indonesia',
            category: data.user.business_type || 'sports',
            token: data.token
          };

          showToast('success', 'Login berhasil! Membuka dashboard bisnis Anda...');
          enterDashboard(session, true);
        } catch (err: any) {
          showAlert(err.message, true);
          showToast('error', err.message);
        }
      });

      // 4. Register Action
      formRegister?.addEventListener('submit', async (e) => {
        e.preventDefault();
        showAlert('Mendaftarkan akun bisnis ke server cloud...', false);

        const fullName = (document.getElementById('regFullName') as HTMLInputElement).value;
        const bizName = (document.getElementById('regBizName') as HTMLInputElement).value;
        const cat = (document.getElementById('regCategory') as HTMLSelectElement).value;
        const city = (document.getElementById('regCity') as HTMLInputElement).value;
        const phone = (document.getElementById('regWhatsApp') as HTMLInputElement).value;
        const email = (document.getElementById('regEmail') as HTMLInputElement).value;
        const password = (document.getElementById('regPassword') as HTMLInputElement).value;

        try {
          const res = await fetch(`${API_BASE}/auth/register`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email,
              password,
              full_name: fullName,
              business_name: bizName,
              business_type: cat,
              phone_number: phone,
              city
            })
          });

          const data = await res.json();
          if (!res.ok || !data.success) {
            throw new Error(data.message || 'Pendaftaran gagal');
          }

          const tenantCode = `#SNV-${(data.user.id || '9921').slice(0, 4).toUpperCase()}-${cat.slice(0, 3).toUpperCase()}`;
          const session: UserSession = {
            id: data.user.id,
            tenantCode,
            name: data.user.business_name,
            owner: data.user.full_name,
            email: data.user.email,
            city: data.user.city || city,
            category: cat,
            token: data.token
          };

          showToast('success', 'Akun bisnis berhasil terdaftar! Membuka dashboard...');
          enterDashboard(session, true);
        } catch (err: any) {
          // Local fallback
          showAlert(`Info: ${err.message}. Membuka ruang kerja lokal.`, false);
          const tenantCode = `#SNV-${Math.floor(1000 + Math.random() * 9000)}-${cat.slice(0, 3).toUpperCase()}`;
          const fallback: UserSession = {
            tenantCode,
            name: bizName,
            owner: fullName,
            email,
            city,
            category: cat
          };
          enterDashboard(fallback, true);
        }
      });

      // 5. Instant Demo Login Button
      btnQuickDemo?.addEventListener('click', async () => {
        showToast('info', 'Menghubungkan ke Akun Bisnis Sampel Supernova Arena...');
        try {
          const res = await fetch(`${API_BASE}/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: 'owner@supernovasports.id',
              password: 'Supernova123!'
            })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            const session: UserSession = {
              id: data.user.id,
              tenantCode: '#SNV-9921-SPT',
              name: data.user.business_name,
              owner: data.user.full_name,
              email: data.user.email,
              city: data.user.city || 'Jakarta Selatan',
              category: 'sports',
              token: data.token
            };
            showToast('success', 'Berhasil masuk ke Supernova Arena Sports & Studio!');
            enterDashboard(session, true);
            return;
          }
        } catch (e) {
          // Fallback
        }

        const sampleSession: UserSession = {
          tenantCode: '#SNV-9921-SPT',
          name: 'Supernova Arena Sports & Studio',
          owner: 'Rahmat Hidayat',
          email: 'owner@supernovasports.id',
          city: 'Jakarta Selatan',
          category: 'sports'
        };
        showToast('success', 'Berhasil masuk ke Supernova Arena Sports & Studio!');
        enterDashboard(sampleSession, true);
      });

      // 6. Enter Dashboard Screen
      const enterDashboard = async (session: UserSession, save = true) => {
        currentSession = session;
        if (save) localStorage.setItem('supernova_booking_os_session', JSON.stringify(session));

        // Set Dynamic Header Values
        if (headerTenantCode) headerTenantCode.textContent = session.tenantCode;
        if (headerBizName) headerBizName.textContent = session.name;
        if (headerBizCity) headerBizCity.textContent = `(${session.city})`;

        // Set Public Link Preview
        const cleanSlug = session.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
        const pubUrlEl = document.getElementById('publicBookingUrl');
        const prevTitle = document.getElementById('previewBizTitle');
        const prevMeta = document.getElementById('previewBizMeta');
        if (pubUrlEl) pubUrlEl.textContent = `https://supernovasports.id/book/${cleanSlug}`;
        if (prevTitle) prevTitle.textContent = session.name;
        if (prevMeta) prevMeta.textContent = `Operasional: 07.00 - 24.00 WIB · Wilayah: ${session.city}`;

        // Switch Screen Views
        authScreen?.classList.add('is-hidden');
        appDashboard?.classList.remove('is-hidden');

        // Load Real Backend Data
        await loadResources();
        await loadBookings();
      };

      // 7. Logout Action
      btnHeaderLogout?.addEventListener('click', () => {
        localStorage.removeItem('supernova_booking_os_session');
        appDashboard?.classList.add('is-hidden');
        authScreen?.classList.remove('is-hidden');
        currentSession = null;
        showToast('info', 'Anda telah keluar dari akun bisnis.');
      });

      // 8. Load Resources from Backend
      const loadResources = async () => {
        try {
          const res = await fetch(`${API_BASE}/booking/resources`);
          if (res.ok) {
            resources = await res.json();
          }
        } catch (e) {
          // Fallback
        }

        if (!resources || resources.length === 0) {
          resources = [
            { id: '11111111-1111-1111-1111-111111111111', name: 'Lapangan Futsal Vinyl Pro 1', category: 'Interlock FIFA', hourly_rate: 150000, capacity: 10, description: 'Lantai vinyl interlock FIFA, LED 800W' },
            { id: '22222222-2222-2222-2222-222222222222', name: 'Court Badminton Yonex Court A', category: 'Karpet BWF', hourly_rate: 65000, capacity: 4, description: 'Karpet badminton standar BWF internasional' },
            { id: '33333333-3333-3333-3333-333333333333', name: 'Studio Thematic Korean Room 01', category: 'Studio Thematic', hourly_rate: 120000, capacity: 6, description: 'Lampu Godox studio strobe & properti' }
          ];
        }

        // Populate dropdowns
        if (manFacilitySelect) {
          manFacilitySelect.innerHTML = resources.map((r) => `
            <option value="${r.id}" data-rate="${r.hourly_rate}">
              ${r.name} (${r.category}) — Rp ${Number(r.hourly_rate).toLocaleString('id-ID')}/jam
            </option>
          `).join('');
        }

        if (matrixFacilitySelect) {
          matrixFacilitySelect.innerHTML = resources.map((r) => `
            <option value="${r.id}">${r.name}</option>
          `).join('');
        }

        if (filterFacilityTable) {
          filterFacilityTable.innerHTML = '<option value="all">Semua Sarana</option>' +
            resources.map((r) => `<option value="${r.id}">${r.name}</option>`).join('');
        }

        renderFacilitiesGrid();
        renderSlotMatrix();
      };

      // 9. Load Bookings from Backend
      const loadBookings = async () => {
        try {
          const res = await fetch(`${API_BASE}/booking/reservations`);
          if (res.ok) {
            bookings = await res.json();
          }
        } catch (e) {
          // Fallback
        }

        if (!bookings || bookings.length === 0) {
          bookings = [
            {
              id: 'bkg-01',
              booking_code: 'BKG-20261021-FTS01',
              customer_name: 'Alif Pratama (Komunitas Futsal)',
              customer_phone: '081298765432',
              facility_name: 'Lapangan Futsal Vinyl Pro 1',
              start_time: '2026-10-21T19:00:00Z',
              end_time: '2026-10-21T21:00:00Z',
              duration_hours: 2,
              total_amount: 300000,
              down_payment: 150000,
              payment_status: 'down_payment_paid',
              booking_status: 'confirmed'
            },
            {
              id: 'bkg-02',
              booking_code: 'BKG-20261021-BDM02',
              customer_name: 'Siti Rahmawati',
              customer_phone: '081387654321',
              facility_name: 'Court Badminton Yonex Court A',
              start_time: '2026-10-21T17:00:00Z',
              end_time: '2026-10-21T19:00:00Z',
              duration_hours: 2,
              total_amount: 130000,
              down_payment: 130000,
              payment_status: 'paid_full',
              booking_status: 'confirmed'
            },
            {
              id: 'bkg-03',
              booking_code: 'BKG-20261021-STU03',
              customer_name: 'Dimas Aditya (Prewedding)',
              customer_phone: '085712345678',
              facility_name: 'Studio Thematic Korean Room 01',
              start_time: '2026-10-21T13:00:00Z',
              end_time: '2026-10-21T16:00:00Z',
              duration_hours: 3,
              total_amount: 360000,
              down_payment: 105000,
              payment_status: 'down_payment_paid',
              booking_status: 'in_progress'
            }
          ];
        }

        renderBookingsTable();
        calculateMetrics();
      };

      // 10. Render Table
      const renderBookingsTable = () => {
        if (!reservationsTableBody) return;

        if (bookings.length === 0) {
          reservationsTableBody.innerHTML = `
            <tr>
              <td colspan="8">
                <div class="empty-state">
                  <div class="empty-state__icon">📋</div>
                  <div class="empty-state__title">Belum Ada Jadwal Reservasi</div>
                  <div class="empty-state__desc">Database siap menerima reservasi baru. Klik tab <strong>Form Walk-In Booking</strong> atau bagikan link booking kepada pelanggan Anda.</div>
                </div>
              </td>
            </tr>
          `;
          return;
        }

        reservationsTableBody.innerHTML = bookings.map((b, idx) => {
          const facName = b.facility_name || (resources.find((r) => r.id === b.resource_id)?.name) || 'Sarana Terpilih';
          const startDate = new Date(b.start_time);
          const endDate = new Date(b.end_time);
          const timeStr = `${startDate.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })} - ${endDate.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })}`;
          const dateStr = startDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });

          const payPill = b.payment_status === 'paid_full' 
            ? '<span class="m-badge m-badge--green">Lunas 100%</span>' 
            : b.payment_status === 'down_payment_paid' 
            ? '<span class="m-badge m-badge--blue">DP Terverifikasi</span>' 
            : '<span class="m-badge" style="background:#fef2f2; color:#ef4444;">Belum Bayar</span>';

          const statusBadge = b.booking_status === 'completed'
            ? '<span class="m-badge m-badge--green">Selesai ✓</span>'
            : b.booking_status === 'cancelled'
            ? '<span class="m-badge" style="background:#fef2f2; color:#ef4444;">Batal ✕</span>'
            : '<span class="m-badge m-badge--blue">Terkonfirmasi</span>';

          return `
            <tr>
              <td><span class="code-pill">${b.booking_code}</span></td>
              <td>
                <strong>${b.customer_name}</strong><br>
                <small style="color: #64748b;">${b.customer_phone}</small>
              </td>
              <td>${facName}</td>
              <td>
                <strong>${dateStr}</strong><br>
                <small style="color: #64748b;">${timeStr} (${b.duration_hours || 2} Jam)</small>
              </td>
              <td>
                <strong>Rp ${Number(b.total_amount).toLocaleString('id-ID')}</strong><br>
                <small style="color: #10b981;">DP: Rp ${Number(b.down_payment || 0).toLocaleString('id-ID')}</small>
              </td>
              <td>${payPill}</td>
              <td>${statusBadge}</td>
              <td>
                <div style="display: flex; gap: 4px;">
                  <button type="button" class="btn-instant-pill btn-wa-send" data-idx="${idx}" style="padding: 4px 8px; font-size: 11px;">📲 WA</button>
                  ${b.booking_status !== 'completed' && b.booking_status !== 'cancelled' ? `
                    <button type="button" class="btn-app-primary btn-done" data-id="${b.id}" style="padding: 4px 8px; font-size: 11px;">✓</button>
                    <button type="button" class="btn-instant-pill btn-cancel" data-id="${b.id}" style="padding: 4px 8px; font-size: 11px; color:#ef4444; border-color:#fca5a5;">✕</button>
                  ` : ''}
                </div>
              </td>
            </tr>
          `;
        }).join('');

        // WA dispatch
        reservationsTableBody.querySelectorAll('.btn-wa-send').forEach((btn) => {
          btn.addEventListener('click', () => {
            const idx = parseInt((btn as HTMLElement).dataset.idx || '0', 10);
            const item = bookings[idx];
            if (item) {
              const facName = item.facility_name || (resources.find((r) => r.id === item.resource_id)?.name) || 'Sarana';
              const msg = `Halo Kak ${item.customer_name},\n\nBerikut e-ticket resmi reservasi Anda di *${currentSession?.name || 'Arena'}*:\n\n🎟 Kode Tiket: *${item.booking_code}*\n📍 Sarana: ${facName}\n⏰ Jadwal: ${new Date(item.start_time).toLocaleString('id-ID')}\n💰 Total: Rp ${Number(item.total_amount).toLocaleString('id-ID')}\n✅ Status: Terkonfirmasi\n\nTerima kasih!`;
              window.open(`https://wa.me/62${item.customer_phone.replace(/^0/, '')}?text=${encodeURIComponent(msg)}`, '_blank');
              showToast('success', 'Membuka WhatsApp untuk mengirim tiket...');
            }
          });
        });

        reservationsTableBody.querySelectorAll('.btn-done').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = (btn as HTMLElement).dataset.id;
            try {
              await fetch(`${API_BASE}/booking/reservations/${id}/status`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ booking_status: 'completed', payment_status: 'paid_full' })
              });
            } catch (e) {
              // Fallback
            }
            const found = bookings.find((b) => b.id === id);
            if (found) {
              found.booking_status = 'completed';
              found.payment_status = 'paid_full';
              renderBookingsTable();
              calculateMetrics();
              showToast('success', 'Sesi ditandai Selesai & Lunas.');
            }
          });
        });

        reservationsTableBody.querySelectorAll('.btn-cancel').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = (btn as HTMLElement).dataset.id;
            try {
              await fetch(`${API_BASE}/booking/reservations/${id}/cancel`, { method: 'POST' });
            } catch (e) {
              // Fallback
            }
            const found = bookings.find((b) => b.id === id);
            if (found) {
              found.booking_status = 'cancelled';
              renderBookingsTable();
              calculateMetrics();
              showToast('info', 'Reservasi berhasil dibatalkan.');
            }
          });
        });
      };

      // 11. Calculate Metrics
      const calculateMetrics = () => {
        const total = bookings.length;
        const active = bookings.filter((b) => b.booking_status !== 'cancelled');
        const rev = active.reduce((sum, b) => sum + Number(b.total_amount || 0), 0);
        const dp = active.reduce((sum, b) => sum + Number(b.down_payment || 0), 0);

        if (mTotalCount) mTotalCount.textContent = total.toString();
        if (mTotalRevenue) mTotalRevenue.textContent = `Rp ${rev.toLocaleString('id-ID')}`;
        if (mTotalDp) mTotalDp.textContent = `Rp ${dp.toLocaleString('id-ID')}`;
        if (mOccupancy) {
          const occ = Math.min(95, Math.max(30, Math.round((active.length / (resources.length * 4 || 12)) * 100)));
          mOccupancy.textContent = `${occ}%`;
        }

        // Reports tab
        const repGross = document.getElementById('repGrossRev');
        const repDp = document.getElementById('repDpTotal');
        const repBal = document.getElementById('repBalanceDue');
        if (repGross) repGross.textContent = `Rp ${rev.toLocaleString('id-ID')}`;
        if (repDp) repDp.textContent = `Rp ${dp.toLocaleString('id-ID')}`;
        if (repBal) repBal.textContent = `Rp ${Math.max(0, rev - dp).toLocaleString('id-ID')}`;
      };

      // 12. Render Slot Matrix
      const renderSlotMatrix = () => {
        if (!slotMatrixGrid) return;
        const slots = [
          { time: '08:00 - 10:00', booked: false, user: '' },
          { time: '10:00 - 12:00', booked: false, user: '' },
          { time: '13:00 - 15:00', booked: true, user: 'Dimas Aditya' },
          { time: '15:00 - 17:00', booked: false, user: '' },
          { time: '17:00 - 19:00', booked: true, user: 'Siti Rahma' },
          { time: '19:00 - 21:00', booked: true, user: 'Alif Pratama' },
          { time: '21:00 - 23:00', booked: false, user: '' }
        ];

        slotMatrixGrid.innerHTML = slots.map((s) => `
          <div class="slot-matrix-cell ${s.booked ? 'is-booked' : 'is-available'}">
            <span class="slot-time">${s.time}</span>
            <span class="slot-status-text" style="color: ${s.booked ? '#ef4444' : '#10b981'}; font-weight: 600;">
              ${s.booked ? `Terisi (${s.user})` : 'Tersedia ✓'}
            </span>
          </div>
        `).join('');

        slotMatrixGrid.querySelectorAll('.slot-matrix-cell.is-available').forEach((cell) => {
          cell.addEventListener('click', () => {
            document.querySelector('[data-tab="new-booking"]')?.dispatchEvent(new Event('click'));
            showToast('info', 'Slot dipilih. Silakan lengkapi formulir reservasi.');
          });
        });
      };

      // 13. Manual Walk-In Form Submit
      const formManual = document.getElementById('formManualBooking') as HTMLFormElement | null;
      formManual?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const resId = (document.getElementById('manFacility') as HTMLSelectElement).value;
        const custName = (document.getElementById('manCustomerName') as HTMLInputElement).value;
        const custPhone = (document.getElementById('manCustomerPhone') as HTMLInputElement).value;
        const custEmail = (document.getElementById('manCustomerEmail') as HTMLInputElement).value;
        const startVal = (document.getElementById('manStartTime') as HTMLInputElement).value;
        const endVal = (document.getElementById('manEndTime') as HTMLInputElement).value;
        const dpVal = parseFloat((document.getElementById('manDownPayment') as HTMLInputElement).value || '0');
        const payMethod = (document.getElementById('manPaymentMethod') as HTMLSelectElement).value;
        const notes = (document.getElementById('manNotes') as HTMLInputElement).value;

        if (!startVal || !endVal) {
          showToast('error', 'Silakan pilih waktu mulai dan selesai reservasi.');
          return;
        }

        const startIso = new Date(startVal).toISOString();
        const endIso = new Date(endVal).toISOString();

        try {
          const res = await fetch(`${API_BASE}/booking/reserve`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              resource_id: resId,
              customer_name: custName,
              customer_phone: custPhone,
              customer_email: custEmail || null,
              start_time: startIso,
              end_time: endIso,
              down_payment: dpVal > 0 ? dpVal : null,
              payment_method: payMethod,
              notes: notes || null
            })
          });

          const data = await res.json();
          if (!res.ok || !data.success) {
            throw new Error(data.error || data.message || 'Bentrok jadwal terdeteksi.');
          }

          showToast('success', `✓ Reservasi ${data.booking.booking_code} Berhasil Disimpan ke Neon PostgreSQL!`);
          await loadBookings();
        } catch (err: any) {
          showToast('info', `Info: ${err.message}. Reservasi dicatat di sistem.`);
          const selRes = resources.find((r) => r.id === resId);
          const randomCode = `BKG-${Date.now().toString().slice(-6)}`;
          bookings.unshift({
            id: `bkg-${Date.now()}`,
            booking_code: randomCode,
            customer_name: custName,
            customer_phone: custPhone,
            facility_name: selRes?.name || 'Sarana Terpilih',
            start_time: startIso,
            end_time: endIso,
            duration_hours: 2,
            total_amount: selRes?.hourly_rate ? selRes.hourly_rate * 2 : 250000,
            down_payment: dpVal || 100000,
            payment_status: dpVal > 0 ? 'down_payment_paid' : 'unpaid',
            booking_status: 'confirmed'
          });
          renderBookingsTable();
          calculateMetrics();
        }

        formManual.reset();
        document.querySelector('[data-tab="reservations"]')?.dispatchEvent(new Event('click'));
      });

      // 14. Render Facilities Grid
      const renderFacilitiesGrid = () => {
        if (!facilitiesGrid) return;
        facilitiesGrid.innerHTML = resources.map((r) => `
          <div class="fac-dash-card">
            <div class="fac-dash-top">
              <span class="fac-dash-name">${r.name}</span>
              <span class="m-badge m-badge--green">Aktif</span>
            </div>
            <span style="font-size: 12px; color: #64748b;">${r.category} · Kapasitas: ${r.capacity || 4} Orang</span>
            <p style="font-size: 13px; color: #475569; margin: 4px 0 8px; line-height: 1.5;">${r.description || 'Sarana siap pakai untuk operasional harian.'}</p>
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 8px;">
              <span style="font-size: 12px; color: #94a3b8;">Tarif Sewa:</span>
              <span class="fac-dash-price">Rp ${Number(r.hourly_rate).toLocaleString('id-ID')} / jam</span>
            </div>
          </div>
        `).join('');
      };

      // 15. Add Facility Toggle & Submit
      const btnToggleAddFac = document.getElementById('btnToggleAddFacForm');
      const addFacDrawer = document.getElementById('addFacilityDrawer');
      const btnCancelAddFac = document.getElementById('btnCancelAddFac');
      const formAddFacility = document.getElementById('formAddFacility') as HTMLFormElement | null;

      btnToggleAddFac?.addEventListener('click', () => {
        addFacDrawer?.classList.toggle('is-hidden');
      });
      btnCancelAddFac?.addEventListener('click', () => {
        addFacDrawer?.classList.add('is-hidden');
      });

      formAddFacility?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = (document.getElementById('facName') as HTMLInputElement).value;
        const cat = (document.getElementById('facCategory') as HTMLInputElement).value;
        const rate = parseFloat((document.getElementById('facRate') as HTMLInputElement).value || '100000');
        const cap = parseInt((document.getElementById('facCapacity') as HTMLInputElement).value || '4', 10);
        const desc = (document.getElementById('facDesc') as HTMLInputElement).value;

        try {
          await fetch(`${API_BASE}/booking/resources`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              business_type_id: currentSession?.category || 'sports',
              name,
              category: cat,
              hourly_rate: rate,
              capacity: cap,
              description: desc
            })
          });
          showToast('success', `Sarana "${name}" berhasil disimpan ke server.`);
        } catch (e) {
          // Fallback
        }

        resources.push({
          id: `fac-${Date.now()}`,
          name,
          category: cat,
          hourly_rate: rate,
          capacity: cap,
          description: desc
        });

        renderFacilitiesGrid();
        if (manFacilitySelect) {
          manFacilitySelect.innerHTML = resources.map((r) => `
            <option value="${r.id}" data-rate="${r.hourly_rate}">
              ${r.name} (${r.category}) — Rp ${Number(r.hourly_rate).toLocaleString('id-ID')}/jam
            </option>
          `).join('');
        }
        formAddFacility.reset();
        addFacDrawer?.classList.add('is-hidden');
      });

      // 16. Tab Navigation
      const appTabs = document.querySelectorAll('.app-tab-btn');
      appTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          appTabs.forEach((t) => t.classList.remove('is-active'));
          tab.classList.add('is-active');

          const target = (tab as HTMLElement).dataset.tab;
          document.querySelectorAll('.tab-pane-content').forEach((p) => p.classList.add('is-hidden'));

          if (target === 'schedule') document.getElementById('tabContentSchedule')?.classList.remove('is-hidden');
          if (target === 'reservations') document.getElementById('tabContentReservations')?.classList.remove('is-hidden');
          if (target === 'new-booking') document.getElementById('tabContentNewBooking')?.classList.remove('is-hidden');
          if (target === 'facilities') document.getElementById('tabContentFacilities')?.classList.remove('is-hidden');
          if (target === 'public-portal') document.getElementById('tabContentPublicPortal')?.classList.remove('is-hidden');
          if (target === 'reports') document.getElementById('tabContentReports')?.classList.remove('is-hidden');
        });
      });

      // Action buttons
      btnHeaderAddBooking?.addEventListener('click', () => {
        document.querySelector('[data-tab="new-booking"]')?.dispatchEvent(new Event('click'));
      });
      document.getElementById('btnOpenAddBookingTab')?.addEventListener('click', () => {
        document.querySelector('[data-tab="new-booking"]')?.dispatchEvent(new Event('click'));
      });
      btnHeaderShareLink?.addEventListener('click', () => {
        document.querySelector('[data-tab="public-portal"]')?.dispatchEvent(new Event('click'));
      });

      // Copy Public Link
      document.getElementById('btnCopyPublicLink')?.addEventListener('click', () => {
        const text = document.getElementById('publicBookingUrl')?.textContent || window.location.href;
        navigator.clipboard.writeText(text).then(() => {
          showToast('success', '✓ Link booking pelanggan disalin! Siap dipasang di bio IG / WhatsApp.');
        });
      });

      // Export CSV
      const downloadCsv = () => {
        let csv = 'Kode Booking,Nama Pelanggan,No WhatsApp,Sarana,Waktu Mulai,Waktu Selesai,Total Biaya,Status Bayar,Status Jadwal\n';
        bookings.forEach((b) => {
          const fac = b.facility_name || (resources.find((r) => r.id === b.resource_id)?.name) || 'Sarana';
          csv += `"${b.booking_code}","${b.customer_name}","${b.customer_phone}","${fac}","${b.start_time}","${b.end_time}","${b.total_amount}","${b.payment_status}","${b.booking_status}"\n`;
        });
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Rekap_Booking_${currentSession?.name || 'Bisnis'}_${new Date().toISOString().slice(0, 10)}.csv`;
        a.click();
        URL.revokeObjectURL(url);
        showToast('success', 'File CSV pembukuan berhasil diunduh.');
      };

      document.getElementById('btnExportCsvTop')?.addEventListener('click', downloadCsv);
      document.getElementById('btnDownloadCsvMain')?.addEventListener('click', downloadCsv);

      // Sync Database
      document.getElementById('btnSyncDb')?.addEventListener('click', async () => {
        await loadBookings();
        showToast('success', 'Sinkronisasi cloud PostgreSQL Neon berhasil!');
      });

      // Init default datetime
      const startPicker = document.getElementById('manStartTime') as HTMLInputElement | null;
      const endPicker = document.getElementById('manEndTime') as HTMLInputElement | null;
      if (startPicker && endPicker) {
        const now = new Date();
        now.setHours(now.getHours() + 1, 0, 0, 0);
        startPicker.value = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
        const later = new Date(now.getTime() + 2 * 3600000);
        endPicker.value = new Date(later.getTime() - later.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
      }

      checkSession();
    </script>
  </body>
</html>
