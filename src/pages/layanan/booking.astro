        : '<span class="badge badge--green">Terkonfirmasi</span>';

      return `
        <tr>
          <td><strong class="code-tag">${b.booking_code}</strong></td>
          <td>
            <strong>${b.customer_name}</strong><br>
            <small class="text-muted">${b.customer_phone}</small>
          </td>
          <td>${facName}</td>
          <td>
            <strong>${dateStr}</strong><br>
            <small class="text-muted">${timeStr} (${b.duration_hours || 2} Jam)</small>
          </td>
          <td>
            <strong>Rp ${Number(b.total_amount).toLocaleString('id-ID')}</strong><br>
            <small class="text-muted">DP: Rp ${Number(b.down_payment || 0).toLocaleString('id-ID')}</small>
          </td>
          <td>${payPill}</td>
          <td>${statusBadge}</td>
          <td>
            <div class="row-actions">
              <button type="button" class="btn btn--outline btn--xs btn-send-ticket" data-idx="${idx}" title="Kirim E-Tiket WhatsApp">📲 WA</button>
              ${b.booking_status !== 'completed' && b.booking_status !== 'cancelled' ? `
                <button type="button" class="btn btn--secondary btn--xs btn-complete-bkg" data-id="${b.id}" title="Tandai Selesai">✓</button>
                <button type="button" class="btn btn--outline btn--xs btn-cancel-bkg" data-id="${b.id}" title="Batalkan Reservasi">✕</button>
              ` : ''}
            </div>
          </td>
        </tr>
      `;
    }).join('');

    // Attach actions
    tbody.querySelectorAll('.btn-send-ticket').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt((btn as HTMLElement).dataset.idx || '0', 10);
        const item = bookingsList[idx];
        if (item) {
          const facName = item.facility_name || (resourcesList.find((r) => r.id === item.resource_id)?.name) || 'Fasilitas';
          const msg = `Halo Kak ${item.customer_name},\n\nBerikut e-ticket resmi reservasi Anda di *${wsBizName?.textContent || 'Arena'}*:\n\n🎟 Kode Tiket: *${item.booking_code}*\n📍 Sarana: ${facName}\n⏰ Jadwal: ${new Date(item.start_time).toLocaleString('id-ID')}\n💰 Total: Rp ${Number(item.total_amount).toLocaleString('id-ID')}\n✅ Status: Terkonfirmasi\n\nTerima kasih atas kunjungan Anda!`;
          window.open(`https://wa.me/62${item.customer_phone.replace(/^0/, '')}?text=${encodeURIComponent(msg)}`, '_blank');
        }
      });
    });

    tbody.querySelectorAll('.btn-complete-bkg').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        try {
          await fetch(`${API_BASE}/booking/reservations/${id}/status`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ booking_status: 'completed', payment_status: 'paid_full' })
          });
        } catch (e) {
          // Fallback
        }
        const found = bookingsList.find((b) => b.id === id);
        if (found) {
          found.booking_status = 'completed';
          found.payment_status = 'paid_full';
          renderBookingsTable();
          calculateMetrics();
        }
      });
    });

    tbody.querySelectorAll('.btn-cancel-bkg').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        if (!confirm('Apakah Anda yakin ingin membatalkan jadwal reservasi ini?')) return;
        try {
          await fetch(`${API_BASE}/booking/reservations/${id}/cancel`, { method: 'POST' });
        } catch (e) {
          // Fallback
        }
        const found = bookingsList.find((b) => b.id === id);
        if (found) {
          found.booking_status = 'cancelled';
          renderBookingsTable();
          calculateMetrics();
        }
      });
    });
