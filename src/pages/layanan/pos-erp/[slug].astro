---
import '../../../styles/global.css';
import '../../../styles/animations.css';
import '../../../styles/public-booking.css';

export async function getStaticPaths() {
  return [
    { params: { slug: 'supernova-store' } },
    { params: { slug: 'karsa-coffee' } },
    { params: { slug: 'toko-sejahtera' } },
    { params: { slug: 'demo-retail' } },
    { params: { slug: 'outlet-supernova' } },
    { params: { slug: 'demo' } }
  ];
}

const { slug } = Astro.params;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`Katalog Toko Online & E-Menu Resmi — ${slug.toUpperCase()} Powered by Supernova POS`} />
    <meta name="theme-color" content="#2563eb" />
    <title>Katalog Toko Online — {slug.toUpperCase()} | Supernova POS &amp; ERP</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%232563eb'/%3E%3Cpath d='M20 18h24v8H28v6h16v8H28v8H20z' fill='white'/%3E%3C/svg%3E" />
  </head>
  <body class="public-booking-mode">
    <div id="toastContainer" class="toast-container"></div>

    <div class="pub-container">
      <!-- Top Branding Bar -->
      <header class="pub-top-bar">
        <a href="/" class="pub-brand">
          <div class="pub-brand-badge">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.3">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <line x1="2" y1="10" x2="22" y2="10"></line>
            </svg>
          </div>
          <div>
            <div class="pub-brand-name">Supernova Storefront</div>
            <span class="pub-brand-sub">KATALOG ONLINE RESMI</span>
          </div>
        </a>

        <a href="https://wa.me/6281234567890?text=Halo%20Admin,%20saya%20ingin%20tanya%20menu%20dan%20pesanan" target="_blank" rel="noopener" class="pub-contact-wa" id="btnHeaderWa">
          <span>Chat Kasir via WhatsApp</span>
        </a>
      </header>

      <!-- Store Showcase Card -->
      <section class="pub-venue-card">
        <div class="pub-venue-header">
          <div class="pub-venue-info">
            <h1 id="storeTitle">
              <span>Supernova Retail &amp; Coffee Roasters</span>
              <span class="pub-verified-pill">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                <span>Outlet Resmi Terverifikasi</span>
              </span>
            </h1>
            <div class="pub-venue-meta">
              <span class="pub-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span id="storeAddress">Jl. Senopati Raya No. 24, Jakarta Selatan</span>
              </span>
              <span class="pub-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                <span>Buka: 07:00 - 22:00 WIB</span>
              </span>
              <span class="pub-meta-item">
                <span style="color: #f59e0b;">★★★★★</span>
                <strong>4.9</strong>
                <span style="color: #64748b;">(890+ Ulasan Puas)</span>
              </span>
            </div>
            <div class="pub-venue-badges">
              <span class="pub-feature-tag">⚡ Pesan Tanpa Antre</span>
              <span class="pub-feature-tag">💳 Support QRIS &amp; Transfer</span>
              <span class="pub-feature-tag">📱 Struk Digital WhatsApp</span>
              <span class="pub-feature-tag">✨ Poin Loyalitas Member</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Category Filter Chips -->
      <div class="pub-date-chips-wrap" style="margin-bottom: 20px;">
        <button type="button" class="pub-date-chip is-active cat-filter-btn" data-cat="all">
          <span class="pub-date-num" style="font-size: 13px;">Semua Produk</span>
        </button>
        <button type="button" class="pub-date-chip cat-filter-btn" data-cat="coffee">
          <span class="pub-date-num" style="font-size: 13px;">☕ Kopi Espresso</span>
        </button>
        <button type="button" class="pub-date-chip cat-filter-btn" data-cat="beverage">
          <span class="pub-date-num" style="font-size: 13px;">🥤 Non-Kopi</span>
        </button>
        <button type="button" class="pub-date-chip cat-filter-btn" data-cat="food">
          <span class="pub-date-num" style="font-size: 13px;">🥐 Pastry &amp; Food</span>
        </button>
        <button type="button" class="pub-date-chip cat-filter-btn" data-cat="retail">
          <span class="pub-date-num" style="font-size: 13px;">🛒 Retail &amp; Merch</span>
        </button>
      </div>

      <!-- Main Layout: Catalog on Left, Checkout Cart on Right -->
      <div class="pub-booking-layout">
        <!-- Catalog Items -->
        <div class="pub-steps-col">
          <div class="pub-facility-grid" id="storeProductGrid">
            <!-- Populated dynamically -->
          </div>
        </div>

        <!-- Sticky Cart Panel -->
        <aside class="pub-summary-sticky">
          <div class="pub-summary-title">
            <span>Keranjang Belanja</span>
            <span style="font-size: 12px; font-weight: 600; color: #059669; background: #ecfdf5; padding: 2px 8px; border-radius: 999px;">
              Live Kasir
            </span>
          </div>

          <div id="storeCartItems" style="max-height: 240px; overflow-y: auto; margin-bottom: 16px;">
            <div style="text-align: center; color: #94a3b8; font-size: 13px; padding: 24px 0;">
              Keranjang masih kosong.<br>Klik "+ Tambah" pada produk di sebelah kiri.
            </div>
          </div>

          <div class="pub-summary-divider"></div>

          <div class="pub-total-box">
            <div class="pub-total-row">
              <span class="pub-total-label">Total Pesanan:</span>
              <span class="pub-total-price" id="storeGrandTotal">Rp 0</span>
            </div>
          </div>

          <!-- Customer Form -->
          <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px;">
            <div>
              <label style="font-size: 12px; font-weight: 700; color: #334155;">Nama Pemesan:</label>
              <input type="text" id="custNameInput" class="pub-input" placeholder="Nama Anda..." style="padding: 10px 12px; font-size: 13px; margin-top: 4px;" />
            </div>
            <div>
              <label style="font-size: 12px; font-weight: 700; color: #334155;">No. WhatsApp (Untuk Struk):</label>
              <input type="tel" id="custPhoneInput" class="pub-input" placeholder="081234567890" style="padding: 10px 12px; font-size: 13px; margin-top: 4px;" />
            </div>
          </div>

          <button type="button" class="pub-btn-confirm pub-btn-confirm--wa" id="btnSubmitStoreOrder">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink: 0;">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.97.531 1.764.789 2.796.79h.005c3.18 0 5.767-2.587 5.768-5.766.001-3.181-2.586-5.767-5.773-5.767zm0 10.428h-.004c-.88 0-1.74-.237-2.489-.684l-.178-.106-1.849.485.494-1.802-.116-.185c-.49-.78-.749-1.688-.748-2.618.001-2.68 2.181-4.861 4.864-4.861 2.682 0 4.863 2.18 4.862 4.861-.001 2.681-2.181 4.861-4.862 4.861z"/>
            </svg>
            <span>Pesan Sekarang via WhatsApp</span>
          </button>
        </aside>
      </div>
    </div>

    <!-- Client Script -->
    <script>
      const defaultProducts = [
        { id: 'p-1', name: 'Kopi Susu Gula Aren 250ml', category: 'coffee', price: 22000, desc: 'Espresso double shot dengan gula aren organik dan fresh milk', icon: '☕' },
        { id: 'p-2', name: 'Caffe Latte Double Shot', category: 'coffee', price: 28000, desc: 'Creamy steamed milk dengan biji kopi arabika pilihan', icon: '☕' },
        { id: 'p-3', name: 'Matcha Cream Frappe', category: 'beverage', price: 32000, desc: 'Uji matcha premium dari Jepang dengan whipped cream lembut', icon: '🥤' },
        { id: 'p-4', name: 'Croissant Butter Flaky', category: 'food', price: 25000, desc: 'Pastry mentega Prancis dengan lapisan renyah dan harum', icon: '🥐' },
        { id: 'p-5', name: 'Almond Danish Sweet Pastry', category: 'food', price: 27000, desc: 'Topping almond panggang renyah dengan custard manis', icon: '🥐' },
        { id: 'p-6', name: 'Tumbler Stainless 500ml', category: 'retail', price: 120000, desc: 'Menjaga minuman dingin hingga 12 jam, anti karat food grade', icon: '🛒' }
      ];

      let cart: { item: any; qty: number }[] = [];
      const formatRupiah = (val: number) => 'Rp ' + Math.round(val).toLocaleString('id-ID');

      const renderProducts = (cat = 'all') => {
        const grid = document.getElementById('storeProductGrid');
        if (!grid) return;

        let filtered = defaultProducts;
        if (cat !== 'all') filtered = filtered.filter(p => p.category === cat);

        grid.innerHTML = filtered.map(p => `
          <div class="pub-facility-card" style="min-height: 180px;">
            <div class="pub-fac-top">
              <span class="pub-fac-icon">${p.icon}</span>
              <span style="font-size: 12px; font-weight: 700; color: #059669; background: #ecfdf5; padding: 2px 8px; border-radius: 999px;">Tersedia</span>
            </div>
            <div>
              <h4 class="pub-fac-name">${p.name}</h4>
              <p class="pub-fac-spec">${p.desc}</p>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 10px; margin-top: 8px;">
              <span class="pub-fac-price">${formatRupiah(p.price)}</span>
              <button type="button" class="btn-app-primary btn-add-store" data-id="${p.id}" style="padding: 6px 14px; font-size: 12px; border-radius: 8px;">
                + Tambah
              </button>
            </div>
          </div>
        `).join('');

        grid.querySelectorAll('.btn-add-store').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = (btn as HTMLElement).dataset.id;
            const found = defaultProducts.find(p => p.id === id);
            if (found) {
              const inCart = cart.find(c => c.item.id === found.id);
              if (inCart) inCart.qty++;
              else cart.push({ item: found, qty: 1 });
              renderCart();
            }
          });
        });
      };

      const renderCart = () => {
        const list = document.getElementById('storeCartItems');
        const totalEl = document.getElementById('storeGrandTotal');
        if (!list) return;

        if (cart.length === 0) {
          list.innerHTML = `
            <div style="text-align: center; color: #94a3b8; font-size: 13px; padding: 24px 0;">
              Keranjang masih kosong.<br>Klik "+ Tambah" pada produk di sebelah kiri.
            </div>
          `;
          if (totalEl) totalEl.textContent = 'Rp 0';
          return;
        }

        list.innerHTML = cart.map((c, idx) => `
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: 13px;">
            <div>
              <strong>${c.item.name}</strong><br>
              <small style="color: #64748b;">${formatRupiah(c.item.price)} x ${c.qty}</small>
            </div>
            <div style="display: flex; align-items: center; gap: 6px;">
              <button type="button" class="btn-minus" data-idx="${idx}" style="padding: 2px 8px; border: 1px solid #cbd5e1; background: #fff; border-radius: 4px; cursor: pointer;">-</button>
              <strong>${c.qty}</strong>
              <button type="button" class="btn-plus" data-idx="${idx}" style="padding: 2px 8px; border: 1px solid #cbd5e1; background: #fff; border-radius: 4px; cursor: pointer;">+</button>
              <strong style="width: 70px; text-align: right;">${formatRupiah(c.item.price * c.qty)}</strong>
            </div>
          </div>
        `).join('');

        list.querySelectorAll('.btn-minus').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = parseInt((btn as HTMLElement).dataset.idx || '0', 10);
            if (cart[idx].qty > 1) cart[idx].qty--;
            else cart.splice(idx, 1);
            renderCart();
          });
        });

        list.querySelectorAll('.btn-plus').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = parseInt((btn as HTMLElement).dataset.idx || '0', 10);
            cart[idx].qty++;
            renderCart();
          });
        });

        const total = cart.reduce((s, c) => s + (c.item.price * c.qty), 0);
        if (totalEl) totalEl.textContent = formatRupiah(total);
      };

      document.querySelectorAll('.cat-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.cat-filter-btn').forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          const cat = btn.getAttribute('data-cat') || 'all';
          renderProducts(cat);
        });
      });

      document.getElementById('btnSubmitStoreOrder')?.addEventListener('click', () => {
        if (cart.length === 0) {
          alert('Keranjang belanja masih kosong.');
          return;
        }

        const name = (document.getElementById('custNameInput') as HTMLInputElement)?.value.trim() || 'Pelanggan';
        const phone = (document.getElementById('custPhoneInput') as HTMLInputElement)?.value.trim() || '-';
        const total = cart.reduce((s, c) => s + (c.item.price * c.qty), 0);

        const itemsText = cart.map(c => `• ${c.item.name} (${c.qty}x) = ${formatRupiah(c.item.price * c.qty)}`).join('\n');
        const msg = encodeURIComponent(
          `*PESANAN ONLINE BARU - SUPERNOVA STORE*\n\n` +
          `Nama Pemesan: ${name}\n` +
          `No. WhatsApp: ${phone}\n\n` +
          `*Rincian Barang:*\n${itemsText}\n\n` +
          `*Total Tagihan:* ${formatRupiah(total)}\n\n` +
          `Mohon proses pesanan ini dan konfirmasi metode pembayaran (QRIS / Transfer). Terima kasih!`
        );

        window.open(`https://wa.me/6281234567890?text=${msg}`, '_blank');
      });

      renderProducts('all');
    </script>
  </body>
</html>
