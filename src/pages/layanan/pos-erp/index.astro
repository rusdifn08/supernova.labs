---
import '../../../styles/global.css';
import '../../../styles/animations.css';
import '../../../styles/app-software.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Supernova POS & ERP Core OS — Unified Commerce, Multi-Warehouse Inventory & Financial Ledger" />
    <meta name="theme-color" content="#0f172a" />
    <title>Supernova POS &amp; ERP Core OS — Unified Commerce &amp; Financial Ledger</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%232563eb'/%3E%3Cpath d='M20 18h24v8H28v6h16v8H28v8H20z' fill='white'/%3E%3C/svg%3E" />
  </head>
  <body class="app-mode">
    <div id="toastContainer" class="toast-container"></div>

    <!-- ====================================================================== -->
    <!-- 1. SPLIT-SCREEN AUTHENTICATION (LOGIN & REGISTRATION)                  -->
    <!-- ====================================================================== -->
    <div id="authScreen" class="auth-split-screen">
      <!-- Left Panel: SVG Tech Character & Cloud Architecture Visual -->
      <div class="auth-panel-visual">
        <div class="auth-visual-top">
          <a href="/" class="app-brand-logo">
            <div class="app-brand-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.3">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
                <line x1="12" y1="14" x2="16" y2="14"></line>
              </svg>
            </div>
            <div class="app-brand-text">
              <span class="brand-name">Supernova POS &amp; ERP OS</span>
              <span class="brand-tag">ENTERPRISE COMMERCE v3.0</span>
            </div>
          </a>
        </div>

        <div class="auth-visual-center">
          <div class="auth-hero-svg-wrap">
            <img
              src="/illustrations/pos-erp-tech-character.svg"
              alt="Supernova POS & ERP Technology Illustration"
              width="600"
              height="500"
              loading="eager"
            />
          </div>
          <h2 class="auth-visual-title">Infrastruktur Kasir &amp; Pembukuan Terpadu</h2>
          <p class="auth-visual-subtitle">
            Terminal kasir barcode kilat, sinkronisasi stok multi-gudang real-time, database member CRM, dan laporan laba rugi otomatis.
          </p>
        </div>

        <div class="auth-visual-footer">
          <span>© 2026 Supernova Labs Studio · Dedicated Cloud SaaS</span>
          <div class="tech-badges-row">
            <span class="tech-badge-pill">● Rust Axum 0.8 ACID</span>
            <span class="tech-badge-pill">● Neon PostgreSQL Serverless</span>
          </div>
        </div>
      </div>

      <!-- Right Panel: Professional Login & Registration Form -->
      <div class="auth-panel-form">
        <div class="auth-form-top-nav">
          <a href="/" class="back-website-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
            <span>Kembali ke Website Utama</span>
          </a>
        </div>

        <div id="authAlertBox" class="auth-alert is-hidden" style="margin: 0 0 16px;"></div>

        <!-- LOGIN FORM CONTAINER -->
        <div id="loginBox">
          <div class="auth-form-header">
            <h1 class="auth-form-title">Masuk ke Terminal POS &amp; ERP</h1>
            <p class="auth-form-desc">Masukkan email atau username bisnis Anda untuk mengakses terminal kasir dan pembukuan.</p>
          </div>

          <form id="formLogin" class="saas-form">
            <div class="saas-form-group">
              <label for="loginEmail">Email / Username Bisnis: <span class="req">*</span></label>
              <div class="saas-input-wrap">
                <input type="text" id="loginEmail" class="saas-input" required placeholder="owner@toko.id atau username..." autocomplete="username" />
              </div>
            </div>

            <div class="saas-form-group">
              <label for="loginPassword">Password: <span class="req">*</span></label>
              <div class="saas-input-wrap">
                <input type="password" id="loginPassword" class="saas-input" required placeholder="••••••••••••" autocomplete="current-password" />
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 13px; color: #475569;">
              <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                <input type="checkbox" id="rememberMe" checked />
                <span>Ingat sesi akun outlet</span>
              </label>
              <a href="#" id="btnForgotPwd" style="color: #2563eb; text-decoration: none; font-weight: 600;">Lupa Password?</a>
            </div>

            <button type="submit" class="btn-app-primary" id="btnSubmitLogin">
              <span>Masuk ke Terminal Kasir &amp; ERP</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>

            <button type="button" class="btn-instant-pill" id="btnQuickDemo">
              ⚡ Masuk Instan (Demo Supernova Retail &amp; Cafe)
            </button>
          </form>

          <div class="auth-bottom-switch">
            Belum punya akun? <a href="#" id="linkToRegister" class="text-blue font-bold">Daftar Disini</a>
          </div>
        </div>

        <!-- REGISTER FORM CONTAINER (TOGGLEABLE) -->
        <div id="registerBox" class="is-hidden">
          <div class="auth-form-header">
            <h1 class="auth-form-title">Daftar Outlet POS &amp; ERP Baru</h1>
            <p class="auth-form-desc">Inisialisasi sistem kasir, katalog inventori, dan buku kas terintegrasi untuk usaha Anda.</p>
          </div>

          <form id="formRegister" class="saas-form">
            <div class="form-row-2col">
              <div class="saas-form-group">
                <label for="regFullName">Nama Lengkap Pemilik: <span class="req">*</span></label>
                <input type="text" id="regFullName" class="saas-input" required placeholder="cth: Rina Andini" />
              </div>
              <div class="saas-form-group">
                <label for="regBizName">Nama Brand / Toko / Kafe: <span class="req">*</span></label>
                <input type="text" id="regBizName" class="saas-input" required placeholder="cth: Karsa Coffee &amp; Retail" />
              </div>
            </div>

            <div class="form-row-2col">
              <div class="saas-form-group">
                <label for="regCategory">Tipe / Model Bisnis: <span class="req">*</span></label>
                <select id="regCategory" class="saas-select">
                  <option value="fnb" selected>Kafe / Resto / F&amp;B Food &amp; Beverage</option>
                  <option value="retail">Toko Kelontong / Swalayan / Minimarket</option>
                  <option value="fashion">Boutique, Fashion &amp; Distro Clothing</option>
                  <option value="pharmacy">Apotek &amp; Toko Obat (Batch Control)</option>
                  <option value="electronics">Toko Gadget &amp; Elektronik (Serial Tracker)</option>
                  <option value="distributor">Grosir &amp; Distributor Multi-Gudang</option>
                </select>
              </div>
              <div class="saas-form-group">
                <label for="regCity">Kota / Lokasi Outlet: <span class="req">*</span></label>
                <input type="text" id="regCity" class="saas-input" required placeholder="cth: Jakarta Selatan / Surabaya" />
              </div>
            </div>

            <div class="saas-form-group">
              <label for="regWhatsApp">Nomor WhatsApp Kasir/Owner: <span class="req">*</span></label>
              <input type="tel" id="regWhatsApp" class="saas-input" required placeholder="cth: 081234567890" />
            </div>

            <div class="form-row-2col">
              <div class="saas-form-group">
                <label for="regEmail">Email Resmi Bisnis: <span class="req">*</span></label>
                <input type="email" id="regEmail" class="saas-input" required placeholder="owner@tokokarsa.id" autocomplete="email" />
              </div>
              <div class="saas-form-group">
                <label for="regPassword">Password: <span class="req">*</span></label>
                <input type="password" id="regPassword" class="saas-input" required minlength="6" placeholder="Minimal 6 karakter" autocomplete="new-password" />
              </div>
            </div>

            <button type="submit" class="btn-app-primary" id="btnSubmitRegister">
              <span>Daftarkan Outlet &amp; Buka Kasir</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
          </form>

          <div class="auth-bottom-switch">
            Sudah punya akun? <a href="#" id="linkToLogin" class="text-blue font-bold">Masuk Disini</a>
          </div>
        </div>
      </div>
    </div>

    <!-- ====================================================================== -->
    <!-- 2. FULL SAAS APPLICATION WORKSPACE (SIDEBAR & ANTI-MAINSTREAM CARDS)  -->
    <!-- ====================================================================== -->
    <div id="appDashboard" class="app-workspace is-hidden">
      <!-- 1. LEFT VERTICAL SIDEBAR DOCK (MATCHING IMAGE 2) -->
      <aside class="app-sidebar">
        <div class="sidebar-top">
          <div class="sidebar-brand-mark" title="Supernova POS & ERP Core OS">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.3">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <line x1="2" y1="10" x2="22" y2="10"></line>
              <line x1="12" y1="14" x2="16" y2="14"></line>
            </svg>
          </div>
        </div>

        <!-- Vertical Icon Nav with Floating Tooltips -->
        <nav class="sidebar-nav">
          <button type="button" class="sidebar-nav-item is-active" data-tab="pos" title="Terminal Kasir POS">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
            <span class="nav-tooltip">Kasir POS</span>
          </button>

          <button type="button" class="sidebar-nav-item" data-tab="inventory" title="Inventori Stok ERP">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
            <span class="nav-tooltip">Inventori ERP</span>
          </button>

          <button type="button" class="sidebar-nav-item" data-tab="crm" title="Member & CRM Pelanggan">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <span class="nav-tooltip">CRM Member</span>
          </button>

          <button type="button" class="sidebar-nav-item" data-tab="finance" title="Laporan Kas & Laba Rugi">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
            <span class="nav-tooltip">Buku Kas &amp; PnL</span>
          </button>

          <button type="button" class="sidebar-nav-item" data-tab="products" title="Kelola Master Produk">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            <span class="nav-tooltip">Master Produk</span>
          </button>

          <button type="button" class="sidebar-nav-item" data-tab="public-store" title="Katalog Toko Online Publik">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span class="nav-tooltip">Katalog Online</span>
          </button>
        </nav>

        <!-- Sidebar Bottom: Avatar / Quick Logout -->
        <div class="sidebar-bottom">
          <button type="button" class="sidebar-avatar-btn" id="btnSidebarAvatar" title="Profil Akun & Keluar">
            <span class="avatar-circle">KS</span>
          </button>
        </div>
      </aside>

      <!-- 2. MAIN BODY AREA (LIGHT & PROFESSIONAL) -->
      <div class="app-main-body">
        <!-- Integrated Light Top Shelf Header (Matching Image 2) -->
        <header class="app-top-shelf">
          <div class="shelf-left">
            <div class="shelf-welcome">
              <h1 class="welcome-title">
                <span>Selamat Datang, </span><span id="headerBizName">Supernova Store &amp; Cafe</span>
              </h1>
              <div class="welcome-meta">
                <span id="currentDateLabel">Rabu, 21 Oktober 2026</span>
                <span class="meta-dot">·</span>
                <span class="meta-code-pill" title="Kode Identitas Outlet">OUTLET: <strong id="headerTenantCode">#SNV-5182-POS</strong></span>
                <span class="meta-dot">·</span>
                <span class="meta-city" id="headerBizCity">Jakarta Selatan</span>
              </div>
            </div>
          </div>

          <div class="shelf-right">
            <!-- Direct Customer Online Store Pill -->
            <a href="/layanan/pos-erp/supernova-store" target="_blank" rel="noopener" class="top-slug-link" id="headerPublicLinkPill" title="Buka Halaman Katalog Toko Online untuk Pelanggan (Bebas Login)">
              <span>🌐 /layanan/pos-erp/</span><strong id="headerSlugText">supernova-store</strong>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>

            <button type="button" class="btn-shelf-action" id="btnHeaderShareLink" title="Salin tautan katalog online untuk WhatsApp & Instagram">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Salin Link</span>
            </button>

            <button type="button" class="btn-shelf-primary" id="btnHeaderQuickPos">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              <span>+ Kasir Baru</span>
            </button>

            <button type="button" class="btn-shelf-ghost" id="btnHeaderLogout" title="Keluar dari akun bisnis">
              Keluar
            </button>

            <a href="/" class="btn-shelf-ghost" style="text-decoration: none;" title="Kembali ke landing page">
              ← Web Utama
            </a>
          </div>
        </header>

        <!-- Main Content Canvas -->
        <main class="app-canvas-container">
          <!-- Category Filter Pills (Like Image 2) -->
          <div class="shelf-category-pills">
            <button type="button" class="cat-pill is-active" data-cat="all">Semua Produk</button>
            <button type="button" class="cat-pill" data-cat="coffee">☕ Kopi &amp; Espresso</button>
            <button type="button" class="cat-pill" data-cat="beverage">🥤 Non-Kopi &amp; Tea</button>
            <button type="button" class="cat-pill" data-cat="food">🍔 Makanan &amp; Pastry</button>
            <button type="button" class="cat-pill" data-cat="retail">🛒 Retail &amp; Merchandise</button>
          </div>

          <!-- 4 ANTI-MAINSTREAM STAT CARDS (EXACT COMPOSITION AS IMAGE 2) -->
          <section class="anti-cards-grid">
            <!-- CARD 1: HERO VIBRANT BLUE CARD (Sales Today Style) -->
            <div class="anti-card anti-card--hero">
              <div class="anti-card-top">
                <span class="anti-card-title">Penjualan Kasir Hari Ini</span>
                <div class="anti-hero-badge">
                  <span>↑ +14.8%</span>
                </div>
              </div>
              <div class="anti-card-value" id="mTotalRevenue">Rp 4.850.000</div>
              <div class="anti-card-sub">Omset kasir terkonfirmasi masuk kas</div>
              <div class="anti-card-watermark">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                  <line x1="8" y1="21" x2="16" y2="21"></line>
                  <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
              </div>
            </div>

            <!-- CARD 2: WHITE MINIMALIST ORDERS CARD -->
            <div class="anti-card">
              <div class="anti-card-top">
                <span class="anti-card-title">Total Transaksi Kasir</span>
                <div class="anti-pill-badge anti-pill-badge--green">
                  <span>+6.2%</span>
                </div>
              </div>
              <div class="anti-card-value text-dark" id="mTotalCount">32 Pesanan</div>
              <div class="anti-card-sub">Tersinkron cloud Neon PostgreSQL</div>
            </div>

            <!-- CARD 3: WHITE MINIMALIST GROSS PROFIT CARD -->
            <div class="anti-card">
              <div class="anti-card-top">
                <span class="anti-card-title">Estimasi Margin Laba</span>
                <div class="anti-pill-badge anti-pill-badge--blue">
                  <span>Sehat 38%</span>
                </div>
              </div>
              <div class="anti-card-value text-dark" id="mGrossProfit">Rp 1.843.000</div>
              <div class="anti-card-sub">Gross margin dikurangi HPP (COGS)</div>
            </div>

            <!-- CARD 4: WHITE MINIMALIST LOW STOCK ALERT CARD -->
            <div class="anti-card">
              <div class="anti-card-top">
                <span class="anti-card-title">Peringatan Stok Kritis</span>
                <div class="anti-pill-badge anti-pill-badge--purple" style="background: #fff1f2; color: #e11d48; border-color: #fecdd3;">
                  <span>Perlu Reorder</span>
                </div>
              </div>
              <div class="anti-card-value text-dark" id="mLowStockAlert">3 SKU</div>
              <div class="anti-card-sub">Segera lakukan purchase order (PO)</div>
            </div>
          </section>

          <!-- ================================================================ -->
          <!-- TAB 1: TERMINAL KASIR POS MODERN (SPLIT LAYOUT)                  -->
          <!-- ================================================================ -->
          <div id="tabContentPos" class="tab-pane-content is-active">
            <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px; align-items: flex-start;">
              <!-- Left: Product Catalog Grid -->
              <div class="app-panel-card" style="margin-bottom: 0;">
                <div class="panel-card-header">
                  <div class="panel-card-title">
                    <h3>Katalog Kasir &amp; Barcode Scanner</h3>
                    <p>Klik produk untuk menambahkan ke keranjang belanja kasir.</p>
                  </div>
                  <div class="toolbar-right">
                    <input type="text" class="saas-input" style="width: 220px; padding: 7px 12px; font-size: 13px;" id="searchPosProduct" placeholder="🔍 Cari nama atau SKU..." />
                  </div>
                </div>

                <div class="pos-product-grid" id="posProductGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 14px;">
                  <!-- Populated dynamically -->
                </div>
              </div>

              <!-- Right: POS Cart Terminal Sticky Panel -->
              <div class="app-panel-card" style="position: sticky; top: 20px; margin-bottom: 0;">
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1.5px solid #e2e8f0; padding-bottom: 14px; margin-bottom: 16px;">
                  <h3 style="margin: 0; font-size: 17px; font-weight: 800;">Keranjang Transaksi</h3>
                  <button type="button" class="btn-instant-pill" id="btnClearCart" style="padding: 4px 10px; font-size: 11px; color: #ef4444;">Kosongkan</button>
                </div>

                <!-- Customer Member Selector -->
                <div style="margin-bottom: 14px;">
                  <label style="font-size: 12px; font-weight: 700; color: #475569; display: block; margin-bottom: 4px;">Pilih Pelanggan / Member:</label>
                  <select id="posCustomerSelect" class="saas-select" style="padding: 8px 12px; font-size: 13px;">
                    <option value="walk_in">Pelanggan Umum (Tanpa Member)</option>
                    <option value="c-1">Dimas Aditya (VIP Gold · Diskon 10%)</option>
                    <option value="c-2">Siti Rahma (Silver · Diskon 5%)</option>
                  </select>
                </div>

                <!-- Cart Items List -->
                <div id="posCartItemsList" style="max-height: 280px; overflow-y: auto; margin-bottom: 16px; border-bottom: 1px dashed #e2e8f0; padding-bottom: 12px;">
                  <div style="text-align: center; color: #94a3b8; font-size: 13px; padding: 24px 0;">
                    Keranjang masih kosong.<br>Klik produk di sebelah kiri untuk transaksi.
                  </div>
                </div>

                <!-- Cost Breakdown -->
                <div style="font-size: 13px; color: #475569; display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px;">
                  <div style="display: flex; justify-content: space-between;">
                    <span>Subtotal:</span>
                    <strong id="posSubtotal" style="color: #0f172a;">Rp 0</strong>
                  </div>
                  <div style="display: flex; justify-content: space-between; color: #059669;">
                    <span>Diskon Member:</span>
                    <strong id="posDiscount">Rp 0</strong>
                  </div>
                  <div style="display: flex; justify-content: space-between;">
                    <span>PPN (11%):</span>
                    <strong id="posTax" style="color: #0f172a;">Rp 0</strong>
                  </div>
                  <div style="display: flex; justify-content: space-between; border-top: 1.5px solid #e2e8f0; padding-top: 8px; font-size: 18px; font-weight: 800; color: #0f172a;">
                    <span>Total Tagihan:</span>
                    <span id="posGrandTotal" style="color: #2563eb;">Rp 0</span>
                  </div>
                </div>

                <!-- Payment Channel -->
                <div style="margin-bottom: 16px;">
