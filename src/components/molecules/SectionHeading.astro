---
interface Props { eyebrow: string; title: string; description?: string; align?: 'left' | 'center'; }
const { eyebrow, title, description, align = 'left' } = Astro.props;
---
<div class={`section-heading section-heading--${align}`} data-reveal="up">
  <p class="eyebrow"><span class="eyebrow__line"></span>{eyebrow}</p>
  <h2>{title}</h2>
  {description && <p class="section-heading__desc">{description}</p>}
</div>
