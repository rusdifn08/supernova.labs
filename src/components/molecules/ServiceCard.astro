---
import Icon from '../atoms/Icon.astro';
interface Props { number: string; title: string; description: string; items: string[]; tech: string; icon?: string; }
const { number, title, description, items, tech, icon = 'layers' } = Astro.props;
---
<article class="service-card" data-reveal="up">
  <div class="service-card__accent"></div>
  <div class="service-card__top">
    <span class="service-card__icon"><Icon name={icon as any} size={20} /></span>
    <span class="service-card__number">STEP {number}</span>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <ul>{items.map((item) => <li><Icon name="check" size={14} />{item}</li>)}</ul>
  <div class="service-card__tech"><span>Stack</span><strong>{tech}</strong></div>
</article>
