---
import Icon from '../../atoms/Icon.astro';
---

<div
  class="sim-panel is-active"
  id="panel-booking"
  role="tabpanel"
  aria-labelledby="tab-booking"
  data-demo-panel="booking"
>
  <!-- Simulation Header Bar -->
  <div class="sim-topbar">
    <div class="sim-title-group">
      <span class="sim-eyebrow">Simulasi Alur · Online Booking Engine</span>
      <span class="sim-live-badge"><span class="sim-live-pulse"></span> Auto Simulasi</span>
    </div>

    <!-- Interactive Step Buttons -->
    <div class="sim-step-pills" data-sim-stepper="booking">
      <button type="button" class="sim-step-pill is-active" data-step="1">
        <span class="sim-step-pill__num">1</span>
        <span>Pilih Jadwal</span>
      </button>
      <button type="button" class="sim-step-pill" data-step="2">
        <span class="sim-step-pill__num">2</span>
        <span>Anti-Bentrok &amp; DP</span>
      </button>
      <button type="button" class="sim-step-pill" data-step="3">
        <span class="sim-step-pill__num">3</span>
        <span>E-Ticket WA</span>
      </button>
    </div>
  </div>

  <!-- 2-Column Compact Sandbox -->
  <div class="sim-grid">
    <!-- Left Column: Context & Metrics -->
    <div class="sim-sidebar">
      <!-- Business Selector Chips -->
      <div class="sim-chips" id="bookingBizChips">
        <button type="button" class="sim-chip is-active" data-biz="futsal">⚽ Futsal / Olahraga</button>
        <button type="button" class="sim-chip" data-biz="studio">📸 Studio Foto</button>
        <button type="button" class="sim-chip" data-biz="barber">✂️ Barbershop</button>
        <button type="button" class="sim-chip" data-biz="ps">🎮 Rental PS &amp; Warnet</button>
      </div>

      <!-- Active Step Info Card -->
      <div class="sim-workflow-card">
        <div class="sim-step-info-title" id="bookingStepTitle">
          <Icon name="check" size={14} />
          <span>1. Deteksi Ketersediaan &amp; Validasi Otomatis</span>
        </div>
        <p class="sim-step-info-desc" id="bookingStepDesc">
          Pelanggan memilih waktu sewa. Sistem langsung mengecek database cloud dalam milidetik guna mencegah jadwal tumpang tindih (*collision detection*).
        </p>
      </div>

      <!-- Realtime Metrics -->
      <div class="sim-metrics-box">
        <div class="sim-metric-row">
          <span class="sim-metric-label">Kecepatan Validasi</span>
          <span class="sim-metric-val text-blue">24ms (Neon Cloud)</span>
        </div>
        <div class="sim-metric-row">
          <span class="sim-metric-label">Status Ketersediaan</span>
          <span class="sim-metric-val text-success" id="bookingMetricStatus">Slot Aman (0 Bentrok)</span>
        </div>
        <div class="sim-metric-row">
          <span class="sim-metric-label">Dispatch Notifikasi</span>
          <span class="sim-metric-val">WhatsApp e-Ticket</span>
        </div>
      </div>

      <!-- Link to real system -->
      <div class="sim-cta-row">
        <span class="text-xs text-slate-500">Butuh untuk bisnis riil Anda?</span>
        <a href="/layanan/booking" class="sim-cta-link">
          <span>Buka Aplikasi Penuh (30 Hari Aktif)</span>
          <Icon name="arrow" size={12} />
        </a>
      </div>
    </div>

    <!-- Right Column: Animated Simulation Stage -->
    <div class="sim-stage" id="bookingSimStage">
      <!-- Stage Top Bar -->
      <div class="stage-bar" style="position: absolute; top: 12px; left: 14px; right: 14px;">
        <span>BOOKING ENGINE // REALTIME COLLISION MONITOR</span>
        <span class="stage-badge-neon">SYNC 60FPS</span>
      </div>

      <!-- SCENE 1: Slot Picking & Anti-Collision Check -->
      <div class="sim-scene is-active" data-sim-scene="booking-1" style="padding-top: 32px;">
        <div class="stage-card">
          <div class="flex items-center justify-between text-xs font-semibold text-slate-700 mb-2">
            <span id="bookingSimFacility">Lapangan 1 (Vinyl Pro)</span>
            <span class="text-[11px] text-blue font-mono">Tarif: Rp 150.000/jam</span>
          </div>
          <div class="stage-slot-grid">
            <div class="stage-slot is-booked">
              <span class="font-bold">17:00 - 18:00</span>
              <span class="text-[9.5px]">● Terisi (Doni P.)</span>
            </div>
            <div class="stage-slot is-booked">
              <span class="font-bold">18:00 - 19:00</span>
              <span class="text-[9.5px]">● Terisi (FC United)</span>
            </div>
            <div class="stage-slot is-selected">
              <span class="font-bold text-blue">19:00 - 21:00</span>
              <span class="text-[9.5px] text-blue font-semibold">✓ Dipilih (2 Jam)</span>
            </div>
            <div class="stage-slot">
              <span class="font-bold">21:00 - 22:00</span>
              <span class="text-[9.5px] text-emerald-600">Bebas</span>
            </div>
          </div>
        </div>

        <div class="stage-verified-pill mt-3">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span class="text-xs">Database Cloud Neon: <strong>0 Bentrok</strong>. Slot diamankan seketika.</span>
        </div>
      </div>

      <!-- SCENE 2: Down Payment Lock & Calculation -->
      <div class="sim-scene" data-sim-scene="booking-2" style="padding-top: 32px;">
        <div class="stage-card">
          <div class="flex items-center justify-between text-xs font-semibold text-slate-700 pb-2 border-b border-slate-100">
            <span>Rincian Pembayaran Down-Payment</span>
            <span class="text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded font-mono text-[10px]">DP Otomatis</span>
          </div>
          <div class="grid grid-cols-2 gap-2 my-2 text-xs">
            <div class="p-2 rounded bg-slate-50 border border-slate-100">
              <span class="text-[10px] text-slate-500 block">Total Sewa (2 Jam)</span>
              <strong class="text-slate-800 text-sm font-mono" id="bookingSimTotal">Rp 300.000</strong>
            </div>
            <div class="p-2 rounded bg-blue-50 border border-blue-100">
              <span class="text-[10px] text-blue block">Wajib DP Sekarang (50%)</span>
              <strong class="text-blue text-sm font-mono" id="bookingSimDp">Rp 150.000</strong>
            </div>
          </div>
          <div class="text-[11px] text-slate-500 flex items-center justify-between">
            <span>Sisa dibayar di kasir saat main:</span>
            <span class="font-mono font-semibold" id="bookingSimRemaining">Rp 150.000</span>
          </div>
        </div>

        <div class="stage-verified-pill mt-3 bg-amber-50 border-amber-200 text-amber-800">
          <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span class="text-xs">Lock Gateway: Jadwal dikunci 15 menit sampai DP terkonfirmasi.</span>
        </div>
      </div>

      <!-- SCENE 3: E-Ticket WhatsApp Dispatch -->
      <div class="sim-scene" data-sim-scene="booking-3" style="padding-top: 32px;">
        <div class="stage-card">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100">
            <div>
              <span class="text-[10px] font-mono text-slate-400 block">E-TICKET RESMI // SUPERNOVA</span>
              <strong class="text-xs text-slate-900" id="bookingSimPassCode">BK-FTS-99421</strong>
            </div>
            <div class="w-7 h-7 bg-slate-900 rounded flex items-center justify-center text-white text-[9px] font-mono">
              QR
            </div>
          </div>
          <div class="py-2 text-[11px] text-slate-600 grid grid-cols-2 gap-1">
            <div>Pemesan: <strong class="text-slate-900">Rian Hidayat</strong></div>
            <div>Jadwal: <strong class="text-slate-900">19:00 - 21:00</strong></div>
          </div>
        </div>

        <!-- Pop-in WhatsApp Toast -->
        <div class="stage-wa-toast mt-2">
          <div class="w-6 h-6 rounded-full bg-[#25D366] text-white flex items-center justify-center shrink-0">
            <Icon name="whatsapp" size={13} />
          </div>
          <div class="stage-wa-text">
            <strong class="text-slate-900 font-semibold block text-[11px]">Notifikasi WhatsApp Otomatis:</strong>
            <span class="text-slate-600">"Halo Kak Rian, E-Ticket &amp; Barcode Reservasi Anda sudah aktif. Sampai jumpa di lapangan!"</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
