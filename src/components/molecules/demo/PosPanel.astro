---
import Icon from '../../atoms/Icon.astro';
---

<div
  class="sim-panel"
  id="panel-pos"
  role="tabpanel"
  aria-labelledby="tab-pos"
  data-demo-panel="pos"
>
  <!-- Simulation Header Bar -->
  <div class="sim-topbar">
    <div class="sim-title-group">
      <span class="sim-eyebrow">Simulasi Alur · POS Cashier &amp; Mini-ERP</span>
      <span class="sim-live-badge"><span class="sim-live-pulse"></span> Auto Simulasi</span>
    </div>

    <!-- Interactive Step Buttons -->
    <div class="sim-step-pills" data-sim-stepper="pos">
      <button type="button" class="sim-step-pill is-active" data-step="1">
        <span class="sim-step-pill__num">1</span>
        <span>Tap &amp; Barcode</span>
      </button>
      <button type="button" class="sim-step-pill" data-step="2">
        <span class="sim-step-pill__num">2</span>
        <span>Bayar QRIS / Cash</span>
      </button>
      <button type="button" class="sim-step-pill" data-step="3">
        <span class="sim-step-pill__num">3</span>
        <span>Struk &amp; Stok ERP</span>
      </button>
    </div>
  </div>

  <!-- 2-Column Compact Sandbox -->
  <div class="sim-grid">
    <!-- Left Column: Context & Metrics -->
    <div class="sim-sidebar">
      <!-- Store Location Chips -->
      <div class="sim-chips" id="posLocationChips">
        <button type="button" class="sim-chip is-active" data-loc="scbd">🏢 SCBD Jakarta</button>
        <button type="button" class="sim-chip" data-loc="bandung">🏬 Bandung Hub</button>
        <button type="button" class="sim-chip" data-loc="surabaya">🏪 Surabaya Store</button>
      </div>

      <!-- Active Step Info Card -->
      <div class="sim-workflow-card">
        <div class="sim-step-info-title" id="posStepTitle">
          <Icon name="check" size={14} />
          <span>1. Input Kasir Super Cepat</span>
        </div>
        <p class="sim-step-info-desc" id="posStepDesc">
          Kasir men-tap produk menu atau scan barcode fisik. Item langsung terhitung di keranjang belanja dengan kalkulasi promo otomatis.
        </p>
      </div>

      <!-- Realtime Metrics -->
      <div class="sim-metrics-box">
        <div class="sim-metric-row">
          <span class="sim-metric-label">Kecepatan Checkout</span>
          <span class="sim-metric-val text-blue">&lt; 3 Detik / Transaksi</span>
        </div>
        <div class="sim-metric-row">
          <span class="sim-metric-label">Potong Stok Gudang</span>
          <span class="sim-metric-val text-success" id="posMetricSync">Otomatis Realtime</span>
        </div>
        <div class="sim-metric-row">
          <span class="sim-metric-label">Update Laporan ERP</span>
          <span class="sim-metric-val">Laba / Rugi Instan</span>
        </div>
      </div>

      <!-- Link to real system -->
      <div class="sim-cta-row">
        <span class="text-xs text-slate-500">Butuh untuk bisnis riil Anda?</span>
        <a href="/layanan/pos-erp" class="sim-cta-link">
          <span>Buka Aplikasi Penuh (30 Hari Aktif)</span>
          <Icon name="arrow" size={12} />
        </a>
      </div>
    </div>

    <!-- Right Column: Animated Simulation Stage -->
    <div class="sim-stage" id="posSimStage">
      <!-- Stage Top Bar -->
      <div class="stage-bar" style="position: absolute; top: 12px; left: 14px; right: 14px;">
        <span>POS KASIR // MULTI-OUTLET CLOUD SYNC</span>
        <span class="stage-badge-neon" id="posStageLocBadge">OUTLET SCBD</span>
      </div>

      <!-- SCENE 1: Tap Product & Cart Subtotal -->
      <div class="sim-scene is-active" data-sim-scene="pos-1" style="padding-top: 32px;">
        <div class="stage-card">
          <div class="flex items-center justify-between text-xs font-semibold text-slate-700 mb-2">
            <span>Terminal Kasir Cepat</span>
            <span class="text-[10px] text-blue font-mono">Shift: Kasir Rina</span>
          </div>
          <div class="pos-sim-products">
            <div class="pos-sim-prod is-tapped">
              <span>☕ Espresso Double</span>
              <strong class="text-blue font-mono">Rp 28k</strong>
            </div>
            <div class="pos-sim-prod is-tapped">
              <span>🥐 Artisan Croissant</span>
              <strong class="text-blue font-mono">Rp 32k</strong>
            </div>
          </div>
          <div class="mt-2.5 pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-slate-500">Total (2 Item):</span>
            <strong class="text-slate-900 text-sm font-mono" id="posSimSubtotal">Rp 60.000</strong>
          </div>
        </div>

        <div class="stage-verified-pill mt-3">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-xs">Barcode / Tombol kasir terdeteksi. Keranjang siap dibayar.</span>
        </div>
      </div>

      <!-- SCENE 2: Instant Payment (QRIS / Cash) -->
      <div class="sim-scene" data-sim-scene="pos-2" style="padding-top: 32px;">
        <div class="stage-card">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100 text-xs">
            <span class="font-semibold text-slate-700">Pembayaran QRIS Statis / Dinamis</span>
            <span class="text-[10px] bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded font-mono">Zero Fee</span>
          </div>
          <div class="py-2.5 flex items-center gap-3">
            <div class="w-12 h-12 bg-slate-900 rounded-lg flex items-center justify-center text-white text-[10px] font-mono shrink-0">
              QRIS
            </div>
            <div>
              <span class="text-[11px] text-slate-500 block">Nominal Tertera:</span>
              <strong class="text-base text-slate-900 font-mono">Rp 60.000</strong>
              <span class="text-[10px] text-emerald-600 block font-semibold">● Menunggu Scan Pelanggan</span>
            </div>
          </div>
        </div>

        <div class="stage-verified-pill mt-3">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-xs">Sistem mendeteksi dana masuk. Verifikasi otomatis dalam 1 detik.</span>
        </div>
      </div>

      <!-- SCENE 3: Thermal Receipt & Auto Stock Reduction -->
      <div class="sim-scene" data-sim-scene="pos-3" style="padding-top: 32px;">
        <div class="stage-card">
          <div class="flex items-center justify-between text-xs pb-1 border-b border-slate-100">
            <span class="font-mono text-slate-500">STRUK THERMAL // INV/POS-882</span>
            <span class="text-emerald-600 font-bold text-[10px]">LUNAS</span>
          </div>
          <div class="py-1 text-[11px] text-slate-600 flex justify-between">
            <span>2 Menu Terjual</span>
            <strong class="text-slate-900 font-mono">Rp 60.000</strong>
          </div>
          <div class="mt-1 pt-1.5 border-t border-dashed border-slate-200 text-[10px] text-slate-500 flex justify-between">
            <span>Metode: QRIS Settlement</span>
            <span class="text-blue font-semibold">Kirim WhatsApp ✓</span>
          </div>
        </div>

        <!-- Mini ERP sync pill -->
        <div class="stage-wa-toast mt-2 bg-slate-900 text-white border-slate-700 border-l-4 border-l-blue-500">
          <div class="stage-wa-text text-slate-200">
            <strong class="text-white font-semibold block text-[11px]">Sinkronisasi Multi-Gudang ERP Berhasil:</strong>
            <span class="text-slate-300">Stok Kopi &amp; Roti otomatis berkurang (-2). Laba bersih transaksi: +Rp 37.200 dicatat ke buku besar.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
