---
import SectionHeading from '../molecules/SectionHeading.astro';
import Icon from '../atoms/Icon.astro';
---
<section class="section section--estimator" id="estimator">
  <div class="container">
    <div class="estimator-header">
      <SectionHeading
        eyebrow="Interactive Tool / Estimasi Proyek"
        title="Simulasikan Kebutuhan & Estimasi Proyek Anda."
        description="Pilih platform, skala sistem, dan modul fitur yang Anda butuhkan untuk melihat estimasi timeline dan rekomendasi arsitektur secara instan."
        align="center"
      />
    </div>

    <div class="estimator-box" data-estimator data-reveal="up">
      <div class="estimator-grid">
        <!-- Configuration Controls -->
        <div class="estimator-controls">
          <!-- Step 1: Platform Selection -->
          <div class="estimator-group">
            <span class="estimator-label">
              <span class="estimator-step-num">1</span>
              <span>PILIH PLATFORM TARGET</span>
            </span>
            <div class="platform-options" role="radiogroup" aria-label="Pilihan Platform">
              <button type="button" class="option-card is-active" data-platform="web" data-weeks="4">
                <span class="option-card__icon"><Icon name="globe" size={20} /></span>
                <span class="option-card__info">
                  <strong>Web Ecosystem</strong>
                  <small>Company Profile, SaaS Dashboard, PWA</small>
                </span>
                <span class="option-card__check"><Icon name="check" size={14} /></span>
              </button>

              <button type="button" class="option-card" data-platform="mobile" data-weeks="5">
                <span class="option-card__icon"><Icon name="mobile" size={20} /></span>
                <span class="option-card__info">
                  <strong>Mobile Apps (iOS &amp; Android)</strong>
                  <small>Flutter / React Native Cross-Platform</small>
                </span>
                <span class="option-card__check"><Icon name="check" size={14} /></span>
              </button>

              <button type="button" class="option-card" data-platform="desktop" data-weeks="5">
                <span class="option-card__icon"><Icon name="desktop" size={20} /></span>
                <span class="option-card__info">
                  <strong>Desktop System</strong>
                  <small>Tauri / Electron, POS, Offline-First ERP</small>
                </span>
                <span class="option-card__check"><Icon name="check" size={14} /></span>
              </button>

              <button type="button" class="option-card" data-platform="all" data-weeks="8">
                <span class="option-card__icon"><Icon name="layers" size={20} /></span>
                <span class="option-card__info">
                  <strong>All-in-One Multiplatform Suite</strong>
                  <small>Web + Mobile + Desktop terintegrasi 1 Core</small>
                </span>
                <span class="option-card__check"><Icon name="check" size={14} /></span>
              </button>
            </div>
          </div>

          <!-- Step 2: System Scale -->
          <div class="estimator-group">
            <span class="estimator-label">
              <span class="estimator-step-num">2</span>
              <span>SKALA SISTEM</span>
            </span>
            <div class="scale-options">
              <button type="button" class="scale-btn is-active" data-scale="mvp" data-multiplier="1">
                <strong>MVP / Peluncuran Cepat</strong>
                <small>Fokus fitur utama untuk validasi pasar</small>
              </button>
              <button type="button" class="scale-btn" data-scale="growth" data-multiplier="1.3">
                <strong>Growth Business</strong>
                <small>Operasional harian &amp; otomatisasi tim</small>
              </button>
              <button type="button" class="scale-btn" data-scale="enterprise" data-multiplier="1.7">
                <strong>Enterprise Mission-Critical</strong>
                <small>Keamanan tinggi, audit log, &amp; multi-branch</small>
              </button>
            </div>
          </div>

          <!-- Step 3: Key Modules -->
          <div class="estimator-group">
            <span class="estimator-label">
              <span class="estimator-step-num">3</span>
              <span>MODUL &amp; FITUR TAMBAHAN</span>
            </span>
            <div class="feature-pills">
              <label class="feature-pill is-checked">
                <input type="checkbox" name="feature" value="Auth & Role Permission" checked data-add-days="4" />
                <span class="feature-pill__box"><Icon name="check" size={12} /></span>
                <span>Role-Based Access &amp; Auth</span>
              </label>

              <label class="feature-pill is-checked">
                <input type="checkbox" name="feature" value="Payment Gateway & Invoicing" checked data-add-days="5" />
                <span class="feature-pill__box"><Icon name="check" size={12} /></span>
                <span>Payment Gateway &amp; Invoicing</span>
              </label>

              <label class="feature-pill">
                <input type="checkbox" name="feature" value="Realtime Chat / WebSockets" data-add-days="5" />
                <span class="feature-pill__box"><Icon name="check" size={12} /></span>
                <span>Realtime Sync / WebSockets</span>
              </label>

              <label class="feature-pill">
                <input type="checkbox" name="feature" value="Offline-First Database Sync" data-add-days="6" />
                <span class="feature-pill__box"><Icon name="check" size={12} /></span>
                <span>Offline-First SQLite Cache</span>
              </label>

              <label class="feature-pill">
                <input type="checkbox" name="feature" value="Custom Reporting & Export Excel" data-add-days="4" />
                <span class="feature-pill__box"><Icon name="check" size={12} /></span>
                <span>Reporting &amp; Data Export</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Live Estimate Summary Card -->
        <div class="estimator-summary">
          <div class="summary-card">
            <div class="summary-card__top">
              <span class="summary-badge">HASIL SIMULASI ESTIMASI</span>
              <div class="summary-status">
                <span class="pulse-dot"></span>
                <span>Siap Didiskusikan</span>
              </div>
            </div>

            <div class="summary-metric">
              <span class="summary-metric__label">Estimasi Timeline Rilis</span>
              <div class="summary-metric__val">
                <span data-summary-timeline>4 - 6</span>
                <small>Minggu</small>
              </div>
              <span class="summary-metric__sub">Termasuk 1-2 Minggu Requirement &amp; Figma Prototype</span>
            </div>

            <div class="summary-breakdown">
              <div class="summary-row">
                <span>Platform Terpilih</span>
                <strong data-summary-platform>Web Ecosystem</strong>
              </div>
              <div class="summary-row">
                <span>Skala Sistem</span>
                <strong data-summary-scale>MVP / Peluncuran Cepat</strong>
              </div>
              <div class="summary-row">
                <span>Modul Fitur</span>
                <strong data-summary-features>2 Modul</strong>
              </div>
              <div class="summary-row">
                <span>Rekomendasi Stack</span>
                <strong data-summary-stack>Astro · React · PostgreSQL</strong>
              </div>
            </div>

            <div class="summary-guarantee">
              <div class="guarantee-item">
                <Icon name="check" size={13} />
                <span>100% Hak Milik Source Code &amp; Repositori</span>
              </div>
              <div class="guarantee-item">
                <Icon name="check" size={13} />
                <span>Akses Staging Environment Mingguan</span>
              </div>
              <div class="guarantee-item">
                <Icon name="check" size={13} />
                <span>Garansi Bug Pasca-Peluncuran</span>
              </div>
            </div>

            <a
              class="btn btn--cta btn--lg summary-btn"
              href="https://wa.me/6285174289548"
              target="_blank"
              rel="noopener noreferrer"
              data-estimator-cta
            >
              <span>Konsultasikan Estimasi Ini (WA)</span>
              <span class="btn__icon"><Icon name="whatsapp" size={18} /></span>
            </a>
            
            <p class="summary-note">
              *Estimasi awal untuk panduan scope. Detail final dikunci dalam sesi requirement engineering gratis bersama Lead Architect kami.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { initEstimator } from '../../scripts/landing/estimator';
    initEstimator();
  </script>
</section>