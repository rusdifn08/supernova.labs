---
import SectionHeading from '../molecules/SectionHeading.astro';
import ServiceCard from '../molecules/ServiceCard.astro';
import Icon from '../atoms/Icon.astro';
const services = [
  { number: '01', icon: 'globe', title: 'Website', description: 'Website cepat & SEO-ready yang mengubah pengunjung jadi pelanggan.', items: ['Company profile & landing page', 'Web app dan dashboard SaaS', 'E-commerce dan portal pelanggan'], tech: 'Astro · React · Node.js' },
  { number: '02', icon: 'mobile', title: 'Mobile Apps', description: 'Aplikasi iOS & Android yang stabil dan terhubung ke sistem bisnis.', items: ['Aplikasi customer & membership', 'Order, delivery, dan field operation', 'Integrasi payment dan notifikasi'], tech: 'Flutter · React Native · PostgreSQL' },
  { number: '03', icon: 'desktop', title: 'Desktop Apps', description: 'Aplikasi desktop berperforma tinggi untuk operasional harian.', items: ['POS dan inventory offline-first', 'Aplikasi internal perusahaan', 'Tools produktivitas dan automation'], tech: 'Tauri · Electron · Go' }
];
---
<section class="section section--blue" id="layanan">
  <div class="container">
    <div class="section-intro"><SectionHeading eyebrow="02 / Core services" title="Every platform. One technology partner." description="Website, mobile, dan desktop — dikerjakan satu tim dalam alur yang terintegrasi." /></div>
    <div class="services-grid" data-stagger>
      {services.map((service) => <ServiceCard {...service} />)}
    </div>
    <div class="services-trust" data-reveal="up">
      <span class="services-trust__lead">Termasuk standar</span>
      <ul class="services-trust__list">
        <li><Icon name="target" size={14} /> Estimasi transparan</li>
        <li><Icon name="bolt" size={14} /> Sprint mingguan</li>
        <li><Icon name="code" size={14} /> Source code Anda</li>
        <li><Icon name="shield" size={14} /> Garansi pasca-launch</li>
      </ul>
    </div>
  </div>
</section>
