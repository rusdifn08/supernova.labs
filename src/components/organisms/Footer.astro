---
import { contact } from '../../config/contact';
import { navigation } from '../../config/navigation';
import { site } from '../../config/site';
import Icon from '../atoms/Icon.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="wordmark wordmark--footer" href="/" aria-label="Supernova Labs Studio Beranda">
          <span class="wordmark__mark" aria-hidden="true">
            <svg width="30" height="30" viewBox="0 0 40 40" fill="none">
              <rect width="40" height="40" rx="8" fill="#1e293b"/>
              <path d="M20 7L24 16L33 20L24 24L20 33L16 24L7 20L16 16L20 7Z" fill="url(#footerLogoGrad)"/>
              <circle cx="20" cy="20" r="3" fill="#ffffff"/>
              <defs>
                <linearGradient id="footerLogoGrad" x1="7" y1="7" x2="33" y2="33">
                  <stop stop-color="#06b6d4"/>
                  <stop offset="0.5" stop-color="#2563eb"/>
                  <stop offset="1" stop-color="#8b5cf6"/>
                </linearGradient>
              </defs>
            </svg>
          </span>
          <span class="wordmark__text">
            <span class="wordmark__name">Supernova Labs <strong>Studio</strong></span>
          </span>
        </a>
        <p class="footer-desc">
          Partner rekayasa teknologi komprehensif untuk pembangunan website enterprise, mobile apps iOS &amp; Android, dan sistem desktop mission-critical.
        </p>
        <div class="footer-badges">
          <span class="footer-badge">● Zero Vendor Lock-in</span>
          <span class="footer-badge">● OWASP Hardened</span>
        </div>
      </div>

      <div class="footer-links">
        <div class="footer-col">
          <span class="footer-col__title">Navigasi Halaman</span>
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>

        <div class="footer-col">
          <span class="footer-col__title">Layanan Multiplatform</span>
          <a href="#layanan">Enterprise Web Ecosystems</a>
          <a href="#layanan">Native &amp; Hybrid Mobile Apps</a>
          <a href="#layanan">Mission-Critical Desktop Systems</a>
          <a href="#estimator">Kalkulator Estimasi Proyek</a>
        </div>

        <div class="footer-col">
          <span class="footer-col__title">Kontak &amp; Dispatch</span>
          <a href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener noreferrer" class="footer-contact-link">
            <Icon name="whatsapp" size={15} />
            <span>{contact.displayPhone}</span>
          </a>
          <span>Jakarta, Indonesia (Melayani Klien Global)</span>
          <span>Jam Kerja: Sen – Sab, 08:00 – 21:00 WIB</span>
          <span class="footer-status-pill">● Lead Architect Standby</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} {site.name}. All rights reserved.</span>
      <span>Engineering digital systems for meaningful scale &amp; long-term durability.</span>
    </div>
  </div>
</footer>