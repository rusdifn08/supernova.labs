---
import Button from '../atoms/Button.astro';
import Icon from '../atoms/Icon.astro';
import SectionArt from '../atoms/SectionArt.astro';
import { getWhatsAppUrl } from '../../lib/whatsapp';
const wa = getWhatsAppUrl();
---
<section class="final-cta">
  <div class="container final-cta__inner">
    <div class="final-cta__grid">
      <div class="final-cta__content" data-reveal="up">
        <p class="eyebrow eyebrow--light">07 / Start a conversation</p>
        <h2>Your idea is too valuable for the wrong team.</h2>
        <p>Mulai dari percakapan yang jujur tentang masalah, peluang, dan sistem yang Anda butuhkan. Konsultasi teknis gratis tanpa komitmen.</p>
        <Button href={wa} size="lg" icon="whatsapp">Jadwalkan konsultasi via WhatsApp</Button>
        <div class="final-cta__trust">
          <span><Icon name="check" size={14} /> Tanpa biaya konsultasi</span>
          <span><Icon name="check" size={14} /> Respons &lt; 15 menit</span>
          <span><Icon name="check" size={14} /> NDA tersedia</span>
        </div>
      </div>
      <div class="final-cta__visual" data-reveal="left">
        <SectionArt variant="contact" />
        <div class="cta-card">
          <span class="cta-card__label">KONTAK LANGSUNG</span>
          <div class="cta-card__row"><Icon name="whatsapp" size={20} /><div><span>WhatsApp</span><strong>0851 7428 9548</strong></div></div>
          <div class="cta-card__divider"></div>
          <div class="cta-card__row"><Icon name="globe" size={20} /><div><span>Lokasi</span><strong>Jakarta, Indonesia</strong></div></div>
          <div class="cta-card__divider"></div>
          <div class="cta-card__row"><Icon name="clock" size={20} /><div><span>Jam operasional</span><strong>Sen–Sab, 09–21 WIB</strong></div></div>
        </div>
      </div>
    </div>
  </div>
</section>
