---
import SectionHeading from '../molecules/SectionHeading.astro';
import StepItem from '../molecules/StepItem.astro';
import SectionArt from '../atoms/SectionArt.astro';
const steps = [
  ['01', 'Discover & Design', 'Requirement engineering, system flow, dan prototype Figma terkunci sebelum satu baris kode ditulis.', 'target', 'Blueprint & Prototype'],
  ['02', 'Build in Sprints', 'Siklus mingguan dengan akses staging environment real-time. Anda memantau progres, bukan menunggu kabar.', 'terminal', 'Weekly Release'],
  ['03', 'Secure & Handover', 'Uji beban, audit keamanan, lalu serah terima source code, dokumentasi API, dan training tim Anda.', 'shield', 'Source & API Docs']
];
---
<section class="section" id="metodologi">
  <div class="container">
    <div class="section-intro"><SectionHeading eyebrow="03 / Method" title="Clean upfront. Fast behind the scenes." description="Proses transparan mengurangi kejutan, mengunci arah, dan membuat setiap rupiah development punya alasan." /><SectionArt variant="method" /></div>
    <div class="steps" data-stagger>
      {steps.map(([number, title, description, icon, outcome]) => <StepItem number={number} title={title} description={description} icon={icon} outcome={outcome} />)}
    </div>
  </div>
</section>
