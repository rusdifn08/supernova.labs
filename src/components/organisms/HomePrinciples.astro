---
import SectionHeading from '../molecules/SectionHeading.astro';
import PrincipleCard from '../molecules/PrincipleCard.astro';
import SectionArt from '../atoms/SectionArt.astro';

const principles = [
  {
    icon: 'layers',
    title: 'Solid Architecture',
    description: 'Setiap keputusan teknis dan skema data dirancang untuk skalabilitas 5 tahun ke depan, bukan sekadar demo cepat minggu depan.'
  },
  {
    icon: 'code',
    title: 'Clean Code & Strict Typing',
    description: 'Kode yang rapi, terstruktur, dan memiliki dokumentasi jelas sehingga mudah dirawat oleh tim internal Anda di masa mendatang.'
  },
  {
    icon: 'shield',
    title: 'Security-First by Design',
    description: 'Audit kerentanan OWASP, enkripsi data, dan proteksi API diterapkan sejak sprint pertama, bukan sebagai tambalan di akhir.'
  },
  {
    icon: 'bolt',
    title: 'Sub-Second Performance',
    description: 'Skor Lighthouse 100 dan efisiensi memori bukan sekadar bonus kosmetik, melainkan standar baku kami di semua platform.'
  }
];
---
<section class="section" id="prinsip">
  <div class="container">
    <div class="section-intro">
      <SectionHeading
        eyebrow="05 / Prinsip Engineering"
        title="Standar Teknis yang Tidak Pernah Kami Kompromikan."
        description="Kepercayaan B2B dan founder tidak dibangun dari janji manis presentasi, melainkan dari konsistensi kami dalam setiap baris kode dan keamanan data Anda."
      />
      <SectionArt variant="principles" />
    </div>

    <div class="principles-grid" data-stagger>
      {principles.map((p) => <PrincipleCard {...p} />)}
    </div>
  </div>
</section>