---
import SectionHeading from '../molecules/SectionHeading.astro';
import PrincipleCard from '../molecules/PrincipleCard.astro';
import SectionArt from '../atoms/SectionArt.astro';
const principles = [
  { icon: 'layers', title: 'Solid Architecture', description: 'Setiap keputusan teknis dipertimbangkan untuk skalabilitas 5 tahun ke depan, bukan demo minggu depan.' },
  { icon: 'code', title: 'Clean Code', description: 'Kode yang dapat dibaca, diuji, dan dirawat oleh siapa pun di tim Anda—tanpa tribal knowledge.' },
  { icon: 'shield', title: 'Security First', description: 'Audit keamanan dan praktik hardening diterapkan sejak fase development, bukan setelahnya.' },
  { icon: 'bolt', title: 'Native Performance', description: 'Lighthouse 100 bukan target akhir—ia adalah standar minimum yang kami pegang.' }
];
---
<section class="section section--paper" id="prinsip">
  <div class="container">
    <div class="section-intro"><SectionHeading eyebrow="04 / Principles" title="Principles we never compromise." description="Kepercayaan B2B tidak dibangun dari janji, tetapi dari konsistensi dalam detail teknis." /><SectionArt variant="principles" /></div>
    <div class="principles-grid" data-stagger>
      {principles.map((p) => <PrincipleCard {...p} />)}
    </div>
  </div>
</section>
