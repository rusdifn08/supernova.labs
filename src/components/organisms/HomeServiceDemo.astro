---
import SectionHeading from '../molecules/SectionHeading.astro';
import Icon from '../atoms/Icon.astro';
import { getWhatsAppUrl } from '../../lib/whatsapp';

const waBooking = getWhatsAppUrl('Halo Tim Supernova Labs, saya tertarik konsultasi & kustomisasi Ordering System Booking untuk bisnis saya.');
const waPos = getWhatsAppUrl('Halo Tim Supernova Labs, saya ingin demo sistem terpadu POS, ERP, CRM & Keuangan untuk operasional bisnis saya.');
const waQr = getWhatsAppUrl('Halo Tim Supernova Labs, saya ingin uji coba Ordering in Table with QR Code untuk restoran/kafe saya.');
---

<section class="section section--paper section--demo" id="demo">
  <div class="container">
    <div class="section-intro">
      <SectionHeading
        eyebrow="Interactive Suite / Uji Coba Layanan Enterprise"
        title="Uji Coba Langsung 3 Solusi Digital Unggulan Kami."
        description="Eksplorasi simulasi interaktif end-to-end tanpa mockup kosong. Rasakan bagaimana alur booking, kasir/ERP multi-gudang, dan pemesanan meja QR terintegrasi secara nyata untuk bisnis di Indonesia."
      />
      <div class="demo-badge-banner">
        <span class="status-dot"></span>
        <span>SANDBOX SIMULATOR · LIVE REACTIVE ENGINE</span>
      </div>
    </div>

    <!-- Main Service Demo Container -->
    <div class="demo-experience" data-demo-root data-reveal="up">
      <!-- Demo Tabs Navigation -->
      <div class="demo-tabs" role="tablist" aria-label="Menu Uji Coba Layanan Supernova">
        <button
          type="button"
          class="demo-tab is-active"
          role="tab"
          aria-selected="true"
          aria-controls="panel-booking"
          id="tab-booking"
          data-demo-tab="booking"
        >
          <span class="demo-tab__icon"><Icon name="clock" size={20} /></span>
          <span class="demo-tab__label">
            <strong>1. Ordering System Booking</strong>
            <small>Futsal, Studio, Barber, Rental PS &amp; Warnet</small>
          </span>
        </button>

        <button
          type="button"
          class="demo-tab"
          role="tab"
          aria-selected="false"
          aria-controls="panel-pos"
          id="tab-pos"
          data-demo-tab="pos"
        >
          <span class="demo-tab__icon"><Icon name="layers" size={20} /></span>
          <span class="demo-tab__label">
            <strong>2. POS, ERP, CRM &amp; Keuangan</strong>
            <small>Kasir, Karyawan, Stok Multi-Gudang &amp; Laba Rugi</small>
          </span>
        </button>

        <button
          type="button"
          class="demo-tab"
          role="tab"
          aria-selected="false"
          aria-controls="panel-qr"
          id="tab-qr"
          data-demo-tab="qr"
        >
          <span class="demo-tab__icon"><Icon name="target" size={20} /></span>
          <span class="demo-tab__label">
            <strong>3. Ordering In Table (QR Code)</strong>
            <small>Dine-In Resto, Split Bill &amp; Kitchen Display (KDS)</small>
          </span>
        </button>
      </div>

      <!-- Tab Content Panels -->
      <div class="demo-panels">
        <!-- ============================================================ -->
        <!-- PANEL 1: ORDERING SYSTEM BOOKING                             -->
        <!-- ============================================================ -->
        <div
          class="demo-panel is-active"
          id="panel-booking"
          role="tabpanel"
          aria-labelledby="tab-booking"
          data-demo-panel="booking"
        >
          <div class="demo-panel__grid">
            <!-- Left Column: Controls & Booking Simulator -->
            <div class="demo-panel__info">
              <span class="panel-eyebrow">SOLUSI 01 · UNIVERSAL BOOKING ENGINE</span>
              <h3>Satu Mesin Booking Fleksibel untuk Segala Jenis Jasa &amp; Fasilitas</h3>
              <p class="panel-desc">
                Hilangkan risiko double-booking dan kerepotan rekap chat manual. Sistem otomatis mengunci slot waktu, memverifikasi uang muka (DP), dan menerbitkan e-ticket WhatsApp instan.
              </p>

              <!-- Business Category Selector Chips -->
              <div class="sim-category-bar">
                <span class="sim-label-inline">Pilih Jenis Bisnis:</span>
                <div class="biz-chips" id="bookingBizChips">
                  <button type="button" class="biz-chip is-active" data-biz="futsal">⚽ Futsal / Olahraga</button>
                  <button type="button" class="biz-chip" data-biz="studio">📸 Studio Photo</button>
                  <button type="button" class="biz-chip" data-biz="barber">✂️ Barbershop</button>
                  <button type="button" class="biz-chip" data-biz="ps">🎮 Rental PS5</button>
                  <button type="button" class="biz-chip" data-biz="warnet">🖥️ Warnet Esports</button>
                </div>
              </div>

              <!-- Main Interactive Booking Simulator Card -->
              <div class="interactive-simulator-card">
                <div class="sim-header">
                  <span class="sim-title">⚡ SIMULATOR RESERVASI &amp; JADWAL REAL-TIME</span>
                  <span class="sim-pill">Auto Collision Lock</span>
                </div>

                <div class="sim-controls">
                  <!-- Facility / Resource Dropdown -->
                  <div class="sim-field">
                    <label for="bookingResourceSelect">Pilih Fasilitas / Lapangan / Ruangan:</label>
                    <select class="sim-select" id="bookingResourceSelect">
                      <!-- Populated dynamically by script -->
                    </select>
                  </div>

                  <!-- Date Selector -->
                  <div class="sim-field">
                    <label>Pilih Tanggal Booking:</label>
                    <div class="date-pills" id="bookingDatePills">
                      <button type="button" class="date-pill is-active" data-date="Hari Ini">Hari Ini (21 Okt)</button>
                      <button type="button" class="date-pill" data-date="Besok">Besok (22 Okt)</button>
                      <button type="button" class="date-pill" data-date="Lusa">Lusa (23 Okt)</button>
                      <button type="button" class="date-pill" data-date="Sabtu Depan">Weekend (Sabtu)</button>
                    </div>
                  </div>

                  <!-- Interactive Time Slot Grid -->
                  <div class="sim-field">
                    <div class="field-header-flex">
                      <label>Pilih Slot Waktu (Bisa Pilih &gt;1 Jam):</label>
                      <span class="slot-legend">
                        <span class="dot dot--avail"></span> Tersedia
                        <span class="dot dot--peak"></span> Peak Hour (+Rp 20k)
                        <span class="dot dot--booked"></span> Terisi
                      </span>
                    </div>
                    <div class="booking-slot-grid" id="bookingSlotGrid">
                      <!-- Slots dynamically injected with realistic peak hour & availability -->
                    </div>
                  </div>

                  <!-- Add-ons / Sewa Perlengkapan Tambahan -->
                  <div class="sim-field">
                    <label>Layanan &amp; Perlengkapan Tambahan (Add-on Upsell):</label>
                    <div class="addon-checklist" id="bookingAddonList">
                      <!-- Populated dynamically based on category -->
                    </div>
                  </div>

                  <!-- Customer Name & Payment Scheme -->
                  <div class="sim-row-2col">
                    <div class="sim-field">
                      <label for="bookingCustomerName">Nama Pemesan:</label>
                      <input type="text" class="sim-input" id="bookingCustomerName" value="Rian Hidayat" placeholder="Nama lengkap..." />
                    </div>
                    <div class="sim-field">
                      <label>Skema Pembayaran:</label>
                      <div class="payment-scheme-radios">
                        <label class="radio-label">
                          <input type="radio" name="paymentScheme" value="dp" checked />
                          <span>DP 50% (Kunci Jadwal)</span>
                        </label>
                        <label class="radio-label">
                          <input type="radio" name="paymentScheme" value="full" />
                          <span>Lunas 100%</span>
                        </label>
                      </div>
                    </div>
                  </div>

                  <!-- Price Calculation Summary -->
                  <div class="booking-calc-summary">
                    <div class="calc-row">
                      <span>Tarif Fasilitas:</span>
                      <strong id="calcBaseRate">Rp 150.000 x 2 Jam = Rp 300.000</strong>
                    </div>
                    <div class="calc-row">
                      <span>Biaya Tambahan (Add-on):</span>
                      <strong id="calcAddonCost">Rp 0</strong>
                    </div>
                    <div class="calc-row calc-row--total">
                      <span>Total Biaya Booking:</span>
                      <strong class="highlight-price" id="calcGrandTotal">Rp 300.000</strong>
                    </div>
                    <div class="calc-row calc-row--paynow">
                      <span>Wajib Bayar Sekarang (DP 50%):</span>
                      <strong class="text-success" id="calcDueAmount">Rp 150.000</strong>
                    </div>
                  </div>

                  <!-- Submit Button -->
                  <button type="button" class="btn btn--primary btn--md w-full" id="btnConfirmBooking">
                    <Icon name="check" size={16} />
                    <span>Terbitkan E-Ticket &amp; Kunci Jadwal Booking</span>
                  </button>
                </div>
              </div>

              <!-- Quick Verification Tool -->
              <div class="booking-lookup-card">
                <div class="lookup-header">
                  <Icon name="target" size={16} />
                  <span>Cek &amp; Validasi Tiket Booking Tamu:</span>
                </div>
                <div class="lookup-input-group">
                  <input type="text" class="sim-input" id="lookupCodeInput" value="BK-FTS-88421" placeholder="Masukkan kode booking..." />
                  <button type="button" class="btn btn--secondary btn--sm" id="btnVerifyCode">Validasi QR/Kode</button>
                </div>
                <div class="lookup-feedback" id="lookupFeedback">
                  *Status: Tiket <strong>BK-FTS-88421</strong> terverifikasi valid! DP 50% Lunas via QRIS.
                </div>
              </div>

              <div class="panel-actions">
                <a class="btn btn--cta btn--md" href={waBooking} target="_blank" rel="noopener noreferrer">
                  <span>Konsultasi &amp; Kustomisasi Booking (WA)</span>
                  <span class="btn__icon"><Icon name="whatsapp" size={16} /></span>
                </a>
                <a class="btn btn--outline btn--md" href="#estimator">
                  <span>Hitung Estimasi Proyek</span>
                </a>
              </div>
            </div>

            <!-- Right Column: Interactive Digital Boarding Pass / E-Ticket -->
            <div class="demo-panel__visual">
              <div class="ticket-mockup-wrapper">
                <div class="art-card-topbar">
                  <span>LIVE PASS // DIGITAL_BOOKING_VOUCHER</span>
                  <span class="status-live">● VERIFIED TICKET</span>
                </div>

                <div class="digital-ticket-card" id="digitalTicketCard">
                  <div class="ticket-header">
                    <div class="ticket-brand">
                      <span class="brand-badge">SUPERNOVA BOOKING</span>
                      <span class="ticket-code" id="ticketCodeDisplay">BK-FTS-88421</span>
                    </div>
                    <div class="ticket-qr-box">
                      <div class="qr-pattern">
                        <!-- High tech SVG QR simulation -->
                        <svg viewBox="0 0 100 100" width="68" height="68" fill="none">
                          <rect width="100" height="100" fill="#ffffff" rx="4"/>
                          <path d="M10 10h28v28H10zM16 16h16v16H16zM62 10h28v28H62zM68 16h16v16H68zM10 62h28v28H10zM16 68h16v16H16zM46 10h8v8h-8zM46 26h8v16h-8zM26 46h16v8H26zM50 50h8v8h-8zM62 46h12v8H62zM80 46h10v16H80zM46 68h8v12h-8zM62 68h16v8H62zM84 68h6v22h-6zM62 82h12v8H62zM46 88h8v6h-8z" fill="#0f172a"/>
                        </svg>
                      </div>
                      <small>Scan di Lokasi</small>
                    </div>
                  </div>

                  <div class="ticket-perforated-line">
                    <span class="notch notch--left"></span>
                    <span class="notch notch--right"></span>
                  </div>

                  <div class="ticket-body">
                    <div class="ticket-data-row">
                      <div class="ticket-data-col">
                        <span class="t-label">NAMA PEMESAN</span>
                        <strong class="t-value" id="ticketGuestName">Rian Hidayat</strong>
                      </div>
                      <div class="ticket-data-col">
                        <span class="t-label">JENIS BISNIS</span>
                        <strong class="t-value" id="ticketBizName">Sarana Futsal Pro</strong>
                      </div>
                    </div>

                    <div class="ticket-data-row">
                      <div class="ticket-data-col">
                        <span class="t-label">FASILITAS / ARENA</span>
                        <strong class="t-value text-blue" id="ticketResourceName">Lapangan 1 (Vinyl Pro)</strong>
                      </div>
                      <div class="ticket-data-col">
                        <span class="t-label">TANGGAL &amp; HARI</span>
                        <strong class="t-value" id="ticketDate">Hari Ini (21 Okt)</strong>
                      </div>
                    </div>

                    <div class="ticket-data-row">
                      <div class="ticket-data-col">
                        <span class="t-label">JADWAL JAM</span>
                        <strong class="t-value" id="ticketHours">19:00 - 21:00 (2 Jam)</strong>
                      </div>
                      <div class="ticket-data-col">
                        <span class="t-label">PERLENGKAPAN TAMBAHAN</span>
                        <strong class="t-value" id="ticketAddons">Sewa Rompi (+20k)</strong>
                      </div>
                    </div>

                    <div class="ticket-status-strip">
                      <div class="status-block">
                        <span class="t-label">STATUS PEMBAYARAN</span>
                        <span class="status-pill status-pill--dp" id="ticketPaymentBadge">DP 50% LUNAS</span>
                      </div>
                      <div class="status-block text-right">
                        <span class="t-label">TOTAL BIAYA</span>
                        <strong class="t-amount" id="ticketTotalAmount">Rp 320.000</strong>
                      </div>
                    </div>

                    <div class="ticket-actions">
                      <button type="button" class="btn btn--whatsapp-share w-full" id="btnShareTicketWA">
                        <Icon name="whatsapp" size={15} />
                        <span>Simulasi Kirim Tiket ke WhatsApp Tamu</span>
                      </button>
                      <button type="button" class="btn btn--ticket-outline w-full" id="btnDownloadTicket">
                        <span>Cetak / Unduh E-Ticket (PDF)</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ============================================================ -->
        <!-- PANEL 2: POS, ERP, CRM & KEUANGAN                            -->
        <!-- ============================================================ -->
        <div
          class="demo-panel"
          id="panel-pos"
          role="tabpanel"
          aria-labelledby="tab-pos"
          data-demo-panel="pos"
        >
          <div class="demo-panel__grid">
            <!-- Left Column: POS Cashier Controls -->
            <div class="demo-panel__info">
              <span class="panel-eyebrow">SOLUSI 02 · UNIFIED ENTERPRISE BUSINESS CORE</span>
              <h3>POS Kasir, ERP Stok Multi-Gudang, CRM &amp; Jurnal Keuangan 1 Pintu</h3>
              <p class="panel-desc">
                Pantau shift kasir harian, mutasi stok barang masuk/keluar, poin loyalitas pelanggan, hingga kalkulasi laba bersih secara otomatis tanpa perlu ekspor rumus spreadsheet rumit.
              </p>

              <!-- POS Shift & Cashier Status Strip -->
              <div class="pos-top-meta">
                <div class="meta-item">
                  <span class="meta-label">Kasir Bertugas:</span>
                  <strong>Rina Andini (Shift Pagi)</strong>
                </div>
                <div class="meta-item">
                  <span class="meta-label">Kas Awal Laci:</span>
                  <strong class="text-blue">Rp 500.000</strong>
                </div>
                <div class="meta-item">
                  <span class="meta-label">Mode Operasional:</span>
                  <span class="status-pill status-pill--live">● CLOUD SYNCED</span>
                </div>
              </div>

              <!-- Main Interactive POS Card -->
              <div class="interactive-simulator-card">
                <div class="sim-header">
                  <span class="sim-title">🛒 TERMINAL KASIR (POS) &amp; CRM MEMBER</span>
                  <span class="sim-pill">ACID Transaction Engine</span>
                </div>

                <div class="pos-cart-sim">
                  <!-- Search & Category Bar -->
                  <div class="pos-filter-bar">
                    <div class="pos-search-wrapper">
                      <input type="text" class="sim-input sim-input--search" id="posSearchInput" placeholder="🔍 Cari nama barang / barcode (contoh: Kopi, Latte, Fries)..." />
                    </div>
                    <div class="pos-category-pills" id="posCategoryPills">
                      <button type="button" class="p-cat-btn is-active" data-cat="all">Semua (6)</button>
                      <button type="button" class="p-cat-btn" data-cat="beverage">☕ Minuman</button>
                      <button type="button" class="p-cat-btn" data-cat="food">🥐 Makanan</button>
                      <button type="button" class="p-cat-btn" data-cat="retail">📦 Retail</button>
                    </div>
                  </div>

                  <!-- Product Items Grid -->
                  <div class="pos-product-grid" id="posProductGrid">
                    <!-- Products will be rendered dynamically by JavaScript -->
                  </div>

                  <!-- CRM Loyalty Member Selector -->
                  <div class="pos-crm-section">
                    <label for="posCustomerSelect">Hubungkan Pelanggan (CRM Member Loyalty):</label>
                    <div class="crm-selector-row">
                      <select class="sim-select" id="posCustomerSelect">
                        <option value="budi" data-tier="Gold" data-points="1250" data-discount="15000">👤 Budi Santoso (Gold Member · 1.250 Poin)</option>
                        <option value="siti" data-tier="Silver" data-points="420" data-discount="5000">👤 Siti Nurhaliza (Silver Member · 420 Poin)</option>
                        <option value="umum" data-tier="Non-Member" data-points="0" data-discount="0">👥 Pelanggan Umum (Tanpa Member)</option>
                      </select>
                      <button type="button" class="btn btn--outline btn--sm" id="btnTogglePoints">Gunakan Poin</button>
                    </div>
                    <div class="crm-reward-badge" id="crmRewardBadge">
                      ⭐ <strong>Gold Member Reward:</strong> Berhak cashback 5% dan gratis upsizing minuman.
                    </div>
                  </div>

                  <!-- Active Cart Line Items -->
                  <div class="pos-cart-drawer">
                    <div class="cart-drawer-header">
                      <span>Daftar Pesanan Kasir:</span>
                      <button type="button" class="btn-clear-cart" id="btnClearCart">Kosongkan</button>
                    </div>

                    <div class="cart-items-container" id="cartItemsContainer">
                      <!-- Active cart items injected here -->
                    </div>

                    <!-- Promo Code Bar -->
                    <div class="promo-code-row">
                      <input type="text" class="sim-input" id="posVoucherInput" placeholder="Kode Promo (coba: SUPERNOVA10 atau HEMAT15)" />
                      <button type="button" class="btn btn--secondary btn--sm" id="btnApplyVoucher">Klaim Promo</button>
                    </div>
                    <div class="voucher-feedback" id="voucherFeedback"></div>

                    <!-- Financial Totals -->
                    <div class="pos-pricing-breakdown">
                      <div class="price-row">
                        <span>Subtotal Barang:</span>
                        <span id="posSubtotal">Rp 0</span>
                      </div>
                      <div class="price-row">
                        <span>Diskon Member / Promo:</span>
                        <span class="text-danger" id="posDiscount">-Rp 0</span>
                      </div>
                      <div class="price-row">
                        <span>Pajak Resto/PB1 (10%):</span>
                        <span id="posTax">Rp 0</span>
                      </div>
                      <div class="price-row price-row--grand">
                        <span>Total Bayar:</span>
                        <strong class="highlight-price" id="posGrandTotal">Rp 0</strong>
                      </div>
                    </div>

                    <!-- Payment Mode & Cash Change Calculator -->
                    <div class="payment-method-box">
                      <span class="sim-label-inline">Pilih Metode Pembayaran:</span>
                      <div class="pay-method-tabs">
                        <button type="button" class="pay-tab is-active" data-method="cash">💵 Tunai (Cash)</button>
                        <button type="button" class="pay-tab" data-method="qris">📱 QRIS Realtime</button>
                        <button type="button" class="pay-tab" data-method="edc">💳 Kartu Debit/EDC</button>
                      </div>

                      <div class="cash-calc-panel" id="cashCalcPanel">
                        <div class="quick-cash-buttons">
                          <button type="button" class="cash-chip" data-nominal="exact">Uang Pas</button>
                          <button type="button" class="cash-chip" data-nominal="50000">Rp 50.000</button>
                          <button type="button" class="cash-chip" data-nominal="100000">Rp 100.000</button>
                          <button type="button" class="cash-chip" data-nominal="200000">Rp 200.000</button>
                        </div>
                        <div class="cash-inputs-row">
                          <div class="c-field">
                            <label>Uang Diterima:</label>
                            <input type="number" class="sim-input" id="cashReceivedInput" placeholder="0" />
                          </div>
                          <div class="c-field">
                            <label>Kembalian (Change):</label>
                            <strong class="change-amount" id="cashChangeDisplay">Rp 0</strong>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Checkout Button -->
                    <button type="button" class="btn btn--primary btn--md w-full" id="btnPosCheckout">
                      <Icon name="check" size={16} />
                      <span>Selesaikan Transaksi &amp; Sinkronkan Stok/Jurnal</span>
                    </button>
                  </div>
                </div>
              </div>

              <div class="panel-actions">
                <a class="btn btn--cta btn--md" href={waPos} target="_blank" rel="noopener noreferrer">
                  <span>Konsultasi POS &amp; ERP Sistem (WA)</span>
                  <span class="btn__icon"><Icon name="whatsapp" size={16} /></span>
                </a>
                <a class="btn btn--outline btn--md" href="#estimator">
                  <span>Simulasi Estimasi Proyek</span>
                </a>
              </div>
            </div>

            <!-- Right Column: Dual View (Thermal Receipt vs Mini-ERP Financial Dashboard) -->
            <div class="demo-panel__visual">
              <div class="pos-output-wrapper">
                <div class="art-card-topbar">
                  <div class="output-tab-toggles">
                    <button type="button" class="out-toggle is-active" id="btnToggleReceiptView">🧾 STRUK THERMAL KASIR</button>
                    <button type="button" class="out-toggle" id="btnToggleErpView">📊 MINI-ERP &amp; LABA RUGI</button>
                  </div>
                  <span class="status-live">● ACID TRANSACTIONS</span>
                </div>

                <!-- VIEW 1: THERMAL RECEIPT -->
                <div class="thermal-receipt-container" id="receiptView">
                  <div class="receipt-paper">
                    <div class="receipt-header">
                      <h4>SUPERNOVA COFFEE &amp; ROASTERY</h4>
                      <p>Jl. Jend. Sudirman Kav. 52, SCBD Jakarta</p>
                      <p>Telp: (021) 555-8899 · NPWP: 01.345.678.9</p>
                      <div class="receipt-divider">--------------------------------</div>
                      <div class="receipt-meta">
                        <span id="receiptInvoiceNum">INV/POS-20261021-042</span>
                        <span id="receiptTimestamp">21/10/2026 14:15 WIB</span>
                      </div>
                      <div class="receipt-meta">
                        <span>Kasir: Rina Andini</span>
                        <span id="receiptMemberName">Pelanggan: Budi Santoso (Gold)</span>
                      </div>
                      <div class="receipt-divider">--------------------------------</div>
                    </div>

                    <div class="receipt-items-list" id="receiptItemsList">
                      <!-- Dynamically rendered receipt items -->
                      <div class="receipt-item-row">
                        <div>
                          <strong>1x Caramel Macchiato Latte</strong>
                          <small>Notes: Normal Sugar</small>
                        </div>
                        <span>35.000</span>
                      </div>
                      <div class="receipt-item-row">
                        <div>
                          <strong>1x Biji Kopi Signature 250g</strong>
                          <small>Medium Roast Beans</small>
                        </div>
                        <span>75.000</span>
                      </div>
                    </div>

                    <div class="receipt-divider">--------------------------------</div>

                    <div class="receipt-totals-table">
                      <div class="r-total-row">
                        <span>Subtotal:</span>
                        <span id="rSubtotal">Rp 110.000</span>
                      </div>
                      <div class="r-total-row">
                        <span>Diskon (Member/Promo):</span>
                        <span id="rDiscount">-Rp 15.000</span>
                      </div>
                      <div class="r-total-row">
                        <span>PB1 Resto (10%):</span>
                        <span id="rTax">Rp 9.500</span>
                      </div>
                      <div class="r-total-row r-total-row--grand">
                        <strong>TOTAL AKHIR:</strong>
                        <strong id="rGrandTotal">Rp 104.500</strong>
                      </div>
                      <div class="r-total-row">
                        <span>Bayar (Tunai):</span>
                        <span id="rPaid">Rp 150.000</span>
                      </div>
