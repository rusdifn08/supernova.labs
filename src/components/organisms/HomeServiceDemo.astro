---
import SectionHeading from '../molecules/SectionHeading.astro';
import Icon from '../atoms/Icon.astro';
import BookingPanel from '../molecules/demo/BookingPanel.astro';
import PosPanel from '../molecules/demo/PosPanel.astro';
import RestoPanel from '../molecules/demo/RestoPanel.astro';
---

<section class="section section--paper section--demo" id="demo">
  <div class="container">
    <div class="section-intro demo-intro-compact">
      <SectionHeading
        eyebrow="Interactive Preview / Simulasi Cepat"
        title="Uji Coba Langsung 3 Solusi Digital Unggulan Kami."
        description="Simulasi instan alur transaksi & fitur di landing page. Untuk uji coba nyata dengan data brand & database bisnis Anda sendiri, gunakan Layanan Sistem."
      />
      <div class="demo-intro-cta">
        <a class="btn btn--cta btn--sm" href="/layanan/booking">
          <span>🚀 Buka Layanan Sistem (Aktif 1 Bulan Penuh)</span>
          <Icon name="arrow" size={14} />
        </a>
      </div>
    </div>

    <!-- Main Service Demo Container -->
    <div class="demo-experience demo-experience--compact" data-demo-root data-reveal="up">
      <!-- Demo Tabs Navigation -->
      <div class="demo-tabs" role="tablist" aria-label="Menu Uji Coba Layanan Supernova">
        <button
          type="button"
          class="demo-tab is-active"
          role="tab"
          aria-selected="true"
          aria-controls="panel-booking"
          id="tab-booking"
          data-demo-tab="booking"
        >
          <span class="demo-tab__icon"><Icon name="clock" size={18} /></span>
          <span class="demo-tab__label">
            <strong>1. Ordering System Booking</strong>
            <small>Futsal, Studio, Barber, Rental PS &amp; Warnet</small>
          </span>
        </button>

        <button
          type="button"
          class="demo-tab"
          role="tab"
          aria-selected="false"
          aria-controls="panel-pos"
          id="tab-pos"
          data-demo-tab="pos"
        >
          <span class="demo-tab__icon"><Icon name="layers" size={18} /></span>
          <span class="demo-tab__label">
            <strong>2. POS, ERP, CRM &amp; Keuangan</strong>
            <small>Kasir, Karyawan, Stok &amp; Laba Rugi</small>
          </span>
        </button>

        <button
          type="button"
          class="demo-tab"
          role="tab"
          aria-selected="false"
          aria-controls="panel-qr"
          id="tab-qr"
          data-demo-tab="qr"
        >
          <span class="demo-tab__icon"><Icon name="target" size={18} /></span>
          <span class="demo-tab__label">
            <strong>3. Ordering In Table (QR Code)</strong>
            <small>Dine-In Resto, Split Bill &amp; Kitchen KDS</small>
          </span>
        </button>
      </div>

      <!-- Tab Content Panels -->
      <div class="demo-panels demo-panels--compact">
        <BookingPanel />
        <PosPanel />
        <RestoPanel />
      </div>
    </div>
  </div>
</section>
