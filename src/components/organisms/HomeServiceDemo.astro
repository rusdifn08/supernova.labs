---
import SectionHeading from '../molecules/SectionHeading.astro';
import Icon from '../atoms/Icon.astro';
import { getWhatsAppUrl } from '../../lib/whatsapp';

const waBooking = getWhatsAppUrl('Halo Tim Supernova Labs, saya tertarik konsultasi & kustomisasi Ordering System Booking untuk bisnis saya.');
const waPos = getWhatsAppUrl('Halo Tim Supernova Labs, saya ingin demo sistem terpadu POS, ERP, CRM & Keuangan untuk operasional bisnis saya.');
const waQr = getWhatsAppUrl('Halo Tim Supernova Labs, saya ingin uji coba Ordering in Table with QR Code untuk restoran/kafe saya.');
---

<section class="section section--paper section--demo" id="demo">
  <div class="container">
    <div class="section-intro demo-intro-compact">
      <SectionHeading
        eyebrow="Interactive Preview / Simulasi Cepat"
        title="Uji Coba Langsung 3 Solusi Digital Unggulan Kami."
        description="Simulasi instan alur transaksi & fitur di landing page. Untuk uji coba nyata dengan data brand & database bisnis Anda sendiri, gunakan Portal Uji Coba Real."
      />
      <div class="demo-intro-cta">
        <a class="btn btn--cta btn--sm" href="/layanan/booking">
          <span>🚀 Buka Layanan Sistem (Aktif 1 Bulan Penuh)</span>
          <Icon name="arrow" size={14} />
        </a>
      </div>
    </div>

    <!-- Main Service Demo Container (Compact Height) -->
    <div class="demo-experience demo-experience--compact" data-demo-root data-reveal="up">
      <!-- Demo Tabs Navigation -->
      <div class="demo-tabs" role="tablist" aria-label="Menu Uji Coba Layanan Supernova">
        <button
          type="button"
          class="demo-tab is-active"
          role="tab"
          aria-selected="true"
          aria-controls="panel-booking"
          id="tab-booking"
          data-demo-tab="booking"
        >
          <span class="demo-tab__icon"><Icon name="clock" size={18} /></span>
          <span class="demo-tab__label">
            <strong>1. Ordering System Booking</strong>
            <small>Futsal, Studio, Barber, Rental PS &amp; Warnet</small>
          </span>
        </button>

        <button
          type="button"
          class="demo-tab"
          role="tab"
          aria-selected="false"
          aria-controls="panel-pos"
          id="tab-pos"
          data-demo-tab="pos"
        >
          <span class="demo-tab__icon"><Icon name="layers" size={18} /></span>
          <span class="demo-tab__label">
            <strong>2. POS, ERP, CRM &amp; Keuangan</strong>
            <small>Kasir, Karyawan, Stok &amp; Laba Rugi</small>
          </span>
        </button>

        <button
          type="button"
          class="demo-tab"
          role="tab"
          aria-selected="false"
          aria-controls="panel-qr"
          id="tab-qr"
          data-demo-tab="qr"
        >
          <span class="demo-tab__icon"><Icon name="target" size={18} /></span>
          <span class="demo-tab__label">
            <strong>3. Ordering In Table (QR Code)</strong>
            <small>Dine-In Resto, Split Bill &amp; Kitchen KDS</small>
          </span>
        </button>
      </div>

      <!-- Tab Content Panels -->
      <div class="demo-panels demo-panels--compact">
        <!-- ============================================================ -->
        <!-- PANEL 1: ORDERING SYSTEM BOOKING (COMPACT PREVIEW)           -->
        <!-- ============================================================ -->
        <div
          class="demo-panel is-active"
          id="panel-booking"
          role="tabpanel"
          aria-labelledby="tab-booking"
          data-demo-panel="booking"
        >
          <div class="demo-panel__grid demo-panel__grid--compact">
            <!-- Left Column: Compact Simulator Controls -->
            <div class="demo-panel__info">
              <div class="sim-panel-header">
                <span class="panel-eyebrow">SIMULASI CEPAT · BOOKING ENGINE</span>
                <span class="sim-badge-mode">Mode Preview</span>
              </div>

              <!-- Quick Business Switcher Chips -->
              <div class="biz-chips biz-chips--compact" id="bookingBizChips">
                <button type="button" class="biz-chip is-active" data-biz="futsal">⚽ Futsal / Olahraga</button>
                <button type="button" class="biz-chip" data-biz="studio">📸 Studio Photo</button>
                <button type="button" class="biz-chip" data-biz="barber">✂️ Barbershop</button>
                <button type="button" class="biz-chip" data-biz="ps">🎮 Rental PS5</button>
                <button type="button" class="biz-chip" data-biz="warnet">🖥️ Warnet Esports</button>
              </div>

              <div class="sim-compact-card">
                <div class="sim-field-compact">
                  <label for="bookingResourceSelect">Fasilitas / Ruangan:</label>
                  <select class="sim-select sim-select--sm" id="bookingResourceSelect">
                    <!-- Populated dynamically -->
                  </select>
                </div>

                <div class="sim-row-compact">
                  <div class="sim-field-compact">
                    <label>Pilih Slot Waktu:</label>
                    <div class="booking-slot-grid booking-slot-grid--compact" id="bookingSlotGrid">
                      <!-- Slots dynamically injected -->
                    </div>
                  </div>
                </div>

                <!-- Addon inline chips -->
                <div class="sim-field-compact">
                  <label>Add-on / Sewa Perlengkapan Tambahan:</label>
                  <div class="addon-checklist addon-checklist--row" id="bookingAddonList">
                    <!-- Dynamic addons -->
                  </div>
                </div>

                <!-- Payment Scheme & Customer -->
                <div class="sim-row-compact sim-row-compact--2col">
                  <div class="sim-field-compact">
                    <label for="bookingCustomerName">Nama Pemesan:</label>
                    <input type="text" class="sim-input sim-input--sm" id="bookingCustomerName" value="Rian Hidayat" />
                  </div>
                  <div class="sim-field-compact">
                    <label>Skema Pembayaran:</label>
                    <div class="payment-scheme-radios payment-scheme-radios--inline">
                      <label class="radio-label"><input type="radio" name="paymentScheme" value="dp" checked /> <span>DP 50%</span></label>
                      <label class="radio-label"><input type="radio" name="paymentScheme" value="full" /> <span>Lunas 100%</span></label>
                    </div>
                  </div>
                </div>

                <!-- Summary bar -->
                <div class="calc-bar-compact">
                  <div>
                    <span class="calc-label">Total Booking:</span>
                    <strong class="calc-price" id="calcGrandTotal">Rp 300.000</strong>
                  </div>
                  <div>
                    <span class="calc-label">Wajib Bayar Sekarang:</span>
                    <strong class="text-success" id="calcDueAmount">Rp 150.000 (DP 50%)</strong>
                  </div>
                  <button type="button" class="btn btn--primary btn--sm" id="btnConfirmBooking">
                    <Icon name="check" size={14} />
                    <span>Terbitkan E-Ticket Demo</span>
                  </button>
                </div>
              </div>

              <!-- Link to Dedicated Real Trial Portal -->
              <div class="real-trial-callout">
                <div class="callout-text">
                  <strong>🚀 Butuh gunakan untuk bisnis riil Anda?</strong>
                  <span>Kustomisasi tarif jam, jadwal otomatis, &amp; data pelanggan di portal asli.</span>
                </div>
                <a class="btn btn--outline btn--sm" href="/layanan/booking">Buka Layanan Booking (Aktif 1 Bulan) →</a>
              </div>
            </div>

            <!-- Right Column: Compact Live Digital Boarding Pass -->
            <div class="demo-panel__visual">
              <div class="ticket-mockup-wrapper ticket-mockup-wrapper--compact">
                <div class="art-card-topbar">
                  <span>LIVE PASS // E-TICKET PREVIEW</span>
                  <span class="status-live">● VERIFIED PASS</span>
                </div>

                <div class="digital-ticket-card digital-ticket-card--compact" id="digitalTicketCard">
                  <div class="ticket-header">
                    <div class="ticket-brand">
                      <span class="brand-badge">SUPERNOVA BOOKING</span>
                      <span class="ticket-code" id="ticketCodeDisplay">BK-FTS-88421</span>
                    </div>
                    <div class="ticket-qr-box">
                      <svg viewBox="0 0 100 100" width="48" height="48" fill="none">
                        <rect width="100" height="100" fill="#ffffff" rx="4"/>
                        <path d="M10 10h28v28H10zM16 16h16v16H16zM62 10h28v28H62zM68 16h16v16H68zM10 62h28v28H10zM16 68h16v16H16zM46 10h8v8h-8zM46 26h8v16h-8zM26 46h16v8H26zM50 50h8v8h-8zM62 46h12v8H62zM80 46h10v16H80zM46 68h8v12h-8zM62 68h16v8H62zM84 68h6v22h-6zM62 82h12v8H62zM46 88h8v6h-8z" fill="#0f172a"/>
                      </svg>
                      <small>Scan QR Lokasi</small>
                    </div>
                  </div>

                  <div class="ticket-perforated-line">
                    <span class="notch notch--left"></span>
                    <span class="notch notch--right"></span>
                  </div>

                  <div class="ticket-body ticket-body--compact">
                    <div class="ticket-data-row">
                      <div class="ticket-data-col">
                        <span class="t-label">NAMA PEMESAN</span>
                        <strong class="t-value" id="ticketGuestName">Rian Hidayat</strong>
                      </div>
                      <div class="ticket-data-col">
                        <span class="t-label">TANGGAL &amp; JAM</span>
                        <strong class="t-value" id="ticketHours">Hari Ini · 19:00 - 21:00</strong>
                      </div>
                    </div>

                    <div class="ticket-data-row">
                      <div class="ticket-data-col">
                        <span class="t-label">FASILITAS</span>
                        <strong class="t-value text-blue" id="ticketResourceName">Lapangan 1 (Vinyl Pro)</strong>
                      </div>
                      <div class="ticket-data-col">
                        <span class="t-label">ADD-ON</span>
                        <strong class="t-value" id="ticketAddons">Sewa Rompi (+20k)</strong>
                      </div>
                    </div>

                    <div class="ticket-status-strip">
                      <div>
                        <span class="t-label">STATUS</span>
                        <span class="status-pill status-pill--dp" id="ticketPaymentBadge">DP 50% LUNAS</span>
                      </div>
                      <div class="text-right">
                        <span class="t-label">TOTAL</span>
                        <strong class="t-amount" id="ticketTotalAmount">Rp 320.000</strong>
                      </div>
                    </div>

                    <button type="button" class="btn btn--whatsapp-share btn--sm w-full" id="btnShareTicketWA">
                      <Icon name="whatsapp" size={14} />
                      <span>Simulasikan Kirim WhatsApp ke Klien</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ============================================================ -->
        <!-- PANEL 2: POS, ERP, CRM & KEUANGAN (COMPACT PREVIEW)         -->
        <!-- ============================================================ -->
        <div
          class="demo-panel"
          id="panel-pos"
          role="tabpanel"
          aria-labelledby="tab-pos"
          data-demo-panel="pos"
        >
          <div class="demo-panel__grid demo-panel__grid--compact">
            <!-- Left Column: Compact POS Terminal -->
            <div class="demo-panel__info">
              <div class="sim-panel-header">
                <span class="panel-eyebrow">SIMULASI CEPAT · TERMINAL KASIR (POS)</span>
                <span class="sim-badge-mode">Shift: Pagi (Rina)</span>
              </div>

              <!-- Category filter pills -->
              <div class="pos-category-pills" id="posCategoryPills">
                <button type="button" class="p-cat-btn is-active" data-cat="all">Semua</button>
                <button type="button" class="p-cat-btn" data-cat="beverage">☕ Minuman</button>
                <button type="button" class="p-cat-btn" data-cat="food">🥐 Makanan</button>
                <button type="button" class="p-cat-btn" data-cat="retail">📦 Retail</button>
              </div>

              <!-- Compact Product List (4 items) -->
              <div class="pos-product-grid pos-product-grid--compact" id="posProductGrid">
                <!-- Injected dynamically -->
              </div>

              <!-- Compact Cart & Payment Drawer -->
              <div class="pos-cart-compact">
                <div class="cart-items-container cart-items-container--compact" id="cartItemsContainer">
                  <!-- Active cart items -->
                </div>

                <div class="sim-row-compact sim-row-compact--2col">
                  <div>
                    <select class="sim-select sim-select--sm" id="posCustomerSelect">
                      <option value="budi" data-tier="Gold" data-points="1250" data-discount="15000">👤 Budi (Gold Member)</option>
                      <option value="umum" data-tier="Non-Member" data-points="0" data-discount="0">👥 Pelanggan Umum</option>
                    </select>
                  </div>
                  <div>
                    <input type="text" class="sim-input sim-input--sm" id="posVoucherInput" placeholder="Kode Promo (coba: SUPERNOVA10)" />
                  </div>
                </div>

                <div class="pos-pricing-compact">
                  <div class="quick-cash-buttons">
                    <button type="button" class="cash-chip" data-nominal="exact">Uang Pas</button>
                    <button type="button" class="cash-chip" data-nominal="100000">Rp 100k</button>
                    <button type="button" class="cash-chip" data-nominal="200000">Rp 200k</button>
                  </div>
                  <div class="price-summary-compact">
                    <div>
                      <span>Total Belanja:</span>
                      <strong class="highlight-price" id="posGrandTotal">Rp 0</strong>
                    </div>
                    <div>
                      <span>Kembalian:</span>
                      <strong class="text-success" id="cashChangeDisplay">Rp 0</strong>
                    </div>
                    <button type="button" class="btn btn--primary btn--sm" id="btnPosCheckout">
                      <span>Proses Transaksi</span>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Link to Dedicated Real Trial Portal -->
              <div class="real-trial-callout">
                <div class="callout-text">
                  <strong>📦 Butuh sistem POS &amp; ERP multi-cabang asli?</strong>
                  <span>Lengkap dengan barcode scanner, stok reorder, &amp; laporan laba rugi.</span>
                </div>
                <a class="btn btn--outline btn--sm" href="/layanan/pos-erp">Buka Layanan POS &amp; ERP (Aktif 1 Bulan) →</a>
              </div>
            </div>

            <!-- Right Column: Compact Thermal Receipt View -->
            <div class="demo-panel__visual">
              <div class="pos-output-wrapper pos-output-wrapper--compact">
                <div class="art-card-topbar">
                  <div class="output-tab-toggles">
                    <button type="button" class="out-toggle is-active" id="btnToggleReceiptView">🧾 STRUK THERMAL</button>
                    <button type="button" class="out-toggle" id="btnToggleErpView">📊 MINI-ERP</button>
                  </div>
                  <span class="status-live">● LIVE SYNC</span>
                </div>

                <div class="thermal-receipt-container thermal-receipt-container--compact" id="receiptView">
                  <div class="receipt-paper receipt-paper--compact">
                    <div class="receipt-header">
                      <h4>SUPERNOVA COFFEE &amp; ROASTERY</h4>
                      <p>SCBD Jakarta · Telp: (021) 555-8899</p>
                      <div class="receipt-divider">--------------------------------</div>
                      <div class="receipt-meta">
                        <span id="receiptInvoiceNum">INV/POS-042</span>
                        <span id="receiptTimestamp">21/10/2026 14:15</span>
                      </div>
                    </div>

                    <div class="receipt-items-list" id="receiptItemsList">
                      <!-- Rendered by script -->
                    </div>

                    <div class="receipt-divider">--------------------------------</div>
                    <div class="receipt-totals-table">
                      <div class="r-total-row r-total-row--grand">
                        <strong>TOTAL:</strong>
                        <strong id="rGrandTotal">Rp 104.500</strong>
                      </div>
                      <div class="r-total-row">
                        <span>Kembali:</span>
                        <span id="rChange">Rp 45.500</span>
                      </div>
                    </div>

                    <div class="receipt-footer">
                      <div class="barcode-lines"></div>
                      <small>TERIMA KASIH ATAS KUNJUNGAN ANDA</small>
                    </div>

                    <button type="button" class="btn btn--whatsapp-share btn--sm w-full" id="btnSendReceiptWA">
                      <Icon name="whatsapp" size={14} />
                      <span>Kirim Struk WhatsApp</span>
                    </button>
                  </div>
                </div>

                <!-- Mini ERP view -->
                <div class="mini-erp-container is-hidden" id="erpView">
                  <div class="erp-stat-grid">
                    <div class="erp-stat-card"><span class="stat-title">OMSET</span><strong class="stat-val text-blue" id="erpOmset">Rp 2.85M</strong></div>
                    <div class="erp-stat-card"><span class="stat-title">HPP</span><strong class="stat-val text-muted" id="erpHpp">Rp 1.14M</strong></div>
                    <div class="erp-stat-card erp-stat-card--highlight"><span class="stat-title">LABA</span><strong class="stat-val text-success" id="erpProfit">Rp 1.71M</strong></div>
                  </div>
                  <div class="erp-log-list" id="erpLogList"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ============================================================ -->
        <!-- PANEL 3: ORDERING IN TABLE WITH QR CODE (COMPACT PREVIEW)   -->
        <!-- ============================================================ -->
        <div
          class="demo-panel"
          id="panel-qr"
          role="tabpanel"
          aria-labelledby="tab-qr"
          data-demo-panel="qr"
        >
          <div class="demo-panel__grid demo-panel__grid--compact">
            <!-- Left Column: Compact Guest Mobile Ordering -->
            <div class="demo-panel__info">
              <div class="sim-panel-header">
                <span class="panel-eyebrow">SIMULASI CEPAT · MEJA TAMU RESTO</span>
                <span class="sim-badge-mode">Dine-in QRIS</span>
              </div>

              <!-- Table switcher chips -->
              <div class="table-badges" id="qrTableSelector">
                <button type="button" class="tbl-btn is-active" data-tbl="01" data-section="Indoor AC" data-cap="4">Meja 01 (Indoor)</button>
                <button type="button" class="tbl-btn" data-tbl="05" data-section="Outdoor Terrace" data-cap="4">Meja 05 (Outdoor)</button>
                <button type="button" class="tbl-btn" data-tbl="08" data-section="VIP Room" data-cap="8">Meja 08 (VIP)</button>
              </div>

              <div class="sim-compact-card">
                <!-- Action buttons -->
                <div class="mobile-app-header mobile-app-header--compact">
                  <span class="table-status-pill" id="mobileTablePill">📍 Meja 01 (Indoor)</span>
                  <div class="mobile-quick-actions">
                    <button type="button" class="btn-waiter-call" id="btnCallWaiter">🔔 Panggil Waiter</button>
                    <button type="button" class="btn-bill-request" id="btnRequestBill">🧾 Minta Bill</button>
                  </div>
                </div>

                <div class="waiter-alert-toast is-hidden" id="waiterAlertToast"></div>

                <!-- Compact Resto Menu List (3 items) -->
                <div class="resto-cards-grid resto-cards-grid--compact" id="restoCardsGrid">
                  <!-- Dynamically populated -->
                </div>

                <!-- Split Bill & Total Bar -->
                <div class="split-bill-card split-bill-card--compact">
                  <div class="split-controls">
                    <div class="split-selector">
                      <span>Bagi Tagihan (Split Bill):</span>
                      <div class="person-chips" id="splitPersonChips">
                        <button type="button" class="p-chip" data-person="2">2 Org</button>
                        <button type="button" class="p-chip is-active" data-person="3">3 Org</button>
                        <button type="button" class="p-chip" data-person="4">4 Org</button>
                      </div>
                    </div>
                    <div class="split-result">
                      <strong class="text-blue" id="splitPriceDisplay">Rp 38.500 / org</strong>
                    </div>
                  </div>
                </div>

                <div class="calc-bar-compact">
                  <div>
                    <span class="calc-label">Total Meja (PB1 10%):</span>
                    <strong class="highlight-price" id="tableGrandTotal">Rp 115.500</strong>
                  </div>
                  <button type="button" class="btn btn--primary btn--sm" id="btnSendOrderKitchen">
                    <span>🍳 Kirim ke Dapur</span>
                  </button>
                </div>
              </div>

              <!-- Link to Dedicated Real Trial Portal -->
              <div class="real-trial-callout">
                <div class="callout-text">
                  <strong>🍲 Butuh sistem QR Meja &amp; KDS untuk resto Anda?</strong>
                  <span>Atur menu foto HD, stiker QR meja kustom, &amp; layar dapur live.</span>
                </div>
                <a class="btn btn--outline btn--sm" href="/layanan/qr-resto">Buka Layanan QR Resto (Aktif 1 Bulan) →</a>
              </div>
            </div>

            <!-- Right Column: Compact Kitchen Display System (KDS) -->
            <div class="demo-panel__visual">
              <div class="kds-monitor-wrapper kds-monitor-wrapper--compact">
                <div class="kds-monitor-bezel">
                  <div class="kds-topbar">
                    <div class="kds-station-badge">
                      <span class="pulse-dot"></span>
                      <span>KDS MONITOR // DAPUR UTAMA</span>
                    </div>
                    <strong id="kdsClock">14:22:05</strong>
                  </div>

                  <div class="kds-tickets-container kds-tickets-container--compact">
                    <div class="kds-ticket-card is-new" id="kdsTicket01">
                      <div class="ticket-top">
                        <div class="tbl-flag">MEJA 01 (INDOOR)</div>
                        <div class="ticket-timer" id="kdsTimer01">⏱️ Baru Saja</div>
                      </div>

                      <div class="kds-items-list" id="kdsItemsList01">
                        <!-- Populated by script -->
                      </div>

                      <div class="kds-workflow-footer">
                        <div class="workflow-status-label">
                          Status: <strong class="text-warning" id="kdsWorkflowState01">1. TIKET DITERIMA</strong>
                        </div>
                        <button type="button" class="btn-kds-advance btn-kds-advance--sm" id="btnAdvanceKds01">
                          ▶ Mulai Masak (Chef)
                        </button>
                      </div>
                    </div>
                  </div>

                  <div class="kds-alert-banner" id="kdsAlertBanner">
                    <span id="kdsAlertMessage">Dapur berjalan normal. Siap menerima pesanan meja.</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
